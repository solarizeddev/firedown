#!/usr/bin/env bash
# Stand-in for ./gradlew in the publish-release self-test: uploadUpdateRelease
# copies the update folder into the simulated GitHub release, creating it as
# a draft when it does not exist (what the real task does with gh).
printf 'gradlew %s\n' "$*" >> "$FAKE_WORLD/events"
[ "$1" = uploadUpdateRelease ] || { echo "fake gradlew: unexpected: $*" >&2; exit 2; }
name=$(awk '$1 == "versionName" { gsub(/"/, "", $2); print $2; exit }' app/build.gradle)
dir=$FAKE_WORLD/github/v$name
if [ ! -d "$dir" ]; then
    mkdir -p "$dir"
    : > "$dir.draft"
fi
cp app/build/outputs/update/v"$name"/* "$dir"/
# FAKE_STALE_ASSET=<file>: that asset ends up the same size with other bytes
# (an earlier build left on the release).
if [ -n "${FAKE_STALE_ASSET:-}" ]; then
    size=$(wc -c < "$dir/$FAKE_STALE_ASSET")
    head -c "$size" /dev/urandom > "$dir/$FAKE_STALE_ASSET"
fi
echo "Uploaded to v$name"

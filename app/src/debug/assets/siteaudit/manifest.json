{
  "description": "Debug builds only: lets the device audit (SiteAuditTest) drive and inspect the page. Installed by the test, uninstalled after it.",
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "siteaudit@solarized.dev"
    }
  },
  "name": "firedown-site-audit",
  "version": "1.0",
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "tabs",
    "webRequest",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}

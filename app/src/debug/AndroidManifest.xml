<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the screen the device audit (SiteAuditTest) browses in.
     Not exported; only the instrumentation, running in this process, starts it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.solarized.firedown.siteaudit.SiteAuditActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- scripts/update-install-test.sh drives the update install through
             this receiver. Exported so `am broadcast -n` can reach it, but only
             a sender holding DUMP may: the adb shell does, installed apps
             cannot. -->
        <receiver
            android:name="com.solarized.firedown.updatetest.UpdateTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>

<!--
  "How sync works" help screen (SyncHelpFragment) — the recovery-code /
  encryption FAQ, promoted from a dialog to a full NavController destination so
  the (growing) content scrolls naturally and handles large fonts / TalkBack.
  Static, offline Q/A: each item is a non-selectable FaqPreference, which paints
  the question (title) brand orange in onBindViewHolder and leaves the answer
  (summary) the muted body colour. iconSpaceReserved is off so the text is
  flush-left.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q1"
        android:summary="@string/settings_sync_faq_a1"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q2"
        android:summary="@string/settings_sync_faq_a2"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q3"
        android:summary="@string/settings_sync_faq_a3"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q4"
        android:summary="@string/settings_sync_faq_a4"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q5"
        android:summary="@string/settings_sync_faq_a5"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q6"
        android:summary="@string/settings_sync_faq_a6"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

    <!-- The Safe Folder exclusion as a STATED PROMISE, not a silent gap: the
         vault never leaves the device (same contract as the backup mirror and
         P2P send), so a user looking for "back up my Safe Folder file" finds
         the why and the workaround here instead of a missing menu row. -->
    <com.solarized.firedown.settings.FaqPreference
        android:selectable="false"
        android:title="@string/settings_sync_faq_q7"
        android:summary="@string/settings_sync_faq_a7"
        app:singleLineTitle="false"
        app:iconSpaceReserved="false" />

</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<!-- One installed add-on (AddonDetailFragment): the header (icon, name,
     author and version), on/off and private tabs, its own settings page,
     an update waiting for the user, its page on addons.mozilla.org,
     what it may do, what it collects, and Remove. Rows that don't apply are hidden by
     the fragment. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.solarized.firedown.settings.AddonHeaderPreference
        android:key="com.solarized.firedown.preferences.addon.header" />

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addon.state.category"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="com.solarized.firedown.preferences.addon.enabled"
            android:persistent="false"
            android:title="@string/addon_enabled"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="com.solarized.firedown.preferences.addon.private"
            android:persistent="false"
            android:title="@string/addon_private"
            android:summary="@string/addon_private_summary"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="com.solarized.firedown.preferences.addon.shield"
            android:persistent="false"
            android:title="@string/addon_detail_shield_title"
            android:summary="@string/addon_detail_shield_summary"
            app:isPreferenceVisible="false"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addon.more.category"
        app:iconSpaceReserved="false">

        <Preference
            android:key="com.solarized.firedown.preferences.addon.options"
            android:title="@string/addon_settings"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="com.solarized.firedown.preferences.addon.review"
            android:title="@string/addon_review_update"
            android:summary="@string/addon_review_update_summary"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="com.solarized.firedown.preferences.addon.update"
            android:title="@string/addon_check_update"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="com.solarized.firedown.preferences.addon.page"
            android:title="@string/addon_page"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- One row per thing it may do, each with its glyph, filled by the
         fragment ("No special permissions" when it lists none). -->
    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addon.permissions.category"
        android:title="@string/addon_permissions"
        app:iconSpaceReserved="false" />

    <!-- What the developer says the add-on collects. Not a permission, so
         its own group; hidden for an add-on that predates the declaration. -->
    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addon.data.category"
        android:title="@string/addon_data_collection"
        app:iconSpaceReserved="false">

        <Preference
            android:key="com.solarized.firedown.preferences.addon.data"
            android:selectable="false"
            android:icon="@drawable/database_24"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- One switch per optional permission, site or data kind the add-on
         declares, filled by the fragment; hidden when it declares none. -->
    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addon.optional.category"
        android:title="@string/addon_optional_permissions"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addon.remove.category"
        app:iconSpaceReserved="false">

        <Preference
            android:key="com.solarized.firedown.preferences.addon.remove"
            android:title="@string/addon_remove"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="com.solarized.firedown.preferences.about.version"
        android:title="@string/settings_version"
        android:icon="@drawable/ic_baseline_settings_24">

    </Preference>

    <Preference
        android:key="com.solarized.firedown.preferences.about.gecko"
        android:title="@string/settings_gecko_version"
        android:icon="@drawable/ic_memory_24">

    </Preference>

    <!-- Manual on-tap update check. Complements the background pipeline
         (UpdateScheduler): the periodic check is Doze-deferred and dies on
         force-stop, so the only reliable automatic check is the one on app
         open — this row is the deterministic "check right NOW" the
         background path can't promise, and unlike it, it reports the
         no-update outcome ("You're up to date").

         The title/summary/icon here are the NOT-READY state only —
         AboutFragment.refreshUpdateRow retitles this same row to "Install
         update" (+ the waiting version as summary) whenever a verified APK
         is already on disk, which makes it the app's standing "an update is
         waiting" surface. See that method for why it lives here and not on
         the home screen. -->
    <Preference
        android:key="com.solarized.firedown.preferences.about.update.check"
        android:title="@string/settings_update_check_title"
        android:icon="@drawable/ic_refresh_24">

    </Preference>

    <!-- Folded in from the root Settings screen (the Fenix pattern — About
         carries the legal links): a once-ever row that doesn't earn root
         scroll estate. Key unchanged, so no migration. -->
    <Preference
        android:key="com.solarized.firedown.preferences.license"
        android:title="@string/settings_license"
        android:icon="@drawable/license_24">

    </Preference>

</PreferenceScreen>
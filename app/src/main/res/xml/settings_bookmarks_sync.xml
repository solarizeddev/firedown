<!--
  Focused Bookmarks-sync screen (reached from the Bookmarks list overflow and from
  the Sync hub). Bookmark-only actions live HERE — the toggle (master switch),
  Sync now, and Delete-from-server — so the Sync hub stays a thin account page
  (recovery code + links). The shared recovery code is on the hub, not duplicated
  here; setup still reveals the freshly-minted code once via a dialog.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="com.solarized.firedown.preferences.sync.enabled"
        android:title="@string/settings_sync_bookmarks_title"
        android:summary="@string/settings_sync_switch_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_bookmarks_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.now"
        android:title="@string/settings_sync_now_title"
        app:singleLineTitle="false"
        app:icon="@drawable/settings_backup_restore_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.delete.data"
        android:title="@string/settings_sync_delete_title"
        android:summary="@string/settings_sync_delete_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_delete_24" />

</PreferenceScreen>

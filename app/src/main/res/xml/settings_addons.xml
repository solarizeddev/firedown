<?xml version="1.0" encoding="utf-8"?>
<!-- Add-ons (AddonsFragment). Two dynamic lists the fragment fills: the
     add-ons installed (tap → the add-on's page) and Mozilla's list of
     add-ons for Android (tap → the install prompt; the one Firedown ships,
     uBlock Origin, reads "Built into Firedown"). The list is Mozilla's
     short recommended collection; "Find more add-ons" opens Mozilla's
     add-on site for Android in a tab (only add-ons marked as working on
     Android; the user-script managers live there), as Firefox for Android
     does. "Install from file" is for a signed add-on from elsewhere. The footnote says what reaches
     Mozilla and that add-ons work outside the no-tracking promise. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addons.installed.category"
        android:title="@string/addons_installed"
        app:iconSpaceReserved="false">

        <Preference
            android:key="com.solarized.firedown.preferences.addons.installed.empty"
            android:selectable="false"
            android:summary="@string/addons_none_installed"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addons.catalog.category"
        android:title="@string/addons_recommended"
        app:iconSpaceReserved="false">

        <Preference
            android:key="com.solarized.firedown.preferences.addons.catalog.status"
            android:selectable="false"
            android:summary="@string/addons_catalog_loading"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="com.solarized.firedown.preferences.addons.catalog.retry"
            android:title="@string/addons_retry"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.addons.more.category"
        android:title="@string/addons_more"
        app:iconSpaceReserved="false">

        <Preference
            android:key="com.solarized.firedown.preferences.addons.updates"
            android:title="@string/addons_check_updates"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="com.solarized.firedown.preferences.addons.more"
            android:title="@string/addons_find_more"
            android:summary="@string/addons_find_more_summary"
            app:iconSpaceReserved="false" />

        <com.solarized.firedown.settings.ui.BusyPreference
            android:key="com.solarized.firedown.preferences.addons.file"
            android:title="@string/addons_install_from_file"
            android:summary="@string/addons_install_from_file_summary"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <com.solarized.firedown.settings.ui.FootnotePreference
        android:key="com.solarized.firedown.preferences.addons.footnote"
        android:persistent="false"
        android:selectable="false"
        android:summary="@string/addons_footnote"
        app:iconSpaceReserved="false" />

</PreferenceScreen>

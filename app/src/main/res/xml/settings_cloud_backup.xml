<!--
  Downloads backup (Cloud Backup) sub-screen — reached from the unified Sync
  screen's "Downloads backup" row. PURELY downloads management: status, the
  backed-up files list, and right-to-erasure. The recovery code and the FAQ are
  SHARED, so they live on the parent Sync screen, not here.

  Cloud Backup is action-driven (a finished download's options sheet backs it up
  on demand) — there is no on/off switch. Everything actionable lives under ONE
  "Manage backup" category, "Add storage credit" first; the files/delete rows
  are hidden until it's set up (buy stays — see its note). The debug smoke-test
  row (debug builds only) is added programmatically by
  CloudBackupSettingsFragment.

  Status is non-clickable; it shows live "Backing up…/Restoring…" while a
  transfer runs, else the backed-up usage.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The status HERO (big balance / covered-until / grace / backing-up),
         bound by CloudBackupSettingsFragment. Custom layout — no title/icon. -->
    <com.solarized.firedown.settings.CloudStatusPreference
        android:key="com.solarized.firedown.preferences.cloud.backup.status"
        android:selectable="false"
        android:persistent="false" />

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.cloud.backup.cat.manage"
        android:title="@string/settings_cloud_backup_cat_manage">

        <!-- FIRST row of Manage, and ALWAYS visible (the fragment hides the
             files/delete rows pre-setup, never this one or the category): a
             metered user buys credit BEFORE their first backup, so this must be
             reachable before Cloud Backup is set up. -->
        <Preference
            android:key="com.solarized.firedown.preferences.cloud.backup.buy"
            android:title="@string/buy_credit_title"
            android:summary="@string/settings_cloud_backup_buy_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/add_24" />

        <Preference
            android:key="com.solarized.firedown.preferences.cloud.backup.files"
            android:title="@string/cloud_backup_files_title"
            android:summary="@string/settings_cloud_backup_files_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/cloud_done_24" />

        <Preference
            android:key="com.solarized.firedown.preferences.cloud.backup.delete.data"
            android:title="@string/settings_cloud_backup_delete_title"
            android:summary="@string/settings_cloud_backup_delete_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_baseline_delete_24" />

    </PreferenceCategory>

</PreferenceScreen>

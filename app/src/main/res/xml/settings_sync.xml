<!--
  The MERGED Cloud screen (toolbar title "Cloud") — the pay-per-use downloads
  backup IS the screen; bookmarks and account plumbing are secondary. This
  replaced the old two-level IA (a thin hub routing to a separate Cloud Backup
  sub-screen): reaching the plan/status took home popup → Cloud → Manage
  downloads backup → … (4 taps to the files list), and the hub's rows buried
  the one thing a paying user cares about. Layout, in priority order:

    ── (hero) ──
       CloudStatusPreference   the live plan/usage/runway card (or the dashed
                               not-set-up empty state)
       Add storage credit      FILLED CTA directly under the hero (custom
                               layout preference_cloud_buy_button.xml)
    ── (no-key gateway) ──  (shown ONLY until a recovery code exists)
       [the CTA above morphs to "Create recovery code" pre-key]
       I have a recovery code  › adopt an existing account's key
    ── (no headers below — the screen is FLAT; order alone groups it) ──
       Backups                 › the backed-up-files list (set-up gated)
       Show backup status on home   INLINE switch, display-only (set-up gated)
       Sync bookmarks          INLINE switch, secondary by design (the focused
                               BookmarksSyncFragment was retired with the
                               merge; "Sync now" dropped — sync is automatic,
                               the summary shows last-synced)
       Recovery code           (shared; shown once a key exists; the reveal
                               dialog carries Copy AND Save-to-file)
       How sync & encryption work  (covers bookmarks AND files)
    ── (last) ──
       Delete bookmarks from server   (shown while sync is on)
       Delete backed-up files         (shown once set up)
       TWO SCOPED erasure rows, LAST by danger. Never a single "delete all
       cloud data" row — it misled (never touched bookmarks) and would couple
       wiping free bookmarks to destroying paid backups + their balance.

  KEY-FIRST GATE (unchanged in spirit): a recovery code is the account gateway.
  Until one exists the CTA reads "Create recovery code" (not buy), the Manage
  rows are hidden, and the Bookmarks switch is DISABLED. This is what stops a
  keyless purchase — the buy flow used to mint a code silently mid-checkout,
  which left a ghost account with an unsaved key when the user backed out of
  Stripe (see BuyCreditViewModel). Creating a key forces the "I've saved it"
  step before it counts.

  The bookmarks-list overflow + sync banner deep-links (EXTRA_OPEN_BOOKMARKS_SYNC)
  land HERE now. Cloud Backup stays action-driven (a download's options sheet
  backs it up on demand). The debug smoke-test row (debug builds only) is
  appended programmatically by SyncSettingsFragment.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The status HERO (big balance / covered-until / grace / backing-up),
         bound by SyncSettingsFragment. Custom layout — no title/icon. -->
    <com.solarized.firedown.settings.CloudStatusPreference
        android:key="com.solarized.firedown.preferences.cloud.backup.status"
        android:selectable="false"
        android:persistent="false" />

    <!-- The one PROMINENT action — a MORPHING CTA whose label is the
         Preference title (the layout binds it into the button): pre-key it
         reads "Create recovery code" (onboarding step ①), post-key "Add
         storage credit" (step ②/top-up). SyncSettingsFragment swaps title +
         click routing in updateState. EMPHASIS is state-dependent
         (CloudBuyButtonPreference): FILLED while the next step is genuinely
         "pay" (pre-key / unfunded / grace), demoted to an OUTLINED row when
         comfortably funded — a permanent sales button on an account that
         needs nothing cuts against the calm-by-default ethos (the same
         restraint that keeps the home pill a quiet chip); the hero alert + amber grace re-escalate the
         top-up moment when it actually matters. -->
    <com.solarized.firedown.settings.CloudBuyButtonPreference
        android:key="com.solarized.firedown.preferences.cloud.backup.buy"
        android:title="@string/buy_credit_title"
        android:layout="@layout/preference_cloud_buy_button"
        android:persistent="false" />

    <!-- Shown ONLY when this device has no recovery code yet: the adopt-an-
         existing-account door (the CTA above covers Create). Hidden once a
         key exists. -->
    <Preference
        android:key="com.solarized.firedown.preferences.sync.link.code"
        android:title="@string/settings_sync_link_title"
        android:summary="@string/settings_sync_link_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_insert_drive_file_24" />

    <!-- Visible once Cloud Backup is set up (has data / a funded account).
         Deliberately NO category header: "Manage backup" over this single row
         restated the row (the same taxonomy-noise argument that dissolved the
         Cookies category), and the row already sits in backup context under
         the hero + CTA. -->
    <Preference
        android:key="com.solarized.firedown.preferences.cloud.backup.files"
        android:title="@string/cloud_backup_files_title"
        android:summary="@string/settings_cloud_backup_files_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/cloud_done_24" />

    <!-- Opens the shared scanner for a browser pairing QR, so the web client at
         firedown.app/backup can be unlocked WITHOUT typing the 52-character
         recovery code into a web page. Set-up gated: there is nothing to pair
         a browser with until this device has an account. It sits under Backups
         because it is about reaching those same files from a computer. -->
    <Preference
        android:key="com.solarized.firedown.preferences.cloud.backup.pair"
        android:title="@string/settings_pair_browser_title"
        android:summary="@string/settings_pair_browser_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_qr_scan_24" />

    <!-- Sits right under the Backups row because it governs that same subject
         on the home screen. A DISPLAY toggle only: it gates HomeFragment's
         pill/card and nothing else, so flipping it off never touches the
         account, the recovery code, a paid balance, or the routes to the files
         above. Deliberately NOT a "disable Cloud Backup" switch — that would
         have to clear CLOUD_BACKUP_ENABLED, which also gates the Backups row
         and the Downloads-overflow routing, hiding the user's doors to data
         still on the server. This one self-persists (unlike the Bookmarks
         switch below, whose pref SyncManager owns) because it has no side
         effects. setUp-gated with the Backups row: with no backups there is no
         status to show or hide. -->
    <SwitchPreferenceCompat
        android:key="com.solarized.firedown.preferences.settings.cloud.home.status"
        android:title="@string/settings_cloud_home_status_title"
        android:summary="@string/settings_cloud_home_status_summary"
        android:defaultValue="true"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_eye_24" />

    <!-- Bookmarks are deliberately SECONDARY on this screen: ONE inline switch
         (sync is automatic once on — change-triggered + on-toggle — so the old
         focused screen's "Sync now" row was reassurance theater and is gone;
         the last-synced summary carries the same signal). The switch never
         self-persists: SyncManager owns SYNC_ENABLED, the fragment re-syncs
         checked state from isEnabled(). NO category header — it was the LAST
         one on the screen (kept as a "paid-vs-free separator"), but a
         Preference category header visually owns every row until the NEXT
         header, so with the other headers dissolved it umbrella'd the
         recovery-code/FAQ/delete rows as "Bookmarks" children ("why is Delete
         backed-up files under Bookmarks?"). It was also a single-child header
         itself (the switch's icon + "Sync bookmarks" title self-identify) —
         the exact taxonomy-noise shape the others were removed for. The
         screen is fully FLAT: order alone carries the grouping. -->
    <SwitchPreferenceCompat
        android:key="com.solarized.firedown.preferences.sync.enabled"
        android:title="@string/settings_sync_title"
        android:summary="@string/settings_sync_switch_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_bookmarks_24" />

    <!-- ONE recovery-code row (was Show + Save-to-file, two rows and two
         device-auth prompts for the same object): the reveal dialog behind the
         single auth now carries Copy AND Save-to-file — export is something
         you do while LOOKING at the code, so the reveal is where you reach for
         it. Title reuses the old category header string ("Recovery code");
         no category wrapper (single child, see the files row note above). -->
    <Preference
        android:key="com.solarized.firedown.preferences.sync.show.code"
        android:title="@string/settings_sync_cat_code"
        android:summary="@string/settings_sync_show_code_shared_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_key_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.help"
        android:title="@string/settings_sync_help_title"
        android:summary="@string/settings_sync_help_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/encryption_24" />

    <!-- The destructive actions sit LAST — placement by danger, not taxonomy.
         TWO SCOPED erasure rows, never one "delete all cloud data" (which
         would couple wiping free bookmarks to destroying paid backups):
         bookmarks-from-server shows while sync is on; backed-up-files shares
         the Manage rows' set-up gate. Deleting files does NOT touch the
         credit balance (the server keeps the quota row). -->
    <Preference
        android:key="com.solarized.firedown.preferences.sync.delete.data"
        android:title="@string/settings_sync_delete_title"
        android:summary="@string/settings_sync_delete_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_delete_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.cloud.backup.delete.data"
        android:title="@string/settings_cloud_backup_delete_title"
        android:summary="@string/settings_cloud_backup_delete_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_delete_24" />

</PreferenceScreen>

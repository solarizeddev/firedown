<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <SwitchPreferenceCompat
        android:key="com.solarized.firedown.preferences.sync.enabled"
        android:title="@string/settings_sync_title"
        android:summary="@string/settings_sync_switch_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/cloud_outline_24" />

    <!-- Always visible (not gated on sync being on): the FAQ helps the
         decision to enable, and lets an existing user re-read the
         recovery-code stakes. Offline dialog, no web link. -->
    <Preference
        android:key="com.solarized.firedown.preferences.sync.help"
        android:title="@string/settings_sync_help_title"
        android:summary="@string/settings_sync_help_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/encryption_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.show.code"
        android:title="@string/settings_sync_show_code_title"
        android:summary="@string/settings_sync_show_code_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_key_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.export.code"
        android:title="@string/settings_sync_export_title"
        android:summary="@string/settings_sync_export_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_insert_drive_file_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.now"
        android:title="@string/settings_sync_now_title"
        app:singleLineTitle="false"
        app:icon="@drawable/settings_backup_restore_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.sign.out"
        android:title="@string/settings_sync_sign_out_title"
        android:summary="@string/settings_sync_sign_out_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_logout_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.delete.data"
        android:title="@string/settings_sync_delete_title"
        android:summary="@string/settings_sync_delete_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_delete_24" />

</PreferenceScreen>

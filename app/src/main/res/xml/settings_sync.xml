<!--
  Sync hub — a THIN account page. One account / one recovery code covers
  bookmarks (free) AND encrypted download backup (cloud-storage-spec.md). The hub
  only routes to each feature's own screen and holds the SHARED recovery code; the
  per-feature actions (the bookmark toggle, Sync now, Delete-from-server) live on
  the focused Bookmarks screen ({@link BookmarksSyncFragment}), NOT here — that
  declutter is the whole point of the hub.

    ── (feature links) ──
       Bookmarks        › BookmarksSyncFragment  (summary = on?last-synced:off)
       Manage downloads backup › Cloud Backup sub-screen (status/files/delete)
    ── (no-key gateway) ──  (shown ONLY until a recovery code exists)
       Create recovery code    › mint a fresh key here (no feature enabled yet)
       I have a recovery code   › adopt an existing account's key
    ── Recovery code ──  (shared; shown once a key exists)
       Show recovery code
       Save recovery code to file
    ── About ──
       How sync & encryption work  (covers bookmarks AND files)

  KEY-FIRST GATE: a recovery code is the account gateway. Until one exists, the
  Bookmarks + Manage-downloads-backup rows are DISABLED (SyncSettingsFragment gates
  them on hasCode()) and only Create / "I have a recovery code" are offered. This
  is what stops a keyless purchase — the buy flow used to mint a code silently
  mid-checkout, which left a ghost account with an unsaved key when the user backed
  out of Stripe (see BuyCreditViewModel). Creating a key from here forces the
  "I've saved it" step before it counts; the per-download "Back up to cloud" action
  mints+saves inline the same way.

  The bookmarks row deep-links to the focused screen so the bookmarks-list overflow
  and the hub land on the SAME place. Downloads backup is action-driven (a
  download's options sheet backs it up on demand); this is just the entry to its
  management screen. Paid "Storage & billing" lands with the payments mint (Phase
  1b). Pricing (free vs pay-per-use) is kept implicit in the copy, not a badge.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="com.solarized.firedown.preferences.sync.bookmarks.link"
        android:title="@string/settings_sync_bookmarks_title"
        android:summary="@string/settings_sync_switch_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_bookmarks_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.settings.cloud.backup"
        android:title="@string/settings_sync_downloads_title"
        android:summary="@string/settings_sync_downloads_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/download_24" />

    <!-- Shown ONLY when this device has no recovery code yet (fresh install / new
         device). The key is the account GATEWAY: bookmarks + downloads-backup rows
         above stay DISABLED until one exists (SyncSettingsFragment gates them on
         hasCode()). Create = mint a fresh key here; "I have a recovery code" =
         adopt an existing one. Both hidden once a key exists. -->
    <Preference
        android:key="com.solarized.firedown.preferences.sync.create.code"
        android:title="@string/settings_sync_create_title"
        android:summary="@string/settings_sync_create_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_key_24" />

    <Preference
        android:key="com.solarized.firedown.preferences.sync.link.code"
        android:title="@string/settings_sync_link_title"
        android:summary="@string/settings_sync_link_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/ic_baseline_insert_drive_file_24" />

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.sync.cat.code"
        android:title="@string/settings_sync_cat_code">

        <Preference
            android:key="com.solarized.firedown.preferences.sync.show.code"
            android:title="@string/settings_sync_show_code_title"
            android:summary="@string/settings_sync_show_code_shared_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_key_24" />

        <Preference
            android:key="com.solarized.firedown.preferences.sync.export.code"
            android:title="@string/settings_sync_export_title"
            android:summary="@string/settings_sync_export_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_baseline_insert_drive_file_24" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.sync.cat.about"
        android:title="@string/settings_sync_cat_about">

        <Preference
            android:key="com.solarized.firedown.preferences.sync.help"
            android:title="@string/settings_sync_help_title"
            android:summary="@string/settings_sync_help_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/encryption_24" />

    </PreferenceCategory>

</PreferenceScreen>

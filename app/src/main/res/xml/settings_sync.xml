<!--
  Unified Sync (account) settings — one account / one recovery code covering
  bookmarks (free) AND encrypted download backup (cloud-storage-spec.md;
  sketch: sketches/sync-settings-future.html). IA:

    ── What to sync ──        (always visible)
       Bookmarks              [toggle]          (off = bookmark sign-out)
       Downloads backup       › Cloud Backup sub-screen (action-driven)
    How encryption works                        (FAQ, always visible)
    ── Recovery code ──       (category, shown once set up)
       Show recovery code
       Save recovery code to file
    ── Manage sync ──         (category, shown once set up)
       Sync now
       Delete data from server

  The Bookmarks toggle IS the old master switch (SyncSettingsFragment still
  owns SYNC_ENABLED through it; toggling off runs the bookmark sign-out
  confirm). The Downloads row is NOT a toggle — Cloud Backup is action-driven
  (a download's options sheet backs it up on demand) and its own management
  screen handles status/files/delete. The Recovery-code + Manage categories
  are shared and gated on the account being set up. Billing / "Storage &amp;
  billing" (the paid-storage sketch bits) land with the payments mint
  (Phase 1b) — not here yet.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.sync.cat.what"
        android:title="@string/settings_sync_cat_what">

        <SwitchPreferenceCompat
            android:key="com.solarized.firedown.preferences.sync.enabled"
            android:title="@string/settings_sync_bookmarks_title"
            android:summary="@string/settings_sync_switch_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_bookmarks_24" />

        <Preference
            android:key="com.solarized.firedown.preferences.settings.cloud.backup"
            android:title="@string/settings_sync_downloads_title"
            android:summary="@string/settings_sync_downloads_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/download_24" />

    </PreferenceCategory>

    <!-- Always visible (not gated on sync being on): the FAQ helps the
         decision to enable, and lets an existing user re-read the
         recovery-code stakes. Offline dialog, no web link. -->
    <Preference
        android:key="com.solarized.firedown.preferences.sync.help"
        android:title="@string/settings_sync_help_title"
        android:summary="@string/settings_sync_help_summary"
        app:singleLineTitle="false"
        app:icon="@drawable/encryption_24" />

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.sync.cat.code"
        android:title="@string/settings_sync_cat_code">

        <Preference
            android:key="com.solarized.firedown.preferences.sync.show.code"
            android:title="@string/settings_sync_show_code_title"
            android:summary="@string/settings_sync_show_code_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_key_24" />

        <Preference
            android:key="com.solarized.firedown.preferences.sync.export.code"
            android:title="@string/settings_sync_export_title"
            android:summary="@string/settings_sync_export_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_baseline_insert_drive_file_24" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="com.solarized.firedown.preferences.sync.cat.manage"
        android:title="@string/settings_sync_cat_manage">

        <Preference
            android:key="com.solarized.firedown.preferences.sync.now"
            android:title="@string/settings_sync_now_title"
            app:singleLineTitle="false"
            app:icon="@drawable/settings_backup_restore_24" />

        <Preference
            android:key="com.solarized.firedown.preferences.sync.delete.data"
            android:title="@string/settings_sync_delete_title"
            android:summary="@string/settings_sync_delete_summary"
            app:singleLineTitle="false"
            app:icon="@drawable/ic_baseline_delete_24" />

    </PreferenceCategory>

</PreferenceScreen>

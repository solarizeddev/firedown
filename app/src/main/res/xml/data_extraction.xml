<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / device-transfer rules for API 31+. Keep in lockstep with
     backup_rules.xml (which covers API <= 30).

     IMPORTANT: this file being EMPTY was a real misconfiguration - on API
     31+ an empty <data-extraction-rules> means NO rules, i.e. DEFAULT FULL
     backup of everything (databases incl. the safe-vault rows of
     download-db, filesDir incl. files/safe/ vault content, and
     secret_shared_prefs.xml), while the legacy backup_rules.xml exclusions
     were silently ignored. The explicit include-lists below restore the
     intended surface: settings prefs + the sanitized public-downloads
     mirror (DownloadBackupMirror), nothing else. Same content for cloud
     backup and device-to-device transfer - the vault leaves the device in
     neither. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml"/>
        <exclude domain="sharedpref" path="backup_local.xml"/>
    <exclude domain="sharedpref" path="nostr_prefs.xml"/>
        <include domain="file" path="backup/downloads-mirror.db"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="secret_shared_prefs.xml"/>
        <exclude domain="sharedpref" path="backup_local.xml"/>
    <exclude domain="sharedpref" path="nostr_prefs.xml"/>
        <include domain="file" path="backup/downloads-mirror.db"/>
    </device-transfer>
</data-extraction-rules>

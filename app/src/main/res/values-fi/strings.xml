    <string name="settings_sync_export_failed">Tiedostoa ei voitu tallentaa</string>
    <string name="settings_sync_code_warning">Tämä palautuskoodi on ainoa avain synkronoituihin kirjanmerkkeihisi. Tallenna se salasanojen hallintaasi — tai muuhun turvalliseen paikkaan. Sitä ei voi palauttaa, jos se hukataan.</string>

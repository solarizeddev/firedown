    <!--
        Browser popup contents used to live as three parallel arrays
        (ids / labels / icons) consumed by a RecyclerView adapter. The
        popup is now a static layout of MaterialCard sections in
        fragment_dialog_browser_popup.xml — the section grouping is too
        structurally meaningful to flatten back into a string array, and
        the click dispatch happens directly on each row's view id.
    -->


    <!--
        Home popup contents used to live as parallel string/icon arrays
        consumed by a RecyclerView adapter that dispatched the icon
        drawable resource id as the OptionEntity id. The popup is now a
        static layout of MaterialCard sections in
        fragment_dialog_home_popup.xml, and click dispatch happens
        directly on each row's view id (popup_history / popup_settings
        / popup_quit), so the arrays and the icon-id dispatch dance
        aren't needed any more.
    -->


    <string-array name="settings_doh">
        <item>@string/settings_doh_server_mullvad</item>
        <item>@string/settings_doh_server_quad9</item>
        <item>@string/settings_doh_server_cloudflare</item>
        <item>@string/settings_doh_server_custom</item>
    </string-array>


    <!--
      DoH ListPreference entryValues. The persisted SETTINGS_DOH value IS
      the DoH endpoint URL for presets; the trailing "custom" sentinel
      means "use the user-entered URL in SETTINGS_DOH_CUSTOM". Order must
      stay aligned with @array/settings_doh (display names). No positional
      index is stored — reordering or inserting a provider can't remap a
      user's saved choice, and there's no empty placeholder slot to
      special-case.
    -->
    <string-array name="settings_doh_servers">
        <item>https://dns.mullvad.net/dns-query</item>
        <item>https://dns.quad9.net/dns-query</item>
        <item>https://cloudflare-dns.com/dns-query</item>
        <item>custom</item>
    </string-array>

    <!-- P2P share STUN server (entries/values index-aligned; the stored value
         is the full stun: url — like settings_doh_servers, so no index remap
         hazard — with the "custom" sentinel routed to a text dialog in
         SettingsFragment). ONE server is handed to the engine per share:
         parallel fallbacks would leak the user's IP to every listed host. -->
    <string-array name="settings_p2p_stun_entries">
        <item>Cloudflare</item>
        <item>Nextcloud</item>
        <item>@string/settings_p2p_stun_custom</item>
    </string-array>

    <string-array name="settings_p2p_stun_values">
        <item>stun:stun.cloudflare.com:3478</item>
        <item>stun:stun.nextcloud.com:443</item>
        <item>custom</item>
    </string-array>



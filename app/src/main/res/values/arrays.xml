    <!-- Search engines: ONE order across all four parallel arrays below
         (settings_search / _host / _icon / _preference) — they're index-aligned
         and read together (SearchRepository.getEngineHost/getEngineIcon map
         name→index→host/icon). Selection is stored by NAME (SETTINGS_SEARCH_ENGINE)
         and URLs come from search/list.json keyed by name, so reordering is safe;
         just keep the four arrays in lockstep. Order is privacy-forward (this is
         a privacy/no-telemetry browser): the privacy engines users here are most
         likely to want lead, by recognition (DuckDuckGo, Brave, Startpage, Ecosia,
         Mojeek), then the mainstream giants (Google, Bing), then regional last
         (Yandex, Baidu). -->
    <string-array name="settings_host">
        <item>www.dudckduckgo.com</item>
        <item>search.brave.com</item>
        <item>www.startpage.com</item>
        <item>www.ecosia.org</item>
        <item>www.mojeek.com</item>
        <item>www.google.com</item>
        <item>www.bing.com</item>
        <item>www.yandex.com</item>
        <item>www.baidu.com</item>
    </string-array>



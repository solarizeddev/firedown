<resources>
    <declare-styleable name="FullscreenAttrs">
        <attr name="fullscreenBackgroundColor" format="color" />
        <attr name="fullscreenTextColor" format="color" />
    </declare-styleable>
    <declare-styleable name="LoginPanelTextInputLayout">
        <attr name="InputLayoutErrorTextColor" format="reference"/>
        <attr name="InputLayoutErrorIconColor" format="reference"/>
        <attr name="PromptLoginEditTextCursorColor" format="reference"/>
    </declare-styleable>
    <declare-styleable name="StateClickableImageButton">
        <attr name="stateClickable" format="boolean" />
    </declare-styleable>
    <declare-styleable name="TabsBrowserButton">
        <attr name="tabBackgroundDrawable" format="integer" />
        <attr name="tabTextColor" format="color" />
    </declare-styleable>
    <declare-styleable name="BottomNavigationBar">
        <!-- When true, the middle slot is laid out INVISIBLE — preserves the
             5-cell weight balance while leaving room for an externally-anchored
             FAB to sit over it. Used by the browser layout; home shows the
             bookmarks/search action in the slot instead. -->
        <attr name="hideMiddleSlot" format="boolean" />
        <!-- When true (default), the bar self-pads the system nav inset so
             its background owns the nav strip and the icon row sits above
             it — used by Home/incognito Home, which are NOT on the browser's
             framed root-padding model. The browser sets this FALSE: its root
             CoordinatorLayout reserves the nav strip with all-sides safe-area
             padding, so a bar self-pad there would double-inset. -->
        <attr name="selfPadSystemBars" format="boolean" />
    </declare-styleable>
    <declare-styleable name="GeckoToolbar">
        <attr name="enableHome" format="boolean" />
    </declare-styleable>
    <declare-styleable name="ExpandableButton">
        <attr name="expandableText" format="string" />
        <attr name="expandableChildView" format="reference" />
        <attr name="expandableIcon" format="reference" />
    </declare-styleable>
    <declare-styleable name="AspectRatioConstraintLayout">
        <!-- width / height — e.g. 0.75 for 3:4 (taller than wide). -->
        <attr name="aspectRatio" format="float" />
    </declare-styleable>
    <!-- Shared maxHeight attribute. Applied by any view in
         com.solarized.firedown.ui that needs to cap its measured
         height while keeping wrap_content semantics below the cap
         (currently MaxHeightRecyclerView). -->
    <declare-styleable name="MaxHeightView">
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>

    <!-- Set true on themes that already use the incognito palette
         (e.g. Theme.FireDown.Vault) so BaseActivity skips the AMOLED
         true-black overlay for them. Without this guard the overlay's
         pure-black surfaces clobber the incognito purple. -->
    <attr name="isIncognitoTheme" format="boolean" />

    <!-- The BRAND AS A MARK: the one token every brand-coloured selection
         glyph reads — the check + radio + grid stroke on every list
         (Downloads, Captured, Bookmarks, History, tab archive, Cloud Backup,
         Storage review, the active tab), the mime placeholder glyph, the P2P
         status checks. One token so they can never drift from each other
         (the tick and the placeholder glyph once wore two different reds on
         the same row). It resolves to the BRAND CORAL in both themes: light
         2.56:1 on the page / 2.2:1 on the selection wash, under the 3:1 line
         floor and accepted — the two deeper corals that met the floor
         (#CC524A, then #DB4444 at the brand's hue and higher chroma) both
         read BROWN on-device, because any coral at L* ≤ 55 does, and these
         marks are not colour-alone signals (the wash and the tick shape
         carry the state). The exception is a bar against its own TRACK,
         which has no shape cue and keeps @color/progress_indicator (#DB4444
         light) — the progress bars, the ring, the translate glyph. Read it as
         ?attr/brandInk in XML and through SelectionStyling.selectionInk(ctx)
         in Java — never the literal, never colorPrimary directly (the token
         is what lets a theme remap it: the incognito overlay and the Vault
         theme map it to their own primary). -->
    <attr name="brandInk" format="color" />
</resources>
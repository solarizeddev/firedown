    <!-- Strengthened from the spec-default #E4E2E5: High->Highest was only
         ~5 levels in light, too tight to give a lifted surface (the browser
         URL pill, the autocomplete suggestion cards) any separation. ~15
         levels now, matching the visible steps dark/OLED/incognito already
         have. Regular Home doesn't use Highest - its pill is High and its
         shelf tiles are surfaceContainer. -->
    <color name="md_theme_surfaceContainerHighest">#DAD8DD</color>
    <color name="md_theme_surfaceContainerLow_highContrast">#F5F3F6</color>
    <!-- Home shelf-tile chips - the single baked "Tonal" look (the home
         card-style picker was removed; this IS the home appearance).
         Dimmed tonal-container chroma so the chip is a small landmark, not
         an attention block, and the Downloads coral never twins the coral
         hero FAB. bg = chip fill, _on = icon. Light here, dark in
         values-night - keep in sync. -->
    <color name="home_chip_downloads">#FAD9D6</color>

    <!-- Surface - one purple family (hue ~265), ordered by elevation so
         the tones ramp consistently instead of mixing neutral greys with
         purple. Lightness ascends: lowest < dim < surface < container_low
         < container < high < highest < bright. Previously surface_variant /
         surface_dim / container_lowest were neutral greys, container_low was
         brighter than highest, and bright was darker than highest. -->
    <color name="incognito_surface">#FF391D5B</color>
    <color name="incognito_on_surface">#FFE4E2E5</color>
    <color name="incognito_surface_variant">#FF4A3A5E</color>

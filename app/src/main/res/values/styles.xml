    <style name="Firedown.Widget.App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Chip</item>
        <!-- Matches Theme.FireDown.Download.Chip: full pill + 36dp

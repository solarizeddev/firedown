        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Theme.FireDown.BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <!-- An OVERLAY, not a full theme, and it must stay one. A dialog's
             context copies the ACTIVITY theme and then applies this style on
             top with force=true — so a full theme here (it used to be
             Theme.Material3.DayNight.BottomSheetDialog plus a copy of the
             whole md_theme_* palette) overwrote every colour token the
             activity had layered on: the OLED true-black overlay and the
             accent presets both vanished inside every sheet. As an overlay it
             sets only what a sheet needs; every colour is inherited from the
             activity theme. Never re-add colour tokens here. -->
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainerHigh</item>
        <item name="bottomSheetStyle">@style/Theme.FireDown.BottomSheetDialogStyle</item>
        <!--
            M3 tints elevated surfaces with colorPrimary (#f0716c here)
            via the elevation-overlay machinery, so every MaterialCardView
            at elevation > 0 inside a sheet picks up an orange wash on
            top of its declared background. Disable the overlay so cards
            render with their cardBackgroundColor only.
        -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="actionOverflowButtonStyle">@style/Theme.FireDown.Toolbar.ActionMode.Overflow</item>
    </style>



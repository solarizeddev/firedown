    <!-- Browser popup quick-row chip — icon stacked over a label at
         5-up. Default Widget.Material3.Button.IconButton ships ~16dp
         of internal horizontal padding and 14sp text, which truncates
         even short labels like "Forward" at 5-up on a 360dp screen.
         Zero out the insets + inner horizontal padding, reduce the
         text to 11sp, and tighten iconPadding to 4dp so the visible
         label width is ~95% of the chip's weight column. Same recipe
         the DuckDuckGo browser menu uses for the same row shape. -->
    <style name="Firedown.Widget.PopupQuickRowButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <!-- Pure weight distribution: without this the IconButton's default
             minWidth can exceed a narrow column's weighted share and make
             the five columns uneven (an off-centre gap between buttons). -->
        <item name="android:minWidth">0dp</item>
        <item name="android:textColor">@color/popup_header_selector</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconTint">@color/popup_header_selector</item>
    </style>


    <!-- Browser popup list section label ("This page" / "Library"). Small,
         uppercase, letter-spaced and muted so it reads as a group eyebrow over
         the hairline rule rather than another tappable row. 16dp horizontal
         gutter to line up with the M3 list rows; tight vertical rhythm so the
         label hugs the group it heads. Mirrors the mockup's grouplabel. -->
    <style name="Firedown.PopupGroupLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>


    <style name="Theme.FireDown.Play.Toolbar" parent="ThemeOverlay.AppCompat.ActionBar">
        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:colorControlNormal">@color/white</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="android:windowActionBarOverlay">true</item>
    </style>


    <style name="Theme.FireDown.Popup" parent="Widget.Material3.PopupMenu">
        <!-- Customize color of navigation drawer icon and back arrow -->
<!--        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>-->
        <item name="overlapAnchor">true</item>
    </style>

    <style name="Theme.FireDown.Popup.Vault" parent="Theme.FireDown.Popup">
        <item name="android:textColor">@color/incognito_on_surface</item>
        <item name="android:textColorPrimary">@color/incognito_on_surface</item>
        <item name="android:textColorSecondary">@color/incognito_on_surface_variant</item>
        <item name="android:colorBackground">@color/incognito_surface_container_high</item>
        <item name="colorSurface">@color/incognito_surface_container_high</item>
    </style>

    <style name="Theme.FireDown.Popup.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="android:popupBackground">@drawable/dialog_background</item>
        <item name="overlapAnchor">true</item>
        <item name="android:dropDownVerticalOffset">14dp</item>
        <item name="android:dropDownHorizontalOffset">-12dp</item>
    </style>

    <style name="Theme.FireDown.Fab.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>


    <style name="Theme.FireDown.Toolbar.ActionMode.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_baseline_more_vert_24</item> <!-- whatever color -->
        <item name="srcCompat">@drawable/ic_baseline_more_vert_24</item> <!-- whatever color -->
    </style>

    <style name="Theme.FireDown.More.Button" parent="Widget.Material3.Button.IconOnly">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">30dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/white</item>
        <item name="android:layout_marginTop">@dimen/list_item_margin</item>
        <item name="android:layout_marginEnd">@dimen/list_item_margin</item>
    </style>


    <style name="Theme.FireDown.Selected.Button" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">@dimen/list_spacing</item>
        <item name="android:visibility">gone</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- TrackersInfoSheet top-row stat cards. Three equal tonal
         cards sharing a colorSurfaceContainer fill (no outline, no
         elevation) to match the home cards. Body LinearLayout
         centres the value+label pair vertically; value is title-
         large in colorPrimary so the three cards read as a single
         visual unit; label is label-small in onSurfaceVariant so
         it sits back from the number. Tabular numeric features on
         the value text so digit columns align when stats refresh. -->
    <style name="TrackersInfoStatCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="TrackersInfoStatBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <style name="TrackersInfoStatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TrackersInfoStatLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- TrackersInfoSheet breakdown rows. Three styles so the four
         rows in the layout stay short and consistent; tweaking one
         updates all four. Row = horizontal LinearLayout with vertical
         centering and a small vertical pad so successive rows breathe.
         Label = body-medium tinted onSurfaceVariant to read as
         secondary metadata vs the hero number above. Count = body-
         medium on-surface with tabular numeric features so the digit
         columns align across rows even with different glyph widths. -->
    <style name="TrackersInfoBreakdownRow" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="TrackersInfoBreakdownLabel" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TrackersInfoBreakdownCount" parent="">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>
</resources>
    <!-- Variant-picker chips (audio track / captions). TONAL checked state
         (secondaryContainer), NOT the brand overlay the filter rail uses:
         these chips sit directly above the Download CTA, so per the
         chip-vs-segment rule they take the buy-segment treatment — a
         selection control must never out-shout the button it feeds. Explicit
         color selectors rather than a theme overlay so the unchecked state
         is a quiet outline, matching the quality tiles beside them. -->
    <style name="Firedown.Widget.PickerChip" parent="Widget.Material3.Chip.Filter">
        <!-- The overlay is LOAD-BEARING: a Material chip paints a
             chipSurfaceColor (= colorSurface) layer UNDER chipBackgroundColor,
             so without neutralizing it the "transparent" resting chip and the
             15% checked wash both rendered as SOLID surface-colored pills
             on-device — nothing like the sketch's outline-and-wash. Same
             mechanism (and the same fix) as the filter rail's
             ThemeOverlay.App.Chip; own overlay because the rail's also
             remaps the container tones to the brand, which these must not
             take (they sit above the Download CTA). -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.Firedown.PickerChip</item>
        <item name="chipBackgroundColor">@color/picker_chip_bg</item>
        <item name="android:textColor">@color/picker_chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/picker_chip_stroke</item>
        <!-- Explicit check glyph: the caption chips' multi-select tick was
             NOT rendering from the M3 filter default on-device — pin the
             drawable rather than trust the library default. Visibility stays
             code-toggled (ON for captions, OFF for audio track). -->
        <item name="checkedIcon">@drawable/ic_check_18</item>
        <item name="checkedIconTint">?attr/colorPrimary</item>
        <item name="chipCornerRadius">100dp</item>
        <!-- Compact, like the sketch (and the quality tiles beside them):
             the M3 default 48dp touch-target reservation made every chip row
             read as a chunky solid bar. The chips sit in a generously-spaced
             wrap group, so the dense height is acceptable here. -->
        <item name="chipMinHeight">32dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="ThemeOverlay.Firedown.PickerChip" parent="">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/transparent</item>
    </style>

    <style name="ThemeOverlay.App.Chip" parent="">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/transparent</item>
        <!-- Checked filter chip = the BRAND, not the secondary ramp.
             Widget.Material3.Chip.Filter paints its selected state from
             colorSecondaryContainer, which in this palette is an apricot
             (#FFBF9B / #FAB186) — visibly a different hue family from the
             brand #f0716c, so the one permanently-visible "active" control
             on the screen was the one thing not wearing the brand. (The
             palette itself is inconsistent: md_theme_secondary IS #f0716c,
             but its container tone drifted off that base.)

             Remapped rather than reimplemented: the library keeps owning the
             enabled/checked/disabled selector logic, and both rails' chips
             (Captured via Firedown.Widget.App.Chip.Filter, Downloads via
             Theme.FireDown.Download.Chip and its chip_download selector,
             which also resolves ?attr/colorSecondaryContainer) pick the swap
             up from this one place. The label follows via
             colorOnSecondaryContainer so the pair can never disagree.

             NOT colorPrimary: #f0716c under a white label is 2.88:1, below
             the 4.5:1 floor.

             The values live in @color/chip_checked_container rather than
             ?attr/colorPrimaryContainer because the two themes want different
             things. LIGHT takes the container tone verbatim (#FF857F, label
             7.06:1) — a hue correction with no legibility change from the
             apricot it replaced. DARK does not: this palette's dark container
             (#F66A66) is within a hair of primary, so the checked chip landed
             at 6.34:1 against the page and was the hottest thing on screen.
             See values-night/colors.xml. -->
        <item name="colorSecondaryContainer">?attr/fdColorChipChecked</item>
        <item name="colorOnSecondaryContainer">?attr/fdColorOnChipChecked</item>
    </style>


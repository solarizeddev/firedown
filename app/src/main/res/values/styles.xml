    <!-- Full-screen dialog used by the P2P QR scanner: a <dialog> nav
         destination (so it does NOT destroy the send/receive fragment's view
         and kill the live WebRTC session), but filling the screen for the
         camera preview. windowIsFloating=false = fill, not a floating card. -->
    <style name="Firedown.FullScreenDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>

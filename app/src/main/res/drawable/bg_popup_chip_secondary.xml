<?xml version="1.0" encoding="utf-8"?>
<!--
    Secondary-tinted 32dp chip for popup library rows whose semantic
    is "time / when" — History. Sized to match the popup row chip
    pattern (32dp / 10dp corners) rather than the larger Home chip
    (40dp / 12dp corners).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSecondaryContainer" />
    <corners android:radius="10dp" />
</shape>

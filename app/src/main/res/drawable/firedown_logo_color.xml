<?xml version="1.0" encoding="utf-8"?>
<!--
  Coloured Firedown brand glyph used on the home empty state.
  Kept separate from ic_firedown.xml so the existing tint-driven
  usages (notification, toolbar new-tab) aren't affected.

  Path data is the SVG source verbatim; gradient endpoints were
  pre-multiplied through each linearGradient's gradientTransform
  so they live in the same coordinate space as the paths (0..26.458).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="26.458333"
    android:viewportHeight="26.458333">

    <!-- Pink / magenta top fin -->
    <path
        android:pathData="m10.059077,0.81411868 c0,4.29266792 8.205612,6.72968932 8.205612,10.32803432 v5.750813 H8.19368 L8.1938037,6.978367 C8.1938334,4.6551262 8.5283769,2.4749086 10.059077,0.81411868 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="11.389"
                android:startY="10.766"
                android:endX="20.781"
                android:endY="13.360">
                <item android:offset="0" android:color="#e83a87" />
                <item android:offset="1" android:color="#b4225e" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orange middle body -->
    <path
        android:pathData="m18.264518,10.940985 c0,2.757922 -6.376917,5.951742 -10.0707061,5.951742 l-3.7156375,0.00043 8.7509926,8.750997 8.750992,-8.751009 -3.715641,-0.00043 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12.952"
                android:startY="21.110"
                android:endX="11.023"
                android:endY="23.213">
                <item android:offset="0" android:color="#ff716c" />
                <item android:offset="1" android:color="#ff525b" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Peach lower-right facet -->
    <path
        android:pathData="m13.229167,25.644215 8.750992,-8.750997 h-3.715641 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18.137"
                android:startY="18.957"
                android:endX="19.276"
                android:endY="16.846">
                <item android:offset="0" android:color="#ffa386" />
                <item android:offset="1" android:color="#ffb58a" />
            </gradient>
        </aapt:attr>
    </path>

</vector>

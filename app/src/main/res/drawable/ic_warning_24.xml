<!--
    Material "warning" triangle. Carries no tint of its own — every consumer
    sets one, because the ONE place it is used (the browser-pairing approval
    sheet) needs it to follow ?attr/colorError, which differs per theme. A
    hardcoded amber here would repeat the backup_warning mistake: #e8a13d
    measures 2.09:1 on the light surface, i.e. the state most needing to be
    seen would be the least visible exactly half the time.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <path
      android:fillColor="@android:color/white"
      android:pathData="M1,21h22L12,2 1,21zM13,18h-2v-2h2v2zM13,14h-2v-4h2v4z"/>
</vector>

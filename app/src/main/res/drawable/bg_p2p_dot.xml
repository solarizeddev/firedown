<?xml version="1.0" encoding="utf-8"?>
<!-- P2P-share live indicator: green dot in a translucent ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#334CAF78" />
            <size android:width="18dp" android:height="18dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#4CAF78" />
        </shape>
    </item>
</layer-list>

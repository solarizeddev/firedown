<?xml version="1.0" encoding="utf-8"?>
<!--
  Capsule behind the Downloads grid tile's bottom-end facts pill (duration
  and/or the cloud-backed marker) on a BARE tile — one that shows a real
  picture and therefore carries no caption block at all.

  Deliberately a small self-contained container rather than ink-on-artwork:
  the pill is the only chrome at the bottom of such a tile, and a contained
  capsule reads on bright AND dark thumbnails without the full-width band the
  caption's bottom_scrim needs. 60% black is the Google Photos / YouTube
  duration-badge convention; it is NOT theme-aware on purpose — it sits on a
  photo, whose brightness doesn't follow the app theme (the same reasoning as
  the white ⋮ over artwork).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="999dp" />

    <solid android:color="#99000000" />

</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- The tonal disc behind an empty state's glyph in a bottom sheet (the
     "Blocked on this page" sheet's shield): one step up from the sheet's
     surfaceContainerHigh, so it reads as a quiet mark, not a button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorSurfaceContainerHighest" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Onboarding step-number chip: a soft coral-tinted rounded square behind the
  step index. Uses a translucent brand tint so it reads correctly on both the
  light (cream) and dark (true-black) home surfaces.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/onboard_step_bg" />
    <corners android:radius="9dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Quality tile ground: outline at rest, tonal secondaryContainer fill when
     ACTIVATED (the adapter's bindSelection sets setActivated). Tonal, never
     the brand — the tiles sit directly above the Download CTA (the
     chip-vs-segment rule; same reasoning as the buy-credit segments). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Quality tile ground: quiet outline at rest; ACTIVATED = a translucent
     brand wash + brand stroke (the sketch's treatment, and the app's own
     selected-row convention — SelectionStyling's low-alpha wash — rather
     than a solid container fill, which read far too loud on-device). One
     shape with state-driven color lists; the adapter's bindSelection sets
     setActivated. Ink stays the resting text colors — the wash is subtle
     enough that no on-container ink swap is needed. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/picker_tile_fill" />
    <stroke android:width="1dp" android:color="@color/picker_tile_stroke" />
    <corners android:radius="10dp" />
</shape>

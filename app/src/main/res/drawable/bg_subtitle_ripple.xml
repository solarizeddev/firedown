<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded press-state selector for the home subtitle's two tappable figures.
  Invisible at rest (no fill/stroke — keeps the line minimal), but the press
  ripple is masked to a rounded rect so each figure reads as its own tidy tap
  target — the press feedback a MaterialCard's rippleColor gives, without the
  resting chrome. The default selectableItemBackgroundBorderless ripple bleeds
  past short text and doesn't separate the two halves.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>

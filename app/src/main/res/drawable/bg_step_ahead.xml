<?xml version="1.0" encoding="utf-8"?>
<!-- Backup roadmap marker, a step still AHEAD: a quiet ring around its
     number (CloudStatusPreference.bindStep). Siblings: bg_step_current (the
     step the CTA under the card performs, filled like that button) and
     bg_step_done (a tonal disc behind a check). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="1.5dp"
        android:color="?attr/colorOutline" />
</shape>

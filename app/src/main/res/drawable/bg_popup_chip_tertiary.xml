<?xml version="1.0" encoding="utf-8"?>
<!--
    Tertiary-tinted 32dp chip for popup library rows whose semantic
    is "your saved content" — Bookmarks and Safe Folder. Smaller
    sibling of bg_icon_container_tertiary (40dp / 12dp corners used
    on Home cards); the popup chip uses 10dp corners so the curve
    stays in proportion to the reduced chip size.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorTertiaryContainer" />
    <corners android:radius="10dp" />
</shape>

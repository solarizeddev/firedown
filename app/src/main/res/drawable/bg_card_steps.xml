<?xml version="1.0" encoding="utf-8"?>
<!-- The "I have fiat" steps block on the Lightning pay stage: a QUIET tonal
     surface (surfaceContainerHigh, 16dp — the rail rows' radius), never the
     peach receipt chip it first shipped with (bg_credit_delta_chip is a
     999dp pill for ONE line; on three lines it rendered as a fat orange
     capsule above the QR, reported on-device). Instructions support the
     invoice, they don't act — no brand fill, no peach. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners android:radius="16dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Home address-bar button glyph: a full-size magnifier with a dropdown chevron
  centered BELOW it, hinting that the button opens the search-engine picker
  (not a plain "search/submit" action). Stroked paths so the single iconTint
  recolours the whole glyph to onSurface. The ring fills the upper box (so the
  magnifier reads at full size, like ic_search_24) with the chevron tucked at
  the very bottom.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- magnifier ring (center 10.5,9 r 6) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M4.5,9 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
    <!-- magnifier handle (to lower-right) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M14.8,13.3 L17.8,16.3" />
    <!-- dropdown chevron, centered at the bottom under the ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M7.5,18.7 L10.5,21.5 L13.5,18.7" />
</vector>

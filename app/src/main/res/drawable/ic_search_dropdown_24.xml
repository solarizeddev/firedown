<?xml version="1.0" encoding="utf-8"?>
<!--
  Home address-bar button glyph: a magnifier with a small dropdown chevron to
  its RIGHT ("search v"), hinting that the button opens the search-engine picker
  (not a plain "search/submit" action). Stroked paths so the single iconTint
  recolours the whole glyph to onSurface. Geometry previewed pixel-exact before
  shipping: ring center (8.5,11) r5, short handle to the lower-right, small
  down-chevron to the right, vertically centered on the ring.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- magnifier ring (center 8.5,11 r 5) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M3.5,11 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <!-- magnifier handle (short, to lower-right) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,14.5 L13.5,16" />
    <!-- dropdown chevron to the right, centered on the ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M16.5,9.8 L19,12.3 L21.5,9.8" />
</vector>

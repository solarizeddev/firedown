<?xml version="1.0" encoding="utf-8"?>
<!--
  Home address-bar button glyph: a magnifier with a small dropdown chevron,
  hinting that the button opens the search-engine picker (it isn't a plain
  "search/submit" action). Stroked paths so the single iconTint recolours the
  whole glyph to onSurface. Magnifier shrunk to the left to leave room for the
  chevron on the right within the 24x24 box.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorOnSurface">
    <!-- magnifier ring (center 9,10 r 4.5) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M4.5,10 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <!-- magnifier handle -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12.4,13.4 L15.5,16.5" />
    <!-- dropdown chevron -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M17.5,9.5 L19.75,11.75 L22,9.5" />
</vector>

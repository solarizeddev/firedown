<?xml version="1.0" encoding="utf-8"?>
<!--
  Tonal mime-chip pill for a grid FALLBACK (pastel audio/doc) tile. Those tiles
  are a solid theme card, not a photo, so they DON'T get the dark bottom_scrim
  and the ~50%-black rounded_chip_scrim would read as a muddy dark blob on a
  pale card. This is the card-mode chip instead: a white base the adapter tints
  to ~12% colorOnSurface (a quiet tonal tag that follows the theme — dark on the
  light pastel, light on the dark one), with colorOnSurface text. See
  DownloadItemAdapter.applyGridTileGround. Corners match rounded_chip_scrim (4dp)
  so the chip shape is identical between the scrim and card treatments.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white"/>
    <corners android:topLeftRadius="4dp"
        android:topRightRadius="4dp"
        android:bottomRightRadius="4dp"
        android:bottomLeftRadius="4dp"/>
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral "glass" pill for the grid tile's mime chip (MimePrimary). A faint
  15%-white fill over the always-dark bottom_scrim lifts the type label off the
  thumbnail as a quiet tag, WITHOUT the coral brand shout the old
  colorPrimaryContainer fill (rounded_primary) gave every tile. Corners match
  rounded_primary (4dp) so only the colour changed. The duration beside it stays
  bare scrim text — the mime is the one meta token that carries a background,
  the deliberate "chip = type identity" cue, now neutral instead of coral.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF"/>
    <corners android:topLeftRadius="4dp"
        android:topRightRadius="4dp"
        android:bottomRightRadius="4dp"
        android:bottomLeftRadius="4dp"/>
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral media-badge pill for the grid tile's mime chip (MimePrimary). A
  ~50%-BLACK fill over the bottom_scrim — the universal "duration badge" look —
  so the light chip text reads on ANY thumbnail, bright or dark, in either
  theme. (A faint 15%-WHITE fill was tried first and was nearly invisible on
  bright frames — light-pill + light-text has no contrast; the dark pill fixes
  that without any colour.) Still neutral, NOT the old coral colorPrimaryContainer
  fill that shouted the type on every tile. Corners match rounded_primary (4dp).
  The duration beside it stays bare scrim text — the mime is the one meta token
  that carries a background, the deliberate "chip = type identity" cue.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#80000000"/>
    <corners android:topLeftRadius="4dp"
        android:topRightRadius="4dp"
        android:bottomRightRadius="4dp"
        android:bottomLeftRadius="4dp"/>
</shape>

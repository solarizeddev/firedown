<?xml version="1.0" encoding="utf-8"?>
<!--
  Neutral media-badge pill for the grid tile's mime chip (MimePrimary). A
  ~80%-BLACK fill over the bottom_scrim (the universal "duration badge" look) so
  the light chip text reads on ANY thumbnail, bright or dark, in either theme.
  History (all on-device calls): coral colorPrimaryContainer shouted the type on
  every tile (removed); a 15%-WHITE fill was invisible on bright frames
  (light-pill + light-text has no contrast); a 50%-BLACK fill read fine for text
  but the pill itself was too faint to register as a badge; a 1dp translucent
  stroke to sharpen the capsule edge looked worse and was dropped. The darker
  ~80% fill is what looked best on device: a distinct capsule on both bright and
  dark art, still neutral (no colour). Corners match rounded_primary (4dp). The
  duration beside it stays bare scrim text — the mime is the one meta token that
  carries a background, the deliberate "chip = type identity" cue.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/rounded_chip_scrim"/>
    <corners android:topLeftRadius="4dp"
        android:topRightRadius="4dp"
        android:bottomRightRadius="4dp"
        android:bottomLeftRadius="4dp"/>
</shape>

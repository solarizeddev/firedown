<?xml version="1.0" encoding="utf-8"?>
<!--
    Soft "ember" glow that breathes behind the home flame mark WHILE a
    download is active (HomeFragment toggles it on TaskRepository's
    active+queued count — the same signal as the bottom-bar badge). A radial
    brand-orange bloom, faded to transparent at the oval edge so there's no
    hard ring. It's sized to the 40dp flame and grown into a halo purely by
    the animator's SCALE transform, so it adds NO layout size and bleeds
    beyond its box (the wrappers set clipChildren="false"). Identity as
    ambient status — no widget, no text; idle home stays just the wordmark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="20dp"
        android:startColor="#E6f0716c"
        android:centerColor="#66f0716c"
        android:endColor="#00f0716c" />
</shape>

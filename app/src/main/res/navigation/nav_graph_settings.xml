            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_settings_to_wasm"
            app:destination="@id/settings_wasm"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_settings_to_security"
            app:destination="@id/settings_security"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_settings_to_direct_share"
            app:destination="@id/settings_direct_share"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_settings_to_sync"
            app:destination="@id/settings_sync"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_settings_to_share_app"
            app:destination="@id/settings_share_app"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/settings_share_app"
        android:name="com.solarized.firedown.settings.ShareAppFragment"
        tools:layout="@layout/fragment_share_app" />
    <fragment
        android:id="@+id/settings_wasm"
        android:name="com.solarized.firedown.settings.WasmFragment" />
    <fragment
        android:id="@+id/settings_security"
        android:name="com.solarized.firedown.settings.SecurityFragment">
        <action
            android:id="@+id/action_security_to_wasm"
            app:destination="@id/settings_wasm"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/settings_direct_share"
        android:name="com.solarized.firedown.settings.DirectShareFragment" />
    <fragment
        android:id="@+id/settings_tabs"
        android:name="com.solarized.firedown.settings.TabsFragment" />
    <fragment
        android:id="@+id/settings_about"
        android:name="com.solarized.firedown.settings.AboutFragment" />
    <fragment
        android:id="@+id/settings_theme"
        android:name="com.solarized.firedown.settings.ThemeFragment" />
    <fragment
        android:id="@+id/settings_doh"
        android:name="com.solarized.firedown.settings.DohFragment" />
    <fragment
        android:id="@+id/settings_search"
        android:name="com.solarized.firedown.settings.SearchFragment" />
    <fragment
        android:id="@+id/settings_lock"
        android:name="com.solarized.firedown.settings.LockFragment" />
    <fragment
        android:id="@+id/settings_tracking"
        android:name="com.solarized.firedown.settings.TrackingFragment">
        <action
            android:id="@+id/action_tracking_to_query_params"
            app:destination="@id/settings_query_params"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/settings_query_params"
        android:name="com.solarized.firedown.settings.QueryParamsFragment" />
    <fragment
        android:id="@+id/settings_license"
        android:name="com.solarized.firedown.settings.LicenseFragment" />
    <dialog
        android:id="@+id/dialog_delete_browsing"
        android:name="com.solarized.firedown.phone.dialogs.DeleteBrowsingDialogFragment" />
    <dialog
        android:id="@+id/dialog_downloads_free"
        android:name="com.solarized.firedown.phone.dialogs.DownloadsDialogFragment" />
    <dialog
        android:id="@+id/dialog_downloads_path"
        android:name="com.solarized.firedown.phone.dialogs.DownloadsDialogFragment" />
    <dialog
        android:id="@+id/dialog_delete_password"
        android:name="com.solarized.firedown.phone.dialogs.DeleteLoginDialogFragment" />
    <fragment
        android:id="@+id/settings_quit"
        android:name="com.solarized.firedown.settings.QuitFragment" />
    <fragment
        android:id="@+id/settings_sync"
        android:name="com.solarized.firedown.settings.SyncSettingsFragment">
        <action
            android:id="@+id/action_sync_to_help"
            app:destination="@id/settings_sync_help"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_sync_to_buy"
            app:destination="@id/settings_cloud_backup_buy"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_sync_to_files"
            app:destination="@id/settings_cloud_backup_files"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <!-- Scanning a recovery code off another device. No anims: the
             destination is a full-screen DIALOG (see below). -->
        <action
            android:id="@+id/action_sync_to_scan"
            app:destination="@id/p2p_scan" />
    </fragment>
    <!-- The SAME scanner the P2P share screens use, reached here for the
         recovery code. A <dialog>, NOT a <fragment>, for the reason in
         P2pScanFragment's class doc — and it matters here too: the result is
         delivered to the PREVIOUS back-stack entry's SavedStateHandle, so
         settings_sync must still be on the stack (and alive) when the scan
         lands. A <fragment> destination would destroy its view first.
         Registered in this graph as well as nav_graph_downloads because the
         two activities host different graphs; same class, no duplication. -->
    <dialog
        android:id="@+id/p2p_scan"
        android:name="com.solarized.firedown.phone.fragments.P2pScanFragment"
        android:label="fragment_p2p_scan"
        tools:layout="@layout/fragment_p2p_scan" />
    <fragment
        android:id="@+id/settings_sync_help"
        android:name="com.solarized.firedown.settings.SyncHelpFragment" />
    <fragment
        android:id="@+id/settings_cloud_backup_buy"
        android:name="com.solarized.firedown.settings.BuyCreditFragment">
        <!-- Scanning a Nostr Wallet Connect string off the wallet's own screen.
             The SAME scanner again (see p2p_scan above) — a wallet shows its
             connection secret as a QR, so this is the primary connect path and
             typing is the fallback. No anims: the destination is a dialog. -->
        <action
            android:id="@+id/action_buy_to_scan"
            app:destination="@id/p2p_scan" />
    </fragment>
    <fragment
        android:id="@+id/settings_cloud_backup_files"
        android:name="com.solarized.firedown.settings.CloudBackupListFragment">
        <action
            android:id="@+id/action_cloud_backup_files_to_item_sheet"
            app:destination="@id/dialog_cloud_backup_item" />
        <action
            android:id="@+id/action_cloud_backup_files_to_buy"
            app:destination="@id/settings_cloud_backup_buy"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <!-- Deliberately a PLAIN push, no popUpTo: Cloud is a sibling screen
             visited FROM this list, so Back must return here, not skip to the
             caller. (The list itself was opened with popUpTo settings inclusive,
             so a second Back still leaves the settings tree for Downloads.)
             This is the only route from the Backups list to the Cloud screen —
             for a set-up account the Downloads overflow lands on this list, not
             on Cloud, so without it the recovery code / erasure rows / FAQ were
             reachable only from the Home or Browser popup. -->
        <action
            android:id="@+id/action_cloud_backup_files_to_sync"
            app:destination="@id/settings_sync"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <dialog
        android:id="@+id/dialog_cloud_backup_item"
        android:name="com.solarized.firedown.settings.CloudBackupItemSheetDialogFragment" />
</navigation>
    <string name="settings_sync_code_warning">Ta obnovitvena koda je edini ključ do vaših sinhroniziranih zaznamkov. Shranite jo v upravitelja gesel — ali na drugo varno mesto. Če jo izgubite, je ni mogoče obnoviti.</string>
    <string name="settings_sync_delete_action">Izbriši</string>
    <string name="settings_sync_delete_done">Vaši podatki so bili izbrisani s strežnika</string>
    <string name="settings_sync_delete_failed">Brisanje ni uspelo — preverite povezavo in poskusite znova</string>
    <string name="settings_sync_delete_message">S tem trajno izbrišete svoje šifrirane zaznamke s strežnika in izklopite sinhronizacijo na tej napravi. Zaznamki na tej napravi ostanejo. Tega ni mogoče razveljaviti — druge naprave ne bodo več mogle obnoviti s strežnika.</string>
    <string name="settings_sync_delete_started">Brisanje vaših podatkov s strežnika…</string>
    <string name="settings_sync_delete_summary">Trajno izbriši svoje šifrirane zaznamke s strežnika</string>
    <string name="settings_sync_delete_title">Izbriši podatke s strežnika</string>
    <string name="settings_sync_export_caveat_message">Ta datoteka je shranjena nešifrirana — kdorkoli jo lahko prebere, lahko prebere vaše zaznamke. Uvozite kodo v upravitelja gesel (ali na drugo varno mesto), nato pa datoteko izbrišite. Upravitelj gesel jo ohrani šifrirano; nezavarovana datoteka ne.</string>

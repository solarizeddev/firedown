    <string name="settings_sync_delete_title">Slett data fra server</string>
    <string name="settings_sync_export_caveat_message">Denne filen lagres ukryptert — alle som kan lese den, kan lese bokmerkene dine. Importer koden i passordbehandleren din (eller et annet trygt sted), og slett deretter filen. En passordbehandler holder den kryptert; en løs fil gjør det ikke.</string>
    <string name="settings_sync_export_continue">Fortsett</string>
    <string name="settings_sync_export_done">Gjenopprettingskode lagret</string>
    <string name="settings_sync_export_failed">Kunne ikke lagre filen</string>
    <string name="settings_sync_export_file_body">Firedown — gjenopprettingskode for bokmerkesynkronisering\n\n%1$s\n\nDenne koden er den eneste nøkkelen til de synkroniserte bokmerkene dine — alle som har den, kan lese dem, og den kan ikke gjenopprettes hvis den mistes.\n\nDenne filen er IKKE kryptert. Importer koden i passordbehandleren din (eller et annet trygt sted), og slett deretter denne filen.</string>
    <string name="settings_sync_export_summary">Eksporter koden som en tekstfil du kan oppbevare</string>
    <string name="settings_sync_export_title">Lagre gjenopprettingskode til fil</string>
    <string name="settings_sync_faq_a1">Ja. Hvert bokmerke krypteres på denne enheten før det lastes opp. Serveren lagrer bare kryptert data den ikke kan lese.</string>
    <string name="settings_sync_faq_a2">Nei. Bare gjenopprettingskoden din kan låse opp bokmerkene dine. De er ende-til-ende-kryptert, ingenting personlig er knyttet til dem, og serveren ser aldri de ukrypterte dataene.</string>
    <string name="settings_sync_faq_a3">En nøkkel som genereres på enheten din når du slår på synkronisering. Det er det eneste som kan dekryptere bokmerkene dine — på denne enheten eller en ny.</string>
    <string name="settings_sync_faq_a4">De synkroniserte bokmerkene dine kan ikke gjenopprettes — verken av deg eller av oss, fordi vi aldri hadde nøkkelen. Det finnes ingen tilbakestilling av passord. Lagre koden et trygt sted; en passordbehandler er ideell.</string>
    <string name="settings_sync_faq_a5">Nei. Det er ingen registrering, e-post eller telefonnummer — bare gjenopprettingskoden. Ingenting personlig er knyttet til bokmerkene dine.</string>
    <string name="settings_sync_faq_a6">Synkronisering er valgfritt og av som standard. Du kan alltid eksportere bokmerkene dine til en fil og importere dem senere, uten at en server er involvert.</string>

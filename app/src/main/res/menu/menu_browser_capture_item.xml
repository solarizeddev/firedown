<?xml version="1.0" encoding="utf-8"?>
<!--
  The Captured row's ⋮ menu (issue #302) — a PopupMenu anchored on the
  more-button (BrowserOptionFragment.showItemMenu). The ⋮ used to open the
  variant picker directly and was shown only for multi-quality items; it now
  shows whenever the item has AT LEAST ONE of these actions, and quality
  selection became the menu's last entry (visible only when the capture has
  variants — same gate the button itself used to carry). Copy/Share/Open are
  visible whenever the capture carries a plain http(s) URL (see
  CaptureUrlActions.copyableUrl — SABR's empty media URLs self-exclude), Open
  additionally needs a resolvable player on the device.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/action_copy_url"
        android:title="@string/capture_copy_url"/>
    <item
        android:id="@+id/action_share_url"
        android:title="@string/capture_share_url"/>
    <item
        android:id="@+id/action_open_external"
        android:title="@string/open_in_app_title"/>
    <item
        android:id="@+id/action_show_variants"
        android:title="@string/capture_show_variants"/>
</menu>

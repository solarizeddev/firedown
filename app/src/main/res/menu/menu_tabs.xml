    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The grid/list toggle is NOT here: it's the dedicated button in the
         tabs bottom bar (action_view_btn). This menu is the bar's overflow
         (PopupMenu). -->
    <item
        android:id="@+id/action_close_all"
        android:icon="@drawable/ic_baseline_close_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/popup_tabs_close"/>

    <item
        android:id="@+id/action_tabs_archive"
        android:icon="@drawable/ic_baseline_archive_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/popup_tabs_archive"/>

    <item
        android:id="@+id/action_settings"
        android:icon="@drawable/ic_settings_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/navigation_settings"/>

</menu>
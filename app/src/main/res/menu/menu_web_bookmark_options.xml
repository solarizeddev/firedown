<?xml version="1.0" encoding="utf-8"?>
<!--
    Bookmarks-list toolbar menu. Deliberately its OWN file rather than
    adding action_sort to menu_web_options.xml: WebHistoryFragment
    inflates menu_web_options too, and history has no sort toggle —
    a shared item would need a hide/handle branch there. A separate
    menu keeps history completely untouched.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Plain icon: reveals the in-place search field hosted in the toolbar
         (handled in WebBookmarkFragment), not a collapsible action view. -->
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always"
        android:title="@string/search"/>
    <item
        android:id="@+id/action_sort"
        android:icon="@drawable/ic_sort_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="ifRoom"
        android:title="@string/sort"/>
    <item
        android:id="@+id/action_delete"
        android:icon="@drawable/ic_baseline_delete_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="ifRoom"
        android:title="@string/delete"/>
    <!-- Infrequent actions live in the overflow (never as toolbar icons) so the
         row stays search / sort / delete. -->
    <item
        android:id="@+id/action_import"
        app:showAsAction="never"
        android:title="@string/bookmark_import"/>
    <item
        android:id="@+id/action_export"
        app:showAsAction="never"
        android:title="@string/bookmark_export"/>
    <!-- Bookmark sync lives here (next to import/export) as well as in Settings;
         opens SyncSettingsFragment via SettingsActivity (EXTRA_OPEN_SYNC). -->
    <item
        android:id="@+id/action_sync"
        app:showAsAction="never"
        android:title="@string/settings_sync_title"/>
</menu>

<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- THE THREE BAR ICONS ARE ALL "always" — never mix always with ifRoom
         here. appcompat's ifRoom budget is TWO icons at phone width
         (abc_max_action_buttons), and an "always" item SPENDS one of them:
         when Safe Folder alone was "always", Search kept the one remaining
         ifRoom slot and Toggle view fell into the overflow (on-device,
         360dp). Four glyphs (three + ⋮) fit beside the "Downloads" title
         with room to spare, so all three are pinned. -->

    <!-- Plain action icon: it reveals the in-place Material search bar in the
         second app-bar row (handled in BaseDownloadFragment.handleMenuAction),
         no longer a collapsible appcompat SearchView action view. -->
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always"
        android:title="@string/search"/>
    <item
        android:id="@+id/action_view"
        android:icon="@drawable/ic_view_list_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always"
        android:title="@string/popup_toggle"/>

    <!-- Safe Folder — the local encrypted downloads (VaultActivity). It is the
         ONE destination in the bar, always visible: a place the user returns
         to (the vault is the other half of "my downloads"), not a one-off
         action. It took the third slot from Sort, which was ifRoom and on a
         360dp phone lost that slot anyway — so the overflow read Sort ·
         Storage · Safe Folder · Backups · Receive, with the most-visited
         destination buried below a sort option. "always" rather than ifRoom
         so the bar has ONE shape on every width. -->
    <item
        android:id="@+id/action_safe"
        android:icon="@drawable/ic_lock_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always"
        android:title="@string/navigation_vault"/>

    <!-- Sort — demoted to the overflow on EVERY width (never ifRoom): it is a
         once-in-a-while preference, and a slot that only appears on wide
         devices made the menu change shape between phones. First row so it
         stays one tap away. -->
    <item
        android:id="@+id/action_sort"
        android:icon="@drawable/ic_sort_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/sort"/>

    <!-- The DESTINATIONS below live in the ⋮ overflow, not the bar: they
         leave the Downloads screen (sibling storage surfaces + the P2P
         receive door), so they shouldn't compete with the list controls
         (search/view) for the visible icon slots. General app Settings is
         deliberately NOT here — it's app-global, not downloads-scoped, and is
         reachable from the browser + tabs popups. -->

    <!-- Storage — per-type usage bar + "Review storage" (StorageFragment).
         Its rows hand a filter/sort back to THIS list, so it lives here. -->
    <item
        android:id="@+id/action_storage"
        android:icon="@drawable/ic_storage_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/storage_title"/>

    <!-- The cloud Backed-up files list (a downloads-related surface, so it
         lives here in addition to Settings → Sync → Downloads backup). -->
    <item
        android:id="@+id/action_cloud_backup"
        android:icon="@drawable/cloud_done_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/cloud_backup_files_title"/>

    <!-- P2P share receiver entry — the inbound half of the per-item "Send", and
         the received file lands in THIS list, so Downloads is its home. -->
    <item
        android:id="@+id/action_receive"
        android:icon="@drawable/ic_qr_scan_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="never"
        android:title="@string/p2p_receive_title"/>

</menu>
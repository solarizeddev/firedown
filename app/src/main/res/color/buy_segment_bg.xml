<?xml version="1.0" encoding="utf-8"?>
<!--
  Background tint for the buy-credit segmented toggles. The default outlined
  MaterialButton fills a CHECKED segment with a colorPrimary (coral) overlay,
  which made the selected segment a loud coral block. Use the M3
  secondaryContainer tonal fill instead: clearly "selected" at a glance in BOTH
  themes (the earlier colorSurfaceVariant grey was near-invisible on the dark
  surface) while the coral stays reserved for the selected plan tile's stroke +
  the Continue CTA. Unselected = transparent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorSecondaryContainer" />
    <item android:color="@android:color/transparent" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Picker chip ground (audio-track / caption chips): the same translucent
     brand wash the quality tiles wear when checked — NOT a solid container
     fill (too loud on-device) and NOT the filter rail's brand overlay (these
     sit above the Download CTA). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:alpha="0.15" android:color="?attr/colorPrimary" />
    <item android:color="@android:color/transparent" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Text (and icon) colour for the segmented toggles (duration + pay rail) in the
  buy-credit screen. The default outlined-button text is colorPrimary (brand
  coral), which put coral on every UNSELECTED segment and made the screen feel
  loud / the unselected options read as active. Here the accent is spent only on
  the primary action + selected states: the shared selected-control label on the
  checked segment (pairs with buy_segment_bg's fill — 6.20:1 light, 4.73:1 dark),
  muted grey when not.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/selected_control_on_container" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>

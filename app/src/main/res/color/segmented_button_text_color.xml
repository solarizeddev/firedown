<!-- res/color/segmented_button_text_color.xml — checked content reads at
     full onSurface, unchecked recedes to onSurfaceVariant. Keep in sync
     with IncognitoColors.segmentedButtonContent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnSurface" android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Card background for the buy-credit plan/denomination tiles. The SELECTED tile
  gets the same neutral colorSurfaceVariant tonal fill as the checked segment of
  the duration/rail toggles (buy_segment_bg), so one selection language runs
  through the whole pick screen — a stroke-only selection was easy to miss,
  especially in dark. Unselected stays the plain card surface. No coral: the
  Continue button is the screen's only accent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorSurfaceVariant" />
    <item android:color="?attr/colorSurface" />
</selector>

    <string name="settings_sync_delete_title">Slet data fra server</string>
    <string name="settings_sync_export_caveat_message">Denne fil gemmes ukrypteret — enhver, der kan læse den, kan læse dine bogmærker. Importér koden i din adgangskodeadministrator (eller et andet sikkert sted), og slet derefter filen. En adgangskodeadministrator holder den krypteret; en løs fil gør ikke.</string>

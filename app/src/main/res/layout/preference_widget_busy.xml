<?xml version="1.0" encoding="utf-8"?>
<!--
  The trailing spinner of a BusyPreference row (the preference's widget
  slot): shown while the row's action runs (an add-on installing), GONE
  otherwise. Indeterminate: GeckoView reports no download progress for an
  install.
-->
<com.google.android.material.progressindicator.CircularProgressIndicator xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preference_busy"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:indeterminate="true"
    android:visibility="gone"
    app:indicatorColor="?attr/brandInk"
    app:indicatorSize="24dp"
    app:trackThickness="3dp" />

<?xml version="1.0" encoding="utf-8"?>
<!--
  Share Firedown — the in-person QR + the remote link, on one page.

  Two registers, the same split the P2P share screens already use: the QR is
  the IN-PERSON handover (point another phone at the screen, no messenger, no
  network) and the button is the REMOTE one (a tappable link a chat app will
  linkify). That is why the button shares the URL as text rather than the QR
  as an image — an image in a chat has to be scanned off a second screen, and
  most messengers drop the accompanying text when a picture is attached.

  The URL is deliberately NOT tinted colorPrimary: the brand coral measures
  2.56:1 on the light surface (below the 4.5:1 floor) while reading fine in
  dark — the theme-flipping ink defect this repo has now shipped three times.
  It is bold onSurface, which is what a displayed VALUE should be anyway; the
  QR and the button are the actions.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <!-- match_parent (not wrap_content) so fillViewport hands this column the
         whole viewport and the Space weight below can push the button down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/share_app_blurb"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageView
            android:id="@+id/share_app_qr"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:padding="10dp"
            android:background="@drawable/bg_p2p_qr"
            android:contentDescription="@string/share_app_qr_desc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/share_app_get_at"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/share_app_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            tools:text="firedown.app" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/share_app_scan"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Pushes the button to the bottom of the viewport on a tall screen
             (fillViewport) and simply follows the content on a short one. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share_app_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/share_app_share"
            app:icon="@drawable/ic_share_24"
            app:iconSize="18dp"
            app:cornerRadius="14dp" />

    </LinearLayout>

</ScrollView>

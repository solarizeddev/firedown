<?xml version="1.0" encoding="utf-8"?>
<!--
  One quiet status row at the top of the Enhanced Tracking Protection
  screen: what this protection has DONE (Gecko's persisted ETP database
  count), above the Standard / Strict / Custom control that adjusts it.
  Fed by TrackingFragment via TrackingStatusPreference.

  Laid out to MIRROR the androidx preference row geometry — same
  ?attr/listPreferredItemPaddingStart inset and a 56dp icon frame — so the
  coral glyph lines up with the Standard/Strict/Custom icons below it and
  the text lines up with their titles (no card, which would inset the icon
  out of that column). Uses a non-shield icon (eye-slash = "not tracked")
  since all three controls below already use shield-family icons. It's the
  SAME footprint glyph the root Settings row uses for Enhanced Tracking
  Protection (footprints = tracking), so the feature reads consistently.

  Hidden until the DB has recorded an event.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="?attr/listPreferredItemPaddingStart"
    android:paddingEnd="?attr/listPreferredItemPaddingEnd"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Mirrors the androidx preference icon_frame (icon at the start, 56dp
         min width) so both the icon column and the text column align with
         the control rows below. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="56dp"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/footprint_24"
            android:tint="?attr/colorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tps_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="13 trackers blocked" />

        <TextView
            android:id="@+id/tps_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Recording since 22 Jul 2026" />
    </LinearLayout>

    <!-- The row is tappable — opens the tracking-protection detail sheet.
         A chevron makes that affordance visible (not just a ripple). -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right_24"
        android:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>

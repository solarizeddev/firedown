<?xml version="1.0" encoding="utf-8"?>
<!--
  Streaming viewer for a backed-up cloud file (CloudBackupStreamActivity). Styled
  to match the local media viewer (fragment_media_viewer.xml): the same custom
  PlayerView controller, fit resize, brand scrubber (all FOUR timebar colours —
  see player_scrubber_* in colors.xml; overriding played_color alone left the bar
  reading white), and the built-in buffering spinner (app:show_buffering). The
  overlay ActionBar (Theme.FireDown.Play) carries the file title plus a
  "Streaming from cloud backup" subtitle — the only thing on this screen that
  says the file isn't local. Note the activity must set DISPLAY_SHOW_TITLE in
  code for either to render (see CloudBackupStreamActivity).
  Video/audio play through a decrypt-on-read VaultDataSource; still
  images decode into cb_stream_image. cb_stream_progress covers the initial
  key/reader load before the player takes over (buffering is then the PlayerView's).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/cb_stream_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:auto_show="false"
        app:buffered_color="@color/player_scrubber_buffered"
        app:controller_layout_id="@layout/exo_media_viewer_controller"
        app:played_color="@color/md_theme_primary"
        app:resize_mode="fit"
        app:scrubber_color="@color/md_theme_primary"
        app:unplayed_color="@color/player_scrubber_unplayed"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black"
        app:surface_type="texture_view" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cb_stream_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/cb_stream_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>

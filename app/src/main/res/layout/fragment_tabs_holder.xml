<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Header is a compact, centred, icon-only mode switcher on an ALWAYS
        TONAL bar (surfaceContainer — the same tone as the bottom bar, so
        the screen reads as a framed switcher, Chrome's tab-grid
        composition). Two consequences, both deliberate:

        - The old full-width outlined segmented button was the heaviest
          element on the screen for its least-used action; icon pills carry
          the same state (selection fill + the full-page incognito theme
          flip) at a fraction of the ink. contentDescriptions carry the
          text for a11y.

        - The lift-on-scroll scrim machinery was DELETED, not moved: its
          only job was fading the tonal colour in on scroll, and an
          always-tonal header has nothing to fade. (Historical note: it was
          a hand-rolled sibling-View alpha fade because AppBarLayout's own
          liftOnScroll races its shouldLift/canScrollVertically check
          across the ViewPager2 boundary — if a scroll-elevation effect is
          ever wanted again, resurrect the scrim approach from git history,
          do NOT reach for liftOnScroll.)

        The header container takes the status-bar inset as top padding in
        code; colours follow applyIncognitoTheme.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:id="@+id/tabs_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tab_mode_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@android:color/transparent"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btn_regular_tabs">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_regular_tabs"
                    style="@style/Theme.FireDown.SegmentedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/tabs_regular"
                    android:minWidth="72dp"
                    app:icon="@drawable/ic_tabs_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:strokeWidth="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_incognito_tabs"
                    style="@style/Theme.FireDown.SegmentedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/tabs_incognito"
                    android:minWidth="72dp"
                    app:icon="@drawable/ic_tabs_private_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:strokeWidth="0dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tabs_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <!-- Bottom action bar — same chrome grammar as the BROWSER's bar
         (bottom_bar.xml): app_bar_size height, five equal-weight slots,
         the 56dp hero FAB in the centre slot. Browser -> tabs is the
         highest-frequency navigation in the app; keeping the skeleton
         identical (hero button pixel-aligned with the fire FAB, overflow
         in the same rightmost slot as the browser's more_button) makes
         the transition read as "the same bar changed mode". Slots 2/4
         are empty on purpose. Background + icon tints follow
         applyIncognitoTheme; bottom padding gains the nav-bar inset in
         code so the bar paints edge-to-edge behind gesture nav. -->
    <LinearLayout
        android:id="@+id/tabs_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/action_view_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/popup_toggle"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_view_list_24"
            android:tint="?attr/colorOnSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/action_overflow_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tabs_more_options"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_more_vert_24"
            android:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Hero FAB floats OVER the bar's middle slot, exactly like the
         browser's fire FAB: that one rides its anchored position with a
         16dp (app_bar_fab_margin) lift from BottomNavigationFABBehavior,
         which puts its top edge slightly over the bar's top border —
         docking a FAB inside the 64dp row can't match that. Bottom margin
         (nav inset + the same 16dp constant) is applied in code. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/popup_tabs_new"
        app:fabSize="normal"
        app:maxImageSize="24dp"
        app:srcCompat="@drawable/add_24" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Header is the segmented toggle ALONE — the old toolbar ("Tabs" title
        + back arrow) was redundant: the toggle already names the screen and
        system back serves handleBack. Its actions moved to the bottom bar.

        AppBar background is a STATIC resting surface colour (set in
        applyIncognitoTheme / onCreateView). The "lifted" look on scroll is
        produced by fading in the sibling @id/appbar_lift_scrim view which
        sits behind the toggle.

        We DO NOT use AppBarLayout's built-in liftOnScroll — its internal
        shouldLift / canScrollVertically path races our updates across the
        ViewPager2 boundary. Driving alpha on a plain sibling View has no
        state machine to race.

        Elevation is set to 0dp so AppBar never casts a shadow based on its
        own lifted-state tracking. Any shadow, if desired, would be added by
        the scrim itself.

        The toggle container is transparent so the scrim shows through it
        uniformly when it fades in. The container takes the status-bar inset
        as top padding in code (the toolbar used to absorb it).
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/appbar_lift_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0" />

            <LinearLayout
                android:id="@+id/tabs_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Material3 Segmented Button -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tab_mode_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/btn_regular_tabs">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_regular_tabs"
                        style="@style/Theme.FireDown.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tabs_regular"
                        app:icon="@drawable/ic_tabs_24"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_incognito_tabs"
                        style="@style/Theme.FireDown.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tabs_incognito"
                        app:icon="@drawable/ic_tabs_private_24"
                        app:iconGravity="textStart"
                        app:iconSize="18dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tabs_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <!-- Bottom action bar — same chrome grammar as the BROWSER's bar
         (bottom_bar.xml): app_bar_size height, five equal-weight slots,
         the 56dp hero FAB in the centre slot. Browser -> tabs is the
         highest-frequency navigation in the app; keeping the skeleton
         identical (hero button pixel-aligned with the fire FAB, overflow
         in the same rightmost slot as the browser's more_button) makes
         the transition read as "the same bar changed mode". Slots 2/4
         are empty on purpose. Background + icon tints follow
         applyIncognitoTheme; bottom padding gains the nav-bar inset in
         code so the bar paints edge-to-edge behind gesture nav. -->
    <LinearLayout
        android:id="@+id/tabs_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/action_view_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/popup_toggle"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_view_list_24"
            android:tint="?attr/colorOnSurface" />

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_new_tab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="@string/popup_tabs_new"
                app:fabSize="normal"
                app:maxImageSize="24dp"
                app:srcCompat="@drawable/add_24" />

        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/action_overflow_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_size"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tabs_more_options"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_more_vert_24"
            android:tint="?attr/colorOnSurface" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

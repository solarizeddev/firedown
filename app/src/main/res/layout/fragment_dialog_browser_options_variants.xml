<?xml version="1.0" encoding="utf-8"?>
<!-- wrap_content root + a packed vertical chain, so with the holder's
     per-page WRAP height the sheet HUGS this page (a 3-rung capture is a
     compact card, not a full-height sheet with a void between the tiles and
     the buttons). The scroll region is height=wrap + constrainedHeight, so
     a long content set (50+ caption chips) shrinks it against the sheet's
     max height instead of pushing the buttons off-screen — the same single
     inner scroll the old weight=1 gave, without forcing full height. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.FireDown.Toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/variants_scroll"
        app:layout_constraintVertical_chainStyle="packed"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="?attr/colorOnSurface"
        app:popupTheme="@style/Theme.FireDown.Popup"
        app:title="@string/download_quality" />

    <!-- Scroll container for the stacked sections (quality tiles + audio
         chips + caption chips), each height=wrap_content; the outer
         NestedScrollView gives one scroll when the content is long (50+
         caption tracks on YouTube — though the chip/tile geometry keeps most
         captures on one screen, the point of the tile redesign). -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/variants_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/picker_buttons">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Material3.LabelLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:text="@string/quality_section_title"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- 3-column TILE grid — a quality label is a few characters,
                 so three fit per row and a 9-rung YouTube ladder is 3 rows,
                 not 9. Tiles carry their own 3dp margins. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="13dp"
                android:paddingVertical="4dp"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="3" />

            <!-- Audio track section. Only multi-audio-track videos (YouTube
                 auto-dubbing) show it; single-track captures keep it GONE.
                 Single-select chips — the original-language track is
                 preselected, picking another swaps the download's audio. -->
            <LinearLayout
                android:id="@+id/audio_track_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/audio_track_header"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="2dp"
                    android:text="@string/audio_track_section_title"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Wrapping single-select CHIPS, not tiles: dub names
                     ("Español (Latinoamérica)") clip in a fixed column but
                     flow at natural width as chips. selectionRequired keeps
                     the original track checked until another is picked. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/audio_track_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    app:chipSpacingVertical="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

            </LinearLayout>

            <!-- Captions section. Whole block is GONE when the video has no
                 captured caption tracks; otherwise header + multi-select
                 chips appear below the quality tiles. -->
            <LinearLayout
                android:id="@+id/captions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/captions_header"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="2dp"
                    android:text="@string/captions_section_title"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Wrapping multi-select check-chips — ~3 per row where
                     the old list spent a 56dp row per language, so YouTube's
                     50-language case is ~17 rows instead of 50. -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/captions_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    app:chipSpacingVertical="4dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/picker_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/variants_scroll"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/download" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="false">

        <com.solarized.firedown.geckoview.GeckoToolbar
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            app:enableHome="true" />

    </com.google.android.material.appbar.AppBarLayout>


    <!--
        MINIMAL home (a slick private browser; downloading is a quiet superpower,
        not a billboard). Top→bottom: the functional URL bar (GeckoToolbar, in the
        AppBarLayout above), then a brand block + a single live stat line
        (trackers blocked · total saved). There is deliberately NO downloads
        carousel, Safe Folder card, Trackers card, or Continue-browsing card here
        — the search bar is the home, tabs live behind the bottom-bar tab button,
        downloads behind the download button (badge), the Captured sheet fills as
        you browse, and the trackers stat is folded into the privacy line.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- The minimalist home is a single calm, centred brand mark — the flame
             logo + wordmark — and nothing else. No stats, shortcuts, recents, or
             active-download strip; tabs and the downloads badge live in the
             bottom bar, the vault in the menu. The FrameLayout (stretched to the
             viewport by the NestedScrollView's fillViewport) centres the mark via
             layout_gravity. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">


            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <!-- Flame + the breathing ember glow behind it. The wrapper is
                     sized to the 40dp flame (no layout change vs the bare
                     ImageView); the glow is also 40dp and only becomes a halo
                     via the animator's SCALE transform, drawn beyond the box
                     because this and the ancestors set clipChildren="false".
                     The glow is GONE/alpha 0 at rest — HomeFragment shows it
                     and runs the breath only while a download is active. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/home_brand_glow"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/home_ember_glow"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_firedown_logo" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- One quiet subtitle line: two independently-tappable live
                     figures — trackers blocked (→ trackers info sheet) and total
                     downloaded (→ Downloads) — with a middle-dot divider. Each
                     half hides when its value is 0 (and the divider hides unless
                     both show), so a fresh install reads just the wordmark. Bound
                     in HomeFragment. -->
                <LinearLayout
                    android:id="@+id/home_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/home_subtitle_blocked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/transparent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/home_subtitle_blocked_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="10.5K blocked" />

                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:id="@+id/home_subtitle_sep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="5dp"
                        android:text="·"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/home_subtitle_saved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/transparent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/home_subtitle_saved_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="9.5 GB saved" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Cloud Backup status — a second quiet line under the stats,
                     shown ONLY when Cloud Backup is set up (bound in HomeFragment;
                     never on a fresh install, never in incognito — this is the
                     regular home). Same transparent-chip treatment as the subtitle
                     halves; tap → the Downloads-backup screen. Neutral normally,
                     coloured only when it needs attention (paused). -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_cloud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/transparent"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/home_cloud_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        tools:text="Backups on · 12 files" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>



        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar at the top covers search, so the
        centre slot is the bookmarks-list entry. (The former hero
        Bookmarks FAB was removed.)
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

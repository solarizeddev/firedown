<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="false">

        <com.solarized.firedown.geckoview.GeckoToolbar
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            app:enableHome="true" />

    </com.google.android.material.appbar.AppBarLayout>


    <!--
        MINIMAL home (a slick private browser; downloading is a quiet superpower,
        not a billboard). Top→bottom: the functional URL bar (GeckoToolbar, in the
        AppBarLayout above), then a brand block + a single live stat line
        (trackers blocked · total saved). There is deliberately NO downloads
        carousel, Safe Folder card, Trackers card, or Continue-browsing card here
        — the search bar is the home, tabs live behind the bottom-bar tab button,
        downloads behind the download button (badge), the Captured sheet fills as
        you browse, and the trackers stat is folded into the privacy line.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- Two mutually-exclusive home cards share this frame; exactly one is
             VISIBLE at a time (toggled in HomeFragment, see updateHomeCard):

             * home_stats_card  — the live 3-up (trackers / saved / Safe Folder),
               top-anchored (wrap_content + gravity=top) so it reads as one
               header with the search bar, empty space falling to the bottom.
             * home_onboard_card — the first-run "how capture works" card, shown
               only while every figure is still zero. It is height=match_parent
               so it FILLS the viewport (the parent NestedScrollView has
               fillViewport=true): in portrait it never scrolls (content + the
               weighted spacer inside fit the stretched height), and only when
               the viewport is short (landscape) does the content exceed it and
               the scroll view scroll. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">


            <!-- Unified hero card: the brand lockup IS the card header (logo +
                 wordmark), a hairline splits it from the live stats, and the
                 three columns (Trackers blocked → trackers info sheet, total
                 Saved → Downloads, Safe Folder count → vault) are divided by
                 thin rules. One cohesive surface instead of a floating logo
                 above a separate box. Each column owns a borderless ripple;
                 figures (home_*_value) bind in HomeFragment; labels reuse
                 existing strings (Blocked / Safe Folder). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/list_spacing"
                android:layout_marginEnd="@dimen/list_spacing"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header = brand lockup (small logo + wordmark), left-aligned. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="2dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_firedown_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="@string/app_name"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.01" />

                    </LinearLayout>

                    <!-- Stats row: three equal columns, thin rules between.
                         No horizontal divider above it — the header just sits
                         atop the stats; spacing carries the separation. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="32dp">

                    <!-- Trackers blocked → trackers info sheet -->
                    <LinearLayout
                        android:id="@+id/home_trackers_col"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_stat_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp">

<TextView
                            android:id="@+id/home_trackers_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="44K" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_shield_24"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/trackers_info_stat_blocked"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <!-- Live trend line: today's blocked count. Always shown
                             (bound in HomeFragment) — reads "0 today" on a quiet
                             day so the column never looks empty. -->
                        <TextView
                            android:id="@+id/home_trackers_trend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/brand_orange"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="+340 today" />

                    </LinearLayout>

<!-- Total saved → Downloads -->
                    <LinearLayout
                        android:id="@+id/home_downloads_col"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_stat_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp">

<TextView
                            android:id="@+id/home_downloads_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="9.2 GB" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/download_24"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/home_stat_saved"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <!-- Live trend line: files finished in the last 7 days.
                             Hidden at 0 (bound in HomeFragment). -->
                        <TextView
                            android:id="@+id/home_downloads_trend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/brand_orange"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="3 this week"
                            tools:visibility="visible" />

                    </LinearLayout>

<!-- Safe Folder item count → vault -->
                    <LinearLayout
                        android:id="@+id/home_safe_col"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_home_stat_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp">

<TextView
                            android:id="@+id/home_safe_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="12" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="@null"
                                app:srcCompat="@drawable/ic_lock_24"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/home_vault_button"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <!-- Item-count footer line: the headline above now shows
                             the vault's total SIZE (mirroring Saved), so this
                             carries the element count ("12 items"), bound in
                             HomeFragment. The lock icon + "Safe Folder" label
                             still convey that it's private. -->
                        <TextView
                            android:id="@+id/home_safe_trend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="@color/brand_orange"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="12 items" />

                    </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- First-run onboarding card (Direction A). Shown only while every
                 live figure is zero; see HomeFragment.updateHomeCard. Fills the
                 viewport (match_parent height) with a weighted spacer pushing
                 the CTA to the bottom, so it reads as a full-height welcome and
                 only scrolls when the viewport is too short (landscape). -->
            <!-- Borderless on purpose: the onboarding card FILLS the viewport, so
                 it IS the screen, not a card-in-a-page — an empty/first-run state
                 needs no frame to separate from a surrounding surface. Transparent
                 background + no stroke = the content sits directly on the home
                 surface (light cream / true-black), reading as the home screen
                 itself. Coral stays only on the step numbers + CTA accents, never
                 as a frame. (The stats card above keeps a NEUTRAL hairline because
                 it is a small discrete widget floating in empty space.) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_onboard_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/list_spacing"
                android:layout_marginEnd="@dimen/list_spacing"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <!-- Brand lockup -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_firedown_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="-0.01"
                            android:text="@string/app_name"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Headline + lede -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="1.05"
                        android:text="@string/home_onboard_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/home_onboard_lede"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <!-- Step 1 -->
                    <LinearLayout
                        style="@style/Firedown.Onboard.Step"
                        android:layout_marginTop="22dp">

                        <TextView
                            style="@style/Firedown.Onboard.StepNum"
                            android:text="@string/home_onboard_step_1_num" />

                        <LinearLayout style="@style/Firedown.Onboard.StepText">

                            <TextView
                                style="@style/Firedown.Onboard.StepTitle"
                                android:text="@string/home_onboard_step_1_title" />

                            <TextView
                                style="@style/Firedown.Onboard.StepDesc"
                                android:text="@string/home_onboard_step_1_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        style="@style/Firedown.Onboard.Step"
                        android:layout_marginTop="16dp">

                        <TextView
                            style="@style/Firedown.Onboard.StepNum"
                            android:text="@string/home_onboard_step_2_num" />

                        <LinearLayout style="@style/Firedown.Onboard.StepText">

                            <TextView
                                style="@style/Firedown.Onboard.StepTitle"
                                android:text="@string/home_onboard_step_2_title" />

                            <TextView
                                style="@style/Firedown.Onboard.StepDesc"
                                android:text="@string/home_onboard_step_2_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        style="@style/Firedown.Onboard.Step"
                        android:layout_marginTop="16dp">

                        <TextView
                            style="@style/Firedown.Onboard.StepNum"
                            android:text="@string/home_onboard_step_3_num" />

                        <LinearLayout style="@style/Firedown.Onboard.StepText">

                            <TextView
                                style="@style/Firedown.Onboard.StepTitle"
                                android:drawableEnd="@drawable/download_24"
                                android:drawablePadding="6dp"
                                android:text="@string/home_onboard_step_3_title"
                                app:drawableTint="@color/brand_orange" />

                            <TextView
                                style="@style/Firedown.Onboard.StepDesc"
                                android:text="@string/home_onboard_step_3_desc" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Weighted spacer: absorbs the slack when the card is
                         stretched to the viewport so the CTA sits at the bottom;
                         collapses to 0 when the viewport is too short to fit. -->
                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_weight="1" />

                    <!-- Primary CTA — focuses the URL bar (no new surface; same
                         as tapping the omnibox). Honors the "no paste-a-link
                         flow" invariant: it opens nothing, just lets the user
                         start browsing, where capture happens. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_onboard_cta"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/home_onboard_cta"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        app:backgroundTint="@color/brand_orange"
                        app:cornerRadius="26dp"
                        app:icon="@drawable/ic_search_24"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/home_onboard_hint"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar at the top covers search, so the
        centre slot is the bookmarks-list entry. (The former hero
        Bookmarks FAB was removed.)
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

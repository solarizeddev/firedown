<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="false">

        <com.solarized.firedown.geckoview.GeckoToolbar
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            app:enableHome="true" />

    </com.google.android.material.appbar.AppBarLayout>


    <!--
        MINIMAL home (a slick private browser; downloading is a quiet superpower,
        not a billboard). Top→bottom: the functional URL bar (GeckoToolbar, in the
        AppBarLayout above), then a brand block + a single live stat line
        (trackers blocked · total saved). There is deliberately NO downloads
        carousel, Safe Folder card, Trackers card, or Continue-browsing card here
        — the search bar is the home, tabs live behind the bottom-bar tab button,
        downloads behind the download button (badge), the Captured sheet fills as
        you browse, and the trackers stat is folded into the privacy line.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- The minimalist home is a single calm, centred brand mark — the flame
             logo + wordmark — and nothing else. No stats, shortcuts, recents, or
             active-download strip; tabs and the downloads badge live in the
             bottom bar, the vault in the menu. The FrameLayout (stretched to the
             viewport by the NestedScrollView's fillViewport) centres the mark via
             layout_gravity. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">


            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

<!-- 120dp host box: the flame src draws at 40dp (40dp padding, fitCenter)
                     while the bg_flame_glow radial fills the full box so the halo
                     bleeds ~40dp around the flame — wide and soft, not a tight
                     disc. Transparent on the light home; the wordmark's negative
                     top margin pulls it back up under the flame (the glow box
                     would otherwise add ~40dp). -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:padding="40dp"
                    android:background="@drawable/bg_flame_glow"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_firedown_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-26dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>



        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar at the top covers search, so the
        centre slot is the bookmarks-list entry. (The former hero
        Bookmarks FAB was removed.)
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

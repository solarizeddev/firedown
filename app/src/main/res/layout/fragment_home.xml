<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="false">

        <com.solarized.firedown.geckoview.GeckoToolbar
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            app:enableHome="true" />

    </com.google.android.material.appbar.AppBarLayout>


    <!--
        MINIMAL home (a slick private browser; downloading is a quiet superpower,
        not a billboard). Top→bottom: the functional URL bar (GeckoToolbar, in the
        AppBarLayout above), then a brand block + a single live stat line
        (trackers blocked · total saved). There is deliberately NO downloads
        carousel, Safe Folder card, Trackers card, or Continue-browsing card here
        — the search bar is the home, tabs live behind the bottom-bar tab button,
        downloads behind the download button (badge), the Captured sheet fills as
        you browse, and the trackers stat is folded into the privacy line.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- The minimalist home is a single calm, centred brand mark — the flame
             logo + wordmark — and nothing else. No stats, shortcuts, recents, or
             active-download strip; tabs and the downloads badge live in the
             bottom bar, the vault in the menu. The FrameLayout (stretched to the
             viewport by the NestedScrollView's fillViewport) centres the mark via
             layout_gravity. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">


            <!-- match_parent (centred by gravity, not width) so the subtitle
                 line below knows the real available width and can WRAP its
                 counters on narrow screens / large font scale instead of
                 clipping. -->
            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <!-- Flame + the breathing ember glow behind it. The wrapper is
                     sized to the 40dp flame (no layout change vs the bare
                     ImageView); the glow is also 40dp and only becomes a halo
                     via the animator's SCALE transform, drawn beyond the box
                     because this and the ancestors set clipChildren="false".
                     The glow is GONE/alpha 0 at rest — HomeFragment shows it
                     and runs the breath only while a download is active. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/home_brand_glow"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/home_ember_glow"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_firedown_logo" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- ONE quiet subtitle line: up to three independently-tappable
                     live counters in a single shared grammar (figure + short
                     predicate) — trackers blocked (→ trackers info sheet), total
                     downloaded (→ Downloads), and bytes backed up (→ the Backups
                     list). All three are lifetime FACTS; transient backup STATE
                     ("Backing up…", "Backup paused") lives in the pill below,
                     never here. Each counter hides at 0 (a fresh
                     install reads just the wordmark) and the middle dots show
                     only between visible neighbours — all bound in HomeFragment.
                     Deliberately ONE line, never a second row: two stacked grey
                     rows read as a dashboard, and a state-dependent extra row
                     shifted the flame's resting position. A ConstraintLayout
                     Flow (wrapMode=chain) hosts the segments so a narrow screen
                     / large font scale WRAPS into a second centred row instead
                     of the old LinearLayout's silent clipping; and each chip's
                     text is width-capped at runtime (HomeFragment) so even a
                     SINGLE over-wide translated segment wraps inside its chip
                     rather than clipping at the screen edge. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/home_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone">

                    <androidx.constraintlayout.helper.widget.Flow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="home_subtitle_blocked,home_subtitle_sep,home_subtitle_saved,home_subtitle_sep2,home_subtitle_backed"
                        app:flow_horizontalGap="0dp"
                        app:flow_horizontalStyle="packed"
                        app:flow_verticalGap="0dp"
                        app:flow_wrapMode="chain"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/home_subtitle_blocked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/transparent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/home_subtitle_blocked_text"
                            android:layout_width="wrap_content"
                            android:gravity="center_horizontal"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="10.5K blocked" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/home_subtitle_sep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="5dp"
                        android:text="·"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/home_subtitle_saved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/transparent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/home_subtitle_saved_text"
                            android:layout_width="wrap_content"
                            android:gravity="center_horizontal"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="9.5 GB saved" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/home_subtitle_sep2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="5dp"
                        android:text="·"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:ignore="HardcodedText" />

                    <!-- Cloud Backup's LIFETIME figure — the third counter the
                         comment above has always described. It belongs here and
                         not on the pill for the reason applyBackupPill states:
                         the pill is STATE (it appears, then resolves), the
                         subtitle is lifetime FACT. "9.5 GB saved" beside it is
                         exactly the same shape — a static byte total that also
                         duplicates a screen the bottom bar reaches — so this one
                         is consistent with the line, not an addition to it.

                         One thing it does NOT share with its two neighbours:
                         they read local LiveData (Room / uBlock) and are correct
                         instantly and offline, while this figure comes from a
                         network manifest pull. It is therefore bound
                         CACHED-FIRST (HomeFragment, via lastStatus) — a counter
                         that popped in a second after every resume, and vanished
                         whenever offline, would be worse than absent. -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/home_subtitle_backed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/transparent"
                        app:strokeWidth="0dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/home_subtitle_backed_text"
                            android:layout_width="wrap_content"
                            android:gravity="center_horizontal"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="2.3 GB backed up" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Cloud Backup activity pill (home v3): transient backup STATE
                     as a BUTTON under the hero stats — it reads as an action
                     (tap → the Backups list / status screen), so it belongs with
                     the stats cluster, not floating at the bottom (where the
                     bottom bar's gesture-nav inset swallowed it in portrait and
                     snackbars fight for the space). Shown ONLY while a backup
                     transfer runs ("Backing up… · VIEW") or when metered credit
                     ran out ("Backup paused · TOP UP"); GONE when idle. ONE tap
                     target.

                     The ground, ink, icon and action label are ALL set from
                     applyBackupPill — the attention state repaints the whole
                     pill, not just its ink (see the colour comments in
                     values/colors.xml). The cardBackgroundColor below is only
                     the resting value the code immediately overwrites, and the
                     action label's colour is set in code too, hence tools: on
                     it. That used to be a hardcoded ?attr/colorPrimary — coral
                     on the peach pill, 1.68:1 in light and 3.76:1 in dark, so
                     the one word telling you the pill is tappable was the least
                     readable thing on it. Bold + allCaps already say "action";
                     the colour was doing nothing but harm. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_backup_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:id="@+id/home_backup_pill_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cloud_upload_24"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/home_backup_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            tools:text="Backing up…" />

                        <TextView
                            android:id="@+id/home_backup_pill_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/cloud_backup_view"
                            android:textAllCaps="true"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Backup DEADLINE card. A different SILHOUETTE from the pill
                     above, on purpose: the pill reports ambient progress that
                     resolves itself, this reports a 30-day deadline that ends in
                     deleted files. Wide, two lines, a verb — the SHAPE is what
                     says "this one matters", not a colour. It carries no
                     semantic hue at all; see the note in values/colors.xml.

                     match_parent + address_bar_inset both sides, so the card
                     lines up with the address bar at the top of the screen
                     instead of sitting on its own arbitrary inset. The pill is
                     wrap_content and centred, so the two never share a width —
                     that difference is load-bearing, not incidental.

                     The detail line WRAPS to 2 lines (no singleLine): the
                     countdown is a full sentence and grows in translation, so it
                     must not ellipsize the deadline away. The action is
                     wrap_content beside a weighted text column, so a long
                     message shrinks the text rather than squeezing the verb out.
                     Only ONE of pill/card is ever VISIBLE. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_backup_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/address_bar_inset"
                    android:layout_marginEnd="@dimen/address_bar_inset"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:id="@+id/home_backup_card_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/cloud_off_24"
                            app:tint="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/home_backup_card_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Backup paused" />

                            <TextView
                                android:id="@+id/home_backup_card_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="2"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                tools:text="27 days left before your files are removed" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/home_backup_card_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_cloud_top_up"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>



        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar at the top covers search, so the
        centre slot is the bookmarks-list entry. (The former hero
        Bookmarks FAB was removed.)
    -->

    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

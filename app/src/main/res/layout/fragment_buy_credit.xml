<?xml version="1.0" encoding="utf-8"?>
<!--
  "Add storage credit" wizard. One scrolling page whose step containers are shown
  one at a time by BuyCreditFragment, driven by BuyCreditViewModel.UiState:
  loading → pick (denomination + rail) → pay (Lightning QR / Stripe Checkout tab)
  → success / error. Card path uses Stripe's HOSTED Checkout (opened in a browser
  tab) — no Stripe SDK.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- ── loading / starting ── -->
        <LinearLayout
            android:id="@+id/buy_step_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="320dp">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ── 1 · pick plan/denomination + rail ── -->
        <LinearLayout
            android:id="@+id/buy_step_pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Duration toggle section (plan-grid mode; hidden for a legacy flat
                 list or when only one duration is for sale). "Keep my backups for". -->
            <LinearLayout
                android:id="@+id/buy_duration_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buy_credit_plan_duration_label"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/buy_duration_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true" />

                <!-- The bulk discount lives ON the duration segments as a
                     per-button "−N%" badge (durationLabelWithBadge) — the old
                     selection-dependent savings text line that sat here needed
                     two rounds of fixes (vanishing on the best plan, layout
                     jumps) and was retired for the always-visible badge. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/buy_size_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_credit_pick_how_much"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="10dp" />

            <!-- Plain-language explainer for the "GB-months" unit (legacy flat
                 list only — the plan grid uses the soft-cap note instead). -->
            <TextView
                android:id="@+id/buy_gbm_explainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_credit_gb_month_explainer"
                android:textSize="11.5sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="12dp"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Plan (size) tiles OR legacy denomination cards inflated here. -->
            <LinearLayout
                android:id="@+id/buy_denom_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Soft-cap note (plan-grid mode only): the size is a cap, not a hard
                 rental — the ONE contextual note kept in the decision flow because
                 it explains "up to". The rest (one-time, privacy) is fine print
                 below Continue. -->
            <TextView
                android:id="@+id/buy_softcap_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_credit_soft_cap"
                android:textSize="11.5sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Point-of-purchase honesty line, shown when the account already
                 stores MORE than the selected tile's cap: the tile's duration
                 label is only true at/under the cap, so this states what the
                 credit really buys at the user's current footprint ("you store
                 200 GB — this lasts ≈ 3 months"). Amber = attention ink. GONE
                 for under-cap users (no dead space); INVISIBLE between
                 over-cap tiles so toggling doesn't jump the layout (the
                 save-nudge lesson). Bound by updateFootprintNote. -->
            <TextView
                android:id="@+id/buy_footprint_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="8dp"
                android:textColor="@color/backup_warning"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="You currently store 200 GB — at that size this credit lasts about 3 months." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_credit_pay_with"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/buy_rail_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <!-- Both segments carry their method's glyph (bolt / card),
                     SYMMETRICALLY — never just one, which unbalances the pair.
                     Icons tint with the text state list so they mute/darken with
                     selection like the label. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buy_rail_lightning"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/buy_credit_rail_lightning"
                    android:textColor="@color/buy_segment_text"
                    app:icon="@drawable/ic_lightning_24"
                    app:iconSize="17dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/buy_segment_text"
                    app:backgroundTint="@color/buy_segment_bg"
                    app:strokeColor="@color/buy_segment_stroke" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buy_rail_card"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/buy_segment_text"
                    app:icon="@drawable/ic_credit_card_24"
                    app:iconSize="17dp"
                    app:iconGravity="textStart"
                    app:iconTint="@color/buy_segment_text"
                    app:backgroundTint="@color/buy_segment_bg"
                    app:strokeColor="@color/buy_segment_stroke"
                    android:text="@string/buy_credit_rail_card" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buy_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:enabled="false"
                android:text="@string/buy_credit_continue_default"
                app:cornerRadius="14dp" />

            <!-- Fine print BELOW the CTA — reassurance stays available but out of
                 the decision path (Continue is the last thing above it). One-time
                 is plan-grid only; privacy shows in both modes. Centered + tiny. -->
            <TextView
                android:id="@+id/buy_oneoff_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/buy_credit_one_off"
                android:textSize="11sp"
                android:layout_marginTop="16dp"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_credit_privacy_note"
                android:textSize="11sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginTop="12dp"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- ── 2a · pay with Lightning ── -->
        <LinearLayout
            android:id="@+id/buy_step_lightning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/buy_ln_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="4dp"
                tools:text="$18.00 · 500 GB-months" />

            <ImageView
                android:id="@+id/buy_ln_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:background="@drawable/bg_lan_share_qr"
                android:contentDescription="@string/buy_credit_ln_qr_desc" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <ProgressBar
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buy_credit_waiting"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/buy_ln_invoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="12dp"
                android:maxLines="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:textSize="11.5sp"
                android:background="@drawable/bg_sync_code"
                android:textColor="?attr/colorOnSecondaryContainer"
                tools:text="lnbc183u1p4y2n4adpjge5hy…q9yysgqcqzp2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buy_ln_open_wallet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/buy_credit_open_wallet"
                    app:icon="@drawable/ic_wallet_24"
                    app:iconSize="16dp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buy_ln_copy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/buy_credit_copy_invoice"
                    app:icon="@drawable/ic_copy_24"
                    app:iconSize="16dp"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/buy_credit_ln_hint"
                android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>

        <!-- ── 2b · pay with card (Stripe hosted Checkout, EMBEDDED in-flow) ──
             The Checkout page loads in a WebView that fills the step (created
             PROGRAMMATICALLY into buy_stripe_web_container by BuyCreditFragment,
             never in XML — a device without a WebView provider, plausible on the
             de-Googled devices this browser targets, would otherwise crash the
             whole wizard at inflate; there it falls back to the old browser-tab
             flow and shows buy_stripe_hint). match_parent + the weight-1
             container so the ScrollView's fillViewport hands the step the whole
             viewport. -->
        <LinearLayout
            android:id="@+id/buy_step_stripe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/buy_stripe_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="4dp"
                tools:text="$18.00 · 500 GB-months" />

            <!-- Browser-tab fallback copy — GONE while the embedded Checkout
                 shows, VISIBLE only when no WebView is available. -->
            <TextView
                android:id="@+id/buy_stripe_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textSize="12.5sp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/buy_credit_stripe_hint"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/buy_stripe_web_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp" />

            <!-- Compact status strip under the Checkout: the poll spinner on the
                 left, the open-in-browser escape on the right (always available —
                 Stripe treats WebViews as second-class, so the user can bail to a
                 real tab at any point without losing the poll, which lives in the
                 ViewModel). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <ProgressBar
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/buy_credit_waiting"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buy_stripe_reopen"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buy_credit_reopen_checkout"
                    app:icon="@drawable/ic_open_in_new_24"
                    app:iconSize="16dp"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── 3 · success ── -->
        <LinearLayout
            android:id="@+id/buy_step_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:paddingTop="24dp"
            tools:visibility="gone">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_baseline_check_circle_24"
                app:tint="@color/brand_orange"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/buy_success_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="18dp"
                tools:text="500 GB-months added" />

            <TextView
                android:id="@+id/buy_success_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginTop="6dp"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Your balance is now 600 GB-months." />

            <!-- (No recovery-code card here: the account + saved key always exist
                 before this flow — the Cloud hub gates buying on a key and forces
                 the save step at creation, so nothing is minted at purchase.) -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buy_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/buy_credit_done"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buy_backup_more"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/buy_credit_backup_more"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- ── error ── -->
        <LinearLayout
            android:id="@+id/buy_step_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="320dp"
            android:visibility="gone"
            tools:visibility="gone">

            <!-- Friendly error illustration (ill_kid) for the "couldn't set up /
                 try again" state — no tint (full-colour), adjustViewBounds so the
                 PNG keeps its aspect ratio at the capped height. -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="140dp"
                android:adjustViewBounds="true"
                android:src="@drawable/ill_kid"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/buy_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.35"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="Couldn’t reach the payments server." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buy_error_retry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/buy_credit_retry"
                app:cornerRadius="14dp" />
        </LinearLayout>

    </FrameLayout>
</ScrollView>

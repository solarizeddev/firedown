<?xml version="1.0" encoding="utf-8"?>
<!--
  The trailing slot of an installed add-on whose update waits and has not
  been looked at: "Review", the Add-ons screen's one FILLED button
  (colorPrimary under colorOnPrimary #460005, 6.20:1 in both themes). Coral
  cannot carry a label as text on the light card (2.18:1), only as a fill.
-->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preference_action"
    style="@style/Widget.Material3.Button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:minHeight="36dp"
    android:paddingHorizontal="16dp"
    android:importantForAccessibility="no"
    android:text="@string/addons_review" />

<!--
    Empty-autocomplete clipboard card (Option A, content-forward). Shown
    under the address bar when the field is empty and the clipboard holds
    usable text. 16dp corners + colorSurfaceContainerHighest to match the
    suggestion container card directly below it.

    Leading icon sits in a 40dp rounded badge — the same badge treatment the
    most-visited strip tiles use (fragment_autocomplete_tile), so the empty-focus
    surface reads as one family. The icon (globe for a URL / search for plain
    text, set in AutoCompleteView.showClipboard) signals the ACTION; the "From
    clipboard" label + the primary-tinted forward arrow keep the chip recognisable.
    Tapping the card acts on the content; the clipboard itself is left intact.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/clipboard_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:id="@+id/clipboard_icon_chip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_incognito_chip"
            android:backgroundTint="?attr/colorSurfaceContainerHigh">

            <ImageView
                android:id="@+id/clipboard_image"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_globe_24"
                app:tint="?attr/colorOnSurfaceVariant" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clipboard_title"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/clipboard_from" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clipboard_subtitle"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <!--
            Plain image button mirroring the suggestion rows' trailing icon
            (wrap_content + 12dp padding, reaching the card edge) rather than a
            MaterialButton.IconOnly, which carried its own insets / min-width.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/clipboard_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_forward_24"
            android:tint="?attr/colorPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

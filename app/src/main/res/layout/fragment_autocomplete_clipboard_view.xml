<!--
    Empty-autocomplete clipboard card (Option A, content-forward). Shown
    under the address bar when the field is empty and the clipboard holds
    usable text. 16dp corners + colorSurfaceContainerHighest to match the
    suggestion container card directly below it.

    Layout intentionally lines up with the suggestion rows
    (fragment_autocomplete_item): a 24dp leading icon at a 12dp inset with a
    12dp text gap, so the clipboard icon sits in the SAME column as the list
    favicons and the whole stack reads as one list. The icon (globe for a URL
    / search for plain text, set in AutoCompleteView.showClipboard) signals the
    ACTION; the "From clipboard" label + the primary-tinted forward arrow keep
    the chip recognisable as the top action without breaking the column. Tapping
    the card acts on the content; the clipboard itself is left intact.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/clipboard_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/clipboard_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/ic_globe_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clipboard_title"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/clipboard_from" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clipboard_subtitle"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <!--
            Plain image button mirroring the suggestion rows' trailing icon
            (fragment_autocomplete_item: wrap_content + 12dp padding, no card
            inset) so the arrow lands in the SAME column as the list's clock /
            flame glyphs. A MaterialButton.IconOnly here carried its own insets /
            min-width and sat off that column.
        -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/clipboard_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_forward_24"
            android:tint="?attr/colorPrimary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

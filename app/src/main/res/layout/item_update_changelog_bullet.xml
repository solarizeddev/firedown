<?xml version="1.0" encoding="utf-8"?>
<!--
  One changelog bullet row for UpdateAvailableSheet. Inter-bullet spacing is a
  real view margin set in code (UpdateAvailableSheet.fillChangelog), NOT line
  spacing — the Material3 textAppearance imposes a fixed lineHeight via
  MaterialTextView that overrides lineSpacingExtra/Multiplier, so a row + margin
  is the only reliable way to space the items.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant"
    tools:text="• YouTube downloads now finish ready to play." />

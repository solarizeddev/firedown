<?xml version="1.0" encoding="utf-8"?>
<!-- One add-on's button in the Add-ons sheet: its icon, its title for this
     page (the add-on's name when it gives none), a subtitle when the button
     is off here or the add-on has none, and its badge. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Firedown.Widget.SheetRowCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/addon_action_icon"
            android:layout_width="@dimen/addon_icon_size"
            android:layout_height="@dimen/addon_icon_size"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/addon_action_title"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/addon_action_subtitle"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/addon_action_badge"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_addon_badge"
            android:minWidth="20dp"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="?attr/colorOnPrimary"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

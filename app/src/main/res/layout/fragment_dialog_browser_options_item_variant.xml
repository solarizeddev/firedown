<?xml version="1.0" encoding="utf-8"?>
<!-- One quality TILE in the variant picker's 3-column grid. A quality label
     is 4–6 characters; the old full-width radio row spent 54dp of height on
     it, which pushed captions and the Download button below the fold on any
     capture with a real ladder. The tile spends what the fact needs.
     Selection = fill-vs-outline via bg_picker_tile, keyed on ACTIVATED (the
     adapter's bindSelection calls setActivated — no radio; the tonal fill IS
     the selection affordance, the buy-segment convention). The meta line is
     the codec / "audio only" sub-label; the full description rides in the
     contentDescription the adapter sets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/file_variants_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/bg_picker_tile"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/stream_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/picker_tile_title"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="1080p" />

    <TextView
        android:id="@+id/stream_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/picker_tile_meta"
        android:textSize="10sp"
        tools:text="avc1 + mp4a" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  "Don't have bitcoin?" — the sheet behind the quiet link under the buy
  screen's rail picker. A title, ONE sentence (buy about $X in one of these
  wallets, then come back and pay), two wallets that SELL sats by card as
  plain rows with an Install button, and a one-line caveat. No illustration.
  Copy + store links only: no on-ramp partner, no API key, no merchant KYC
  on our side — the wallet's on-ramp identifies the buyer.
  Verify a wallet's buy feature before naming it (Phoenix was named once and
  has none).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <include layout="@layout/dialog_drag_handle" />

    <!-- NO illustration (maintainer call, after the kid shipped here for a
         day): the crying kid is the buy screen's "couldn't set up" face and
         read as "something went wrong" on a sheet where nothing has, and no
         other art in the set says wallet or money (the presents already mean
         Receive a file). A help sheet is title + sentence + rows, like every
         other option sheet; only a permission ask earns a picture. -->
    <TextView
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:text="@string/buy_bitcoin_sheet_title"
        android:textColor="?attr/colorOnSurface" />

    <!-- ONE sentence says the whole flow (buy about $X in one of these
         wallets, then come back and pay). It replaced a four-line intro and
         then a three-glyph install → buy → pay strip, both rejected
         on-device: under an illustration a second illustrated block read as
         a landing page rather than a help sheet. The fee, the "Open in wallet
         / scan the QR" detail and the seconds-to-credit reassurance are
         deliberately absent — the pay screen the user returns to shows all
         three. Carries the quoted amount (bound in the fragment). -->
    <TextView
        android:id="@+id/bb_lead"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:text="@string/buy_bitcoin_sheet_lead_noamount"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Wallet rows: PLAIN 56dp list rows (name + a two-word note, an
         outlined Install at the end, a hairline between them) — no card
         fill, no monogram. The two Install buttons are the sheet's only
         coral; tonal wallet cards were sketched and judged one object too
         many beside an illustration, and then the illustration went too. -->
    <LinearLayout
        android:id="@+id/bb_wallet_wos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_bitcoin_wallet_wos"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/buy_bitcoin_wallet_wos_note"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bb_install_wos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/buy_bitcoin_install" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/bb_wallet_strike"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buy_bitcoin_wallet_strike"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/buy_bitcoin_wallet_strike_note"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bb_install_strike"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/buy_bitcoin_install" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:text="@string/buy_bitcoin_sheet_caveat"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>

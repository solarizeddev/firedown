<?xml version="1.0" encoding="utf-8"?>
<!--
  One category row for the TrackersInfoSheet's "Tracking protection"
  section (the Gecko ETP database breakdown). Inflated once per
  non-zero category by TrackersInfoSheet.bindTrackingDbSection — the
  ETP category set is data-driven (only buckets with a count show),
  so these rows can't be static in the sheet layout the way the
  uBlock "Blocked by type" rows are.

  Mirrors the uBlock breakdown row exactly (same three styles) so the
  two breakdowns read as parallel: label hugs the start, count hugs
  the end with tabular numerals so digit columns align across rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TrackersInfoBreakdownRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/etp_row_label"
        style="@style/TrackersInfoBreakdownLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="Fingerprinters" />

    <TextView
        android:id="@+id/etp_row_count"
        style="@style/TrackersInfoBreakdownCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="1,204" />
</LinearLayout>

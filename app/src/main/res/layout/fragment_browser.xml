<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.solarized.firedown.geckoview.NestedGeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout>


    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/toolbar_layout"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:visibility="gone"/>

    <View
        android:id="@+id/anchor_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/transparent"
        android:layout_gravity="bottom"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.AnchorBehavior"/>



    <!--
        wrap_content, NOT a fixed app_bar_size: edge-to-edge, the bar
        self-pads by the nav inset (BottomNavigationBar.applyWindowInsets)
        so its background owns the system-nav strip — a fixed height would
        squash the icon row by the inset instead of growing the bar. The
        root insets listener (BrowserFragment.onViewCreated) deliberately
        returns the insets unconsumed so this self-padding receives them.
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/app_bar_size"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurfaceContainer"
        app:hideMiddleSlot="true"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.BottomNavigationBehavior"/>


    <!--
        No layout_anchor: edge-to-edge moved the bar's bottom edge to the
        TRUE window bottom, so the old bottom|center anchor parked the FAB
        half under the system nav. Rest position is owned by LAYOUT — the
        Home/Tabs recipe: bottom gravity + a code-set bottomMargin of
        (nav inset + app_bar_fab_margin), wired in BrowserFragment beside
        the FAB binding. BottomNavigationFABBehavior stays, demoted to a
        pure follower: it only mirrors the bar's scroll-hide translation
        and snaps fully clear, never computing the rest position.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/download_button"
        style="@style/Widget.Material3.FloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/download"
        android:elevation="0dp"
        app:elevation="0dp"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.BottomNavigationFABBehavior"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:maxImageSize="@dimen/phone_icon_height"
        app:srcCompat="@drawable/ic_firedown" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>

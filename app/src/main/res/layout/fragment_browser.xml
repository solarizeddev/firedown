<?xml version="1.0" encoding="utf-8"?>
<!--
    FRAMED chrome (Fenix-style), not immersive-under-bars. The root pads
    itself on ALL FOUR sides by the system-bar insets (BrowserFragment's
    root insets listener), so every child — toolbar, engine, bottom bar,
    FAB — lives strictly INSIDE the safe area. The status/nav strips are
    this view's own background showing through that padding (painted the
    chrome tone in resetWindowTheme / applyIncognitoTheme), i.e. an opaque
    frame. clipToPadding stays at its default TRUE: a bar scroll-hiding
    translates up/down INTO the padding region and is clipped clean at the
    frame edge — it never draws over the status icons. This retires the
    dead-zone the old self-padded toolbar had (it travelled height+inset
    while the viewport only reclaimed height, so the bars never fully hid
    on a normal scroll); now the bars are a true app_bar_size tall, which
    MATCHES the content-only heights NestedGeckoViewBehavior already uses,
    so bar travel == reclaimed viewport and the bars hide on a short flick.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.solarized.firedown.geckoview.NestedGeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout>


    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/toolbar_layout"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:visibility="gone"/>

    <View
        android:id="@+id/anchor_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/transparent"
        android:layout_gravity="bottom"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.AnchorBehavior"/>



    <!--
        wrap_content + minHeight app_bar_size: in the FRAMED model the bar
        no longer self-pads the nav inset (the root padding reserves the
        nav strip), so it is a plain app_bar_size-tall bar sitting just
        above the nav frame. It scroll-hides DOWNWARD and clipToPadding
        clips it at the content-area bottom edge.
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/app_bar_size"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        app:hideMiddleSlot="true"
        app:selfPadSystemBars="false"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.BottomNavigationBehavior"/>


    <!--
        No layout_anchor. In the FRAMED model the FAB is a child of the
        safe-area-padded root, so its rest position is just a bottom
        gravity + app_bar_fab_margin bottomMargin (16dp above the nav
        frame) — the nav inset is already reserved by the root padding.
        BottomNavigationFABBehavior is a pure follower: it mirrors the
        bar's scroll-hide translation 1:1 and clipToPadding clips it at
        the content-area bottom edge as it goes.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/download_button"
        style="@style/Widget.Material3.FloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@string/download"
        android:elevation="0dp"
        app:elevation="0dp"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.BottomNavigationFABBehavior"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:maxImageSize="@dimen/phone_icon_height"
        app:srcCompat="@drawable/ic_firedown" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>

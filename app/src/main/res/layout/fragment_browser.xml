<?xml version="1.0" encoding="utf-8"?>
<!--
    clipToPadding=false is for browser_nav_backdrop below: the root is
    padded by ALL insets (BrowserFragment.onViewCreated), so children
    are laid out above the system-nav strip — the backdrop walks back
    down over it with a negative bottom margin and must not be clipped
    at the padding edge.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.solarized.firedown.geckoview.NestedGeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.solarized.firedown.geckoview.GeckoSwipeRefreshLayout>


    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/toolbar_layout"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:visibility="gone"/>

    <View
        android:id="@+id/anchor_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/transparent"
        android:layout_gravity="bottom"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.AnchorBehavior"/>



    <!--
        System-nav backdrop. The browser cannot use the navigation_scrim
        pattern (the inset-padded root keeps every child above the nav
        strip), and window.setNavigationBarColor is ignored on Android
        15+ at targetSdk 35+, so this view paints the strip instead:
        height and a NEGATIVE bottomMargin (escaping the root padding —
        see the clipToPadding note on the root) are set from the insets
        listener in BrowserFragment.onViewCreated; the tone follows the
        bottom bar's surfaceContainer from the theme sites. Sits before
        the bar so bar + FAB draw above it.
    -->
    <View
        android:id="@+id/browser_nav_backdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_size"
        android:minHeight="@dimen/app_bar_size"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground"
        app:hideMiddleSlot="true"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.BottomNavigationBehavior"/>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/download_button"
        style="@style/Widget.Material3.FloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/download"
        android:elevation="0dp"
        app:elevation="0dp"
        app:layout_behavior="com.solarized.firedown.geckoview.toolbar.BottomNavigationFABBehavior"
        app:layout_anchorGravity="bottom|center"
        app:layout_anchor="@id/bottom_app_bar"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:maxImageSize="@dimen/phone_icon_height"
        app:srcCompat="@drawable/ic_firedown" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>

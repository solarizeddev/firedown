<?xml version="1.0" encoding="utf-8"?>
<!-- "Send directly" — P2P share sender (P2pSendFragment). A window onto the
     controller's session, repainted from each ShareState snapshot: the
     screen can be left mid-share (P2pShareService carries it) and reopened
     from the notification onto the same picture.

     The file card is always there; it also carries the transfer (bar and
     numbers under the name) and the outcome (the check). Below it ONE
     "Send to" list (rows built by P2pSendRows): phones nearby, "Share a
     link", "Show a QR code" (unfolds in place). What happened after a tap is
     that row's second line, never another card. Preparing (a spinner) and
     error are the only other stages. The reply fallbacks live in the
     toolbar's overflow. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/p2p_send_scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.FireDown.Toolbar"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/p2p_send_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/p2p_send_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- The file: thumbnail, name, mime · size. While bytes move
                     the bar and numbers sit under it; DONE puts the check at
                     its end and "Sent · size" in its tag line. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_p2p_filecard"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/p2p_thumb"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedThumbnail" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/p2p_file_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Robot head buddy.mp4" />

                            <TextView
                                android:id="@+id/p2p_file_tag"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="2"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Video · 48.2 MB" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/p2p_done_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_baseline_check_circle_24"
                            android:visibility="gone"
                            app:tint="?attr/brandInk"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <!-- Transfer: bar + "x of y · rate" + the reconnecting
                         blip (base bindProgress fills these ids). -->
                    <LinearLayout
                        android:id="@+id/p2p_progress_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/p2p_progress_bar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/p2p_progress_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="133 MB of 214 MB · 8.4 MB/s" />

                        <LinearLayout
                            android:id="@+id/p2p_reconnecting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="true"
                                app:indicatorSize="16dp"
                                app:trackThickness="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/p2p_reconnecting"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- PREPARING: the offer is being minted (a few seconds). -->
                <LinearLayout
                    android:id="@+id/p2p_status_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="28dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorSize="40dp"
                        app:trackThickness="3dp" />

                    <TextView
                        android:id="@+id/p2p_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:text="@string/p2p_preparing"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- READY / CONNECTING: the "Send to" list. Cards are inflated
                     from item_p2p_device.xml; the QR unfolds inside the QR
                     card. -->
                <LinearLayout
                    android:id="@+id/p2p_ready_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="8dp"
                        android:text="@string/p2p_send_to"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Nobody found yet: a still line, not a card. Every card
                         in the group below can be tapped. -->
                    <LinearLayout
                        android:id="@+id/p2p_nearby_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="1dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/p2p_nearby_none"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/p2p_nearby_none_hint"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- The group of grouped cards (item_p2p_device), corners
                         from SheetGroups.applyCorners. -->
                    <LinearLayout
                        android:id="@+id/p2p_dest_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:orientation="vertical" />

                    <!-- The QR, moved into the QR card's p2p_device_extra by the
                         fragment while that card is unfolded. -->
                    <LinearLayout
                        android:id="@+id/p2p_qr_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/p2p_qr"
                            android:layout_width="232dp"
                            android:layout_height="232dp"
                            android:background="@drawable/bg_p2p_qr"
                            android:contentDescription="@string/p2p_qr_content_desc"
                            android:padding="12dp" />

                        <TextView
                            android:id="@+id/p2p_qr_too_big"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="@string/p2p_qr_too_big"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Something went out and waits for an accept. -->
                    <TextView
                        android:id="@+id/p2p_waiting_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="14dp"
                        android:text="@string/p2p_waiting_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

                <!-- TRANSFERRING: the service carries it; say so where the user
                     decides whether to wait. -->
                <TextView
                    android:id="@+id/p2p_background_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="14dp"
                    android:text="@string/p2p_background_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- ERROR: the honest sentence + Try again. -->
                <LinearLayout
                    android:id="@+id/p2p_error_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/p2p_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="32dp"
                        android:paddingTop="16dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        tools:text="@string/p2p_error_no_path" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/p2p_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/p2p_try_again" />

                </LinearLayout>

                <!-- "Cancel" once something went out (confirmed mid-transfer);
                     "Done" on the outcome; absent at rest, where nothing is out
                     and Back is enough. Back and up merely LEAVE — the service
                     keeps a running share — so this is the one way to end it
                     from the screen. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/p2p_stop"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="@string/cancel"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/p2p_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:text="@string/p2p_footer_connecting"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

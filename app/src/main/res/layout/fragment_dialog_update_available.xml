<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app "update available" sheet (UpdateAvailableSheet). Shown on resume when a
  SHA+signature verified update APK is ready to install — also the surface for
  when POST_NOTIFICATIONS is denied. Centred header (illustration + "Update
  available" + the NEW version, prominent + the current version), then a left-
  aligned "What's new" + changelog block (hidden when status.json has no
  changelog), then a single centred Install. Dismiss = swipe / back / outside.

  INSTALL IS PINNED, ONLY THE CHANGELOG SCROLLS — do not move the button back
  inside the NestedScrollView. It used to live at the bottom of the scrolled
  content, so a release with a normal-length changelog pushed it below the fold
  and the sheet opened showing no action at all: the user had to scroll a wall
  of release notes to discover there was an Install button (reported on-device
  with a 5-bullet changelog). The action a sheet exists for cannot be the thing
  you have to go looking for.

  The recipe is the standard fixed-footer one and depends on BOTH attributes on
  the scroll view: layout_height="wrap_content" AND layout_weight="1". With
  wrap_content the LinearLayout measures the content first, so SHORT content
  still produces a compact sheet with no empty gap (delta is 0, nothing
  stretches); when the content exceeds the sheet's max height the delta goes
  negative and the weight shrinks the scroll view alone, leaving the footer at
  full height. Using layout_height="0dp" instead would always claim the whole
  sheet and stretch a two-line changelog to full screen.

  The base (BaseBottomSheetDialogFragment) expands the sheet and uncaps its
  height in landscape (values-land bottom_sheet_max_height = 0 → NO_MAX_SIZE).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/update_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ill_small_install" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:text="@string/update_available_sheet_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <!-- The version being installed — prominent. -->
            <TextView
                android:id="@+id/update_sheet_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="Firedown 1.1.90" />

            <TextView
                android:id="@+id/update_sheet_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Current version 1.1.81" />

            <!-- "What's new" + release notes. Both hidden when there's no changelog. -->
            <TextView
                android:id="@+id/update_sheet_whats_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:gravity="start"
                android:text="@string/update_available_sheet_whats_new"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Bullets are added as rows (item_update_changelog_bullet) with a
                 real margin between them — line spacing can't be used because the
                 Material3 textAppearance's lineHeight overrides it. -->
            <LinearLayout
                android:id="@+id/update_sheet_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
      Pinned footer: outside the scroll view on purpose (see the header), and
      TWO stacked full-width actions — filled Install over a quiet text Later.

      The second button is the point. A sheet that opens by itself on resume
      needs a visible way OUT: dismissing was already possible (swipe / back /
      tap-outside, all recorded against this version by onDismiss) but nothing
      on screen said so, which reads as "you must install now". Naming the exit
      costs one row and makes the modal honest. Mercurygram's updater lands on
      the same two-cell shape (filled "Download Now" over borderless "Remind me
      later"); ours keeps swipe-to-dismiss working, where theirs disables it and
      routes back through the same handler.

      Later's ink is colorOnSurfaceVariant, NOT the TextButton default: that
      default is colorPrimary, and the brand coral measures 2.56:1 on the light
      surface — under the 4.5:1 text floor, legible at night and washed out by
      day (the same defect class as the old home pill's "VIEW" label). One coral
      element per surface, and here it is the filled Install.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_sheet_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_available_sheet_install" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_sheet_later"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/update_available_sheet_later"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app "Update ready" sheet (UpdateAvailableSheet): a SHA+signature verified
  update APK is ready to install — also the surface for when
  POST_NOTIFICATIONS is denied. Centred header (a small illustration, "Update
  ready", the new version, the current one), then "What's new" and the notes
  (hidden when status.json has none), then the pinned footer: what installing
  would stop (only when opened on purpose while something runs), that
  Firedown closes while it installs, and Not now + Install.

  INSTALL IS PINNED, ONLY THE CHANGELOG SCROLLS — do not move the button back
  inside the NestedScrollView. It used to live at the bottom of the scrolled
  content, so a release with a normal-length changelog pushed it below the fold
  and the sheet opened showing no action at all: the user had to scroll a wall
  of release notes to discover there was an Install button (reported on-device
  with a 5-bullet changelog). The action a sheet exists for cannot be the thing
  you have to go looking for.

  The recipe is the standard fixed-footer one and depends on BOTH attributes on
  the scroll view: layout_height="wrap_content" AND layout_weight="1". With
  wrap_content the LinearLayout measures the content first, so SHORT content
  still produces a compact sheet with no empty gap (delta is 0, nothing
  stretches); when the content exceeds the sheet's max height the delta goes
  negative and the weight shrinks the scroll view alone, leaving the footer at
  full height. Using layout_height="0dp" instead would always claim the whole
  sheet and stretch a two-line changelog to full screen.

  The base (BaseBottomSheetDialogFragment) expands the sheet and uncaps its
  height in landscape (values-land bottom_sheet_max_height = 0 → NO_MAX_SIZE).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/update_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <!-- The fade at the bottom edge says the notes go on: the scrollbar
         is hidden at rest, and a line cut in half was the only other sign. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 72dp: at 132 the picture took a third of the sheet and
                 pushed the notes under the fold. -->
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ill_small_install" />

            <!-- "Update ready", or "Downloading update" in the download face
                 (UpdateAvailableSheet.bindDownloadingFace). -->
            <TextView
                android:id="@+id/update_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:text="@string/update_ready_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <!-- The version being installed. Dark ink in light theme (the
                 brand coral is 2.2:1 on this sheet), coral in dark. -->
            <TextView
                android:id="@+id/update_sheet_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/update_version_ink"
                tools:text="Firedown 1.1.90" />

            <TextView
                android:id="@+id/update_sheet_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Current version 1.1.81" />

            <!-- "What's new" + release notes. Both hidden when there's no changelog. -->
            <TextView
                android:id="@+id/update_sheet_whats_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:gravity="start"
                android:text="@string/update_available_sheet_whats_new"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Bullets are added as rows (item_update_changelog_bullet) with a
                 real margin between them — line spacing can't be used because the
                 Material3 textAppearance's lineHeight overrides it. -->
            <LinearLayout
                android:id="@+id/update_sheet_changelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
      Pinned footer: outside the scroll view on purpose (see the header).

      Not now + Install, the shape the donation and notification sheets
      have. A full-width "Later" under Install was removed once (a misclick
      trap, and it only repeated what a swipe does); a TEXT button beside a
      filled one is the normal Material pair and is not that trap. It does
      what a swipe does — onDismiss snoozes for a day — and says so, and a
      dismissed update now has somewhere to be found again: the ⋮ menu's
      "Update ready" row.

      After Install the footer shows the install instead of the buttons
      (UpdateAvailableSheet.render): "Preparing update… 42%" over a bar while
      the APK is copied into Android's installer, then "Installing…" with an
      indeterminate bar until Android answers, and the sheet closes. Only
      the button row (48dp) swaps with the progress (48dp), so the sheet
      doesn't jump. A failure brings the buttons back with the error line
      above them.

      Opened from About's check while the update still downloads, the same
      footer shows the download ABOVE the buttons (a 12dp gap set in code),
      "Not now" reads "Hide" and Install waits, disabled, until the update
      has been checked; then the sheet becomes the ready face in place.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/update_sheet_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/update_install_failed"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- What installing would stop. Only when the sheet was opened on
             purpose while something runs; it never opens by itself then. -->
        <TextView
            android:id="@+id/update_sheet_busy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="@string/update_busy_download"
            tools:visibility="visible" />

        <!-- Installing closes Firedown: on Android 12 and newer at once,
             with no question from Android. Firedown does not reopen by
             itself; a "Firedown updated" notification follows. Stays during
             the install too, which is when it happens. Outside the buttons,
             so only the 48dp button row swaps with the 48dp progress. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/update_sheet_closes_note"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/update_sheet_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/update_sheet_progress_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update_install_preparing"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/update_sheet_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="42%" />

            </LinearLayout>

            <!-- progress_indicator, never colorPrimary: the brand coral can't
                 separate from its own track in light theme (CLAUDE.md). The
                 track is colorPrimary at 20%, set in code like the Downloads
                 row's. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/update_sheet_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="100"
                app:indicatorColor="@color/progress_indicator"
                app:indicatorTrackGapSize="0dp"
                app:trackCornerRadius="50%"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="5dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/update_sheet_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_sheet_not_now"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/translate_not_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/update_sheet_install"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/update_available_sheet_install" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

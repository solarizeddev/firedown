<?xml version="1.0" encoding="utf-8"?>
<!--
  The Safe Folder ROW at the top of DownloadFragment's RecyclerView, shown via
  SafeFolderHeaderAdapter as a ConcatAdapter header (position 0, above the
  cloud banner). The vault's door lives in the CONTENT, not the toolbar — see
  the adapter's doc for why (the big-player shape; a fourth toolbar glyph was
  too crowded on-device).

  Lock icon + trailing chevron: the card taps into the Vault, so the lock maps
  to the destination and the chevron marks it as forward navigation rather
  than a passive info row. At rest the row is the bare title; the subtitle
  ("N incognito downloads in progress") appears from CODE only while vault
  downloads are in flight (this row absorbed the former incognito-in-progress
  card). The ground is set from code too — rest = colorSurfaceContainerHigh,
  live = the SelectionStyling brand wash — so the value below is a fallback.

  NO layout_marginHorizontal: as a 1-span ConcatAdapter header it already
  gets EqualSpacingItemDecoration's 8dp left/right gutter — the same gutter
  every (margin-less) list-row card gets, so the card edge sits flush with
  the item borders at 8dp. Adding a marginHorizontal would double it to 16dp
  and float the card inside the rows; the decoration is the single source of
  truth for horizontal spacing (see its own comment). Vertical margins are
  SYMMETRIC (list_spacing both sides) like item_sync_banner — the old
  incognito card tucked the first row up with a -12dp bottom margin, which
  read cramped under a PERMANENT row sitting above a section header.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/list_spacing"
    android:layout_marginBottom="@dimen/list_spacing"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/safe_folder_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_24"
            app:tint="?attr/colorOnSurface"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Title + the LIVE-only subtitle in one centred column: at rest the
             subtitle is GONE and the row is the bare "Safe Folder" (Files by
             Google shows no subtitle either — a reassurance sentence under a
             door read as nagging); in flight the column grows by one line. -->
        <LinearLayout
            android:id="@+id/safe_folder_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/safe_folder_icon"
            app:layout_constraintEnd_toStartOf="@id/safe_folder_chevron"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/safe_folder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/navigation_vault"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/safe_folder_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.8"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Trailing chevron — signals the whole card navigates forward
             (into the Vault). Decorative; the card itself carries the click. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/safe_folder_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

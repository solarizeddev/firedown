<?xml version="1.0" encoding="utf-8"?>
<!--
    Header row of the autocomplete list ("search for <query>"). The magnifier
    sits in the same 40dp icon SLOT at a 14dp inset as the data rows below it
    (fragment_autocomplete_item / _most_visited_item), so its glyph and the
    header text share the list's icon + title columns. Flat row — the wrapping
    search_card supplies the rounded surface; ripple via selectableItemBackground.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_search"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_autocomplete_search_height"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_search_24"
            android:tint="?attr/colorOnSurfaceVariant" />

    </FrameLayout>

    <TextView
        android:id="@+id/text"
        style="?attr/textAppearanceTitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/search_clip"
        android:textSize="16sp" />

</LinearLayout>

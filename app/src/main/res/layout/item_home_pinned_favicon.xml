<?xml version="1.0" encoding="utf-8"?>
<!--
  Single tile inside the home pinned-bookmarks strip. Vertical
  stack: circular favicon container on top, small site label
  below. Matches the NTP-shortcut pattern (Chrome / Firefox /
  Edge) — favicon for visual recognition, title underneath for
  the sites whose favicon alone isn't identifying enough.

  Tile is 72dp wide so 4-5 fit across a typical phone width; the
  RecyclerView scrolls horizontally past that. The whole tile is
  the click / long-click surface; ripple is borderless so it
  sweeps the whole tile rather than just the favicon container.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pinned_favicon_tile"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/pinned_favicon_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/pinned_favicon_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="youtube" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Single tile inside the home pinned-bookmarks strip. Wraps the
  raw favicon in a circular tonal background so heterogeneous
  source favicons (square logos, transparent PNGs, brand glyphs,
  pixel-art icons) read as a uniform row. The favicon itself
  renders centred at ~50% of the tile size so it floats inside
  the circle rather than touching the edge.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pinned_favicon_tile"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_marginHorizontal="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pinned_favicon_image"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

</com.google.android.material.card.MaterialCardView>

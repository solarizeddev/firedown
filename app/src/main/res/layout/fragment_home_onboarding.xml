<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/list_spacing"
    android:layout_marginEnd="@dimen/list_spacing"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="8dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item_onboarding_frame"
        android:padding="@dimen/list_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--
            Launchpad, not a manual: instead of explaining the Fire-Button,
            the card offers a few sites to try. Tapping a chip opens that
            site so the user discovers the button by using it. The card
            auto-retires after the first finished download (HomeFragment).
        -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/onboarding_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            app:tint="?attr/colorOnPrimaryContainer"
            app:srcCompat="@drawable/auto_awesome_24"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/onboarding_label" />

        <TextView
            android:id="@+id/onboarding_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/home_onboarding_sites_label"
            app:layout_constraintBottom_toBottomOf="@id/onboarding_remove"
            app:layout_constraintEnd_toStartOf="@id/onboarding_remove"
            app:layout_constraintStart_toEndOf="@id/onboarding_icon"
            app:layout_constraintTop_toTopOf="@id/onboarding_remove" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/onboarding_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/button_icons_padding"
            android:contentDescription="@string/cancel"
            app:tint="?attr/colorOnPrimaryContainer"
            android:src="@drawable/ic_clear_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <HorizontalScrollView
            android:id="@+id/onboarding_sites_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/onboarding_remove">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_youtube"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurface"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reddit"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reddit"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurface"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_instagram"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurface"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tiktok"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TikTok"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurface"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_x"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurface"
                    app:chipStrokeWidth="0dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/list_spacing"
    android:layout_marginEnd="@dimen/list_spacing"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <!--
        Launchpad, not a manual: instead of explaining the Fire-Button, the
        card offers a few sites to try. Tapping a chip opens that site so the
        user discovers the button by using it. Shares the surface-container
        shape of the Downloads / Vault / Trackers cards so it reads as part
        of the same shelf. Auto-retires after the first finished download
        (HomeFragment).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_container_secondary">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/onboarding_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/auto_awesome_24"
                    app:tint="?attr/colorOnSecondaryContainer" />

            </FrameLayout>

            <TextView
                android:id="@+id/onboarding_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_onboarding_sites_label"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/onboarding_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:padding="@dimen/button_icons_padding"
                android:src="@drawable/ic_clear_24"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/onboarding_sites_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_youtube"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_reddit"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reddit"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_instagram"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instagram"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tiktok"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TikTok"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_x"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X"
                    android:textColor="?attr/colorOnSurface"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

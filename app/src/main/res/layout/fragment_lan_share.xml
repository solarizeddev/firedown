<?xml version="1.0" encoding="utf-8"?>
<!-- "Send to browser" — full share screen (LanShareFragment, a downloads
     nav-graph destination like FrameGrabber/GifMaker). The LanShareServer's
     lifetime is this screen's lifetime — leaving it stops sharing.

     Composition (the redesign): a shared-file card (real Glide thumbnail +
     live dot), the QR on a surface card with the URL as a tap-to-copy pill
     INSIDE it (same credential, one container), the PIN as digit tiles
     (built programmatically into lan_share_pin_row), pill buttons. Two
     modes: with a usable LAN the share content shows immediately; with none
     (cellular-only) the direct-connection intro card shows instead, and
     accepting it raises a LocalOnlyHotspot — step 1 reuses the SAME content
     views (URL pill = hotspot name, tile row = passphrase, QR = Wi-Fi join
     code, plus the step chip) and Next flips them to the normal URL/PIN/QR. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/lan_share_scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.FireDown.Toolbar"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/lan_share_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Lift-on-scroll needs NESTED scroll events, so this is a
         NestedScrollView (a plain ScrollView never lifts the bar). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/lan_share_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/lan_share_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:text="@string/lan_share_lead"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Sender-side VPN heads-up (receiver-side VPN is undetectable) -->
            <TextView
                android:id="@+id/lan_share_vpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"
                android:text="@string/lan_share_vpn_warning"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Shared file: real thumbnail + name + mime/size + live dot -->
            <LinearLayout
                android:id="@+id/lan_share_file_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_lan_share_filecard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/lan_share_thumb"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedThumbnail" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lan_share_file_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Robot head buddy.mp4" />

                    <TextView
                        android:id="@+id/lan_share_file_tag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="VIDEO · 48.2 MB" />

                </LinearLayout>

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_lan_share_dot" />

            </LinearLayout>

            <!-- No-LAN case: the hotspot direct-connection offer card -->
            <LinearLayout
                android:id="@+id/lan_direct_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_lan_share_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_send_lan_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/lan_direct_intro"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lan_direct_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/lan_direct_start" />

            </LinearLayout>

            <!-- Share content: normal mode immediately, or hotspot step 1/2 -->
            <LinearLayout
                android:id="@+id/lan_share_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hotspot step 1 -> 2 progress chip -->
                <TextView
                    android:id="@+id/lan_share_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_lan_share_step"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/lan_direct_step"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- QR stage: code + the URL pill (tap to copy) in one card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_lan_share_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/lan_share_qr"
                        android:layout_width="232dp"
                        android:layout_height="232dp"
                        android:background="@drawable/bg_lan_share_qr"
                        android:contentDescription="@string/lan_share_qr_hint"
                        android:padding="12dp" />

                    <LinearLayout
                        android:id="@+id/lan_share_url_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_lan_share_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="9dp">

                        <TextView
                            android:id="@+id/lan_share_url"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            tools:text="192.168.1.57:53317" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="10dp"
                            android:contentDescription="@string/clipboard"
                            android:src="@drawable/ic_copy_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/lan_share_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="32dp"
                    android:paddingTop="12dp"
                    android:text="@string/lan_share_qr_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Self-signed TLS: the receiver's browser warns once; the
                     served http onboarding page walks them through it, this
                     line primes the SENDER too. Hidden in the plain-HTTP
                     fallback and the hotspot join step. -->
                <TextView
                    android:id="@+id/lan_share_cert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:gravity="center"
                    android:paddingHorizontal="32dp"
                    android:paddingTop="6dp"
                    android:text="@string/lan_share_cert_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/lan_share_pin_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:paddingTop="16dp"
                    android:text="@string/lan_share_pin"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- PIN digit tiles / hotspot passphrase tile, built in code -->
                <LinearLayout
                    android:id="@+id/lan_share_pin_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lan_share_stop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lan_share_stop" />

                <!-- Hotspot step 1 -> 2 (receiver joined, show the URL/PIN) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/lan_share_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/lan_direct_next"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- AP-isolation escape: shown in LAN mode only. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lan_share_use_direct"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/lan_direct_switch"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Pinned footer bar: tonal surface so it reads as a fixed bar over
         the scrolling content, not a floating caption. -->
    <TextView
        android:id="@+id/lan_share_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:text="@string/lan_share_footer"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/incognito_surface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/incognito_surface"
        app:liftOnScroll="false">

        <com.solarized.firedown.geckoview.GeckoToolbar
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            app:enableHome="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content area. The bottom margin reserves the bottom-nav's
         height so the disclaimer never hides behind it in landscape, and
         remains scrollable into view — mirrors HomeFragment. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <!-- The incognito home mirrors the regular home's single calm, centred
             brand mark — the incognito mask + "Private Browsing" wordmark —
             with the one addition private mode genuinely needs: a faint,
             bottom-anchored disclaimer that private browsing isn't anonymity.
             No fact chips, shortcuts, or stats (the regular home's live stats
             would themselves leak activity, so incognito stays bare). The
             FrameLayout (stretched to the viewport by fillViewport) centres
             the mark via layout_gravity and pins the disclaimer to the
             bottom. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <!-- The "privacy bandit" illustration (already drawn in the
                     incognito purple/coral palette) is the mark here, in place
                     of the regular home's small flame icon — richer and clearly
                     private-mode, no recolouring needed. adjustViewBounds keeps
                     its 6:5 aspect at a fixed width. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="168dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/incognito_home_title"
                    android:src="@drawable/ill_privacy_purple" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/incognito_home_title"
                    android:textColor="@color/incognito_on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- The one concession incognito carries that the regular home
                 doesn't: a faint privacy disclaimer pinned to the bottom, so
                 the mode never over-promises anonymity. Reuses the existing
                 (already-translated) warning string. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:alpha="0.75"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:paddingHorizontal="28dp"
                android:paddingBottom="12dp"
                android:text="@string/incognito_home_warning"
                android:textColor="@color/incognito_on_surface_variant"
                android:textSize="11sp" />

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Autocomplete overlay (same as HomeFragment) -->
    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <!-- New tab flash overlay (same as HomeFragment) -->
    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="@color/incognito"
        android:visibility="gone" />

    <!--
        Bottom navigation bar — middle slot shows the flat Bookmarks
        button in-bar (no hideMiddleSlot). Same action as normal home:
        the bookmarks list is just URLs the user explicitly saved, so
        showing it from an incognito session leaks no private browsing
        state. (The former hero Bookmarks FAB was removed.)
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
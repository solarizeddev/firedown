<?xml version="1.0" encoding="utf-8"?>
<!--
  Active-download strip on the home page. Carries the Firedown
  flame icon (alpha-pulsing) + 'DOWNLOADING' header on top, with
  up to N (currently 3) compact rows below — one per in-flight
  regular download. Each row shows filename + percent + its own
  progress bar.

  Tinted with colorPrimaryContainer to read as 'live' — distinct
  from the surface-container colour the static Downloads / Safe
  Folder cards use. Whole card is tappable; tap → DownloadsActivity.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/active_download_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!--
            Header: pulsing Firedown flame + 'DOWNLOADING…' label.
            The flame's alpha animator is wired in HomeFragment and
            communicates 'live'; the static Downloads card below
            uses the canonical download arrow, so no icon
            duplication between the two surfaces.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/active_download_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_firedown"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.08"
                android:text="@string/downloading"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnPrimaryContainer" />

        </LinearLayout>

        <!--
            Rows container — HomeFragment inflates one
            view_home_active_download_row per active item (cap = 3)
            and removeAllViews + re-inflates on every observer tick.
            Vertical stack; each row carries its own top padding so
            spacing scales naturally with N.
        -->
        <LinearLayout
            android:id="@+id/active_download_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- The settings category header for the grouped cards
     (CardPreferenceGroupAdapter): a quiet label sitting 16dp inside the card
     edge (the 16dp list gutter + 16dp), above the group it names. Grey
     (onSurfaceVariant), NOT the old coral colorAccent label: brand coral is
     ~2.3:1 on the light page, under the 4.5:1 text floor, and with the cards
     doing the grouping the label no longer needs to shout. Top/bottom padding
     is set per bind (a title-less category collapses to a bare group break),
     so the values here only seed the first frame. No icon frame: categories
     never reserve icon space. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="@dimen/settings_category_padding_top"
    android:paddingBottom="@dimen/settings_category_padding_bottom">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

</LinearLayout>

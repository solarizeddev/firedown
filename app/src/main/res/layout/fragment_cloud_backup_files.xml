<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- In-progress banner: shown while a backup/restore transfer is running
             (the file isn't in the manifest until its upload completes, so without
             this the list looks idle mid-upload). Indeterminate, like the workers'
             notification; the fragment toggles it from the WORK_TAG observer and
             reloads the list when a transfer finishes. -->
        <LinearLayout
            android:id="@+id/cb_progress_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/cb_progress_text"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/settings_cloud_backup_active"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/cb_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                app:indicatorTrackGapSize="0dp"
                app:trackCornerRadius="3dp"
                app:trackThickness="4dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cb_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

    <!-- Empty state — identical structure + styling to the Downloads empty view
         (recycler_empty_layout.xml): illustration whose bottom sits at the vertical
         centre, message below in sans-serif-medium / colorOnSurface. The fragment
         toggles this group's visibility, hides the illustration during the brief
         load, and sets the message text. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cb_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cb_empty_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/empty_image_height_big"
            android:contentDescription="@string/empty_list"
            app:layout_constraintBottom_toTopOf="@id/cb_empty_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ill_baloons" />

        <View
            android:id="@+id/cb_empty_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cb_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/list_spacing"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="@dimen/empty_text_padding"
            android:paddingEnd="@dimen/empty_text_padding"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_empty_divider"
            tools:text="@string/cloud_backup_list_empty" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

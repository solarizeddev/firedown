<?xml version="1.0" encoding="utf-8"?>
<!--
  Backed-up files list: a TEXT-ONLY header (inventory + quota/trust context,
  hidden while the list is empty/loading — the LCEE illustrations own those
  states) over the app-standard LCEERecyclerView (loading spinner / content /
  empty-illustration states, change animations disabled so per-item progress
  ticks don't blink) — same list treatment as Downloads/Bookmarks/History.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cb_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/cb_header_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="12 files · 51 MB" />

        <TextView
            android:id="@+id/cb_header_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="of 11 GB included · encrypted end-to-end" />
    </LinearLayout>

    <com.solarized.firedown.ui.LCEERecyclerView
        android:id="@+id/cb_lcee"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Backed-up files list. Uses the app-standard LCEERecyclerView (loading spinner /
  content / empty-illustration states, and it disables RecyclerView change
  animations so per-item progress ticks don't blink) — same as the
  Downloads/Bookmarks/History lists.
-->
<com.solarized.firedown.ui.LCEERecyclerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cb_lcee"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

<?xml version="1.0" encoding="utf-8"?>
<!--
  Backed-up files list: a text-only header (inventory line + status/trust line;
  hidden while the list is empty/loading — the LCEE illustrations own those
  states) over the app-standard
  LCEERecyclerView (loading spinner / content /
  empty-illustration states, change animations disabled so per-item progress
  ticks don't blink) — same list treatment as Downloads/Bookmarks/History.

  The header SCROLLS AWAY with the list (scrollFlags="scroll" inside the
  AppBarLayout, CoordinatorLayout + ScrollingViewBehavior): a pinned+lifting
  header was tried first, but this fragment's AppBarLayout can't lift the
  ACTIVITY toolbar above it, so the M3 lift tint rendered as a stray gray band
  sandwiched between two flat white surfaces (on-device). Scrolling it off is
  the clean alternative — the activity toolbar still titles the screen, and
  the inventory line returns at top. The bottom navigation_scrim is the
  DownloadFragment pattern: an overlay whose height tracks the system-bar
  bottom inset, with matching recycler bottom padding (clipToPadding=false in
  the LCEE) so the last row scrolls clear of the gesture bar.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/cb_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- scroll (no enterAlways/pin): the header rides off with the content
             and comes back only at the top — no lift, no tint band.

             TEXT ONLY: inventory line, then status + trust. The header carries
             no control at all — the "Add storage credit" door is a toolbar
             OVERFLOW item (menu_cloud_backup), which is what removed the width
             fight that used to live here.

             History, because the obvious "put it back beside the text" is wrong:
             this row held a trailing runway BUTTON, and on a 360dp phone
             "Add storage credit ›" ate ~170dp of ~340dp, truncating the trust
             line to "…encrypted e…" (reported on-device). No width split fixes
             that — a long translatable BUTTON and a long translatable SUBTITLE
             are two full-width demands that grow TOGETHER, so the worst case is
             always simultaneous (German: "Speicherguthaben hinzufügen" beside
             "Ende-zu-Ende-verschlüsselt"), and line 1 takes a "Backing up… · "
             prefix during a transfer, so it is no safer a neighbour. Moving the
             ACTION to the toolbar leaves only text here, and text can WRAP where
             a button label cannot — hence maxLines=2 on line 2, which degrades
             by growing rather than by hiding a fact. -->
        <!-- Line 2 = STATUS · trust ("≈ 1 year of coverage · encrypted
             end-to-end", "Read-only · …", or the beta's "of 11 GB included · …").
             Status leads so a wrap moves the boilerplate tail, not the fact. It
             stays HERE rather than following the door into the overflow because
             a menu item is invisible until opened, and status you have to go
             looking for is not status — the read-only grace state in particular
             has to be readable on arrival. -->
        <LinearLayout
            android:id="@+id/cb_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_scrollFlags="scroll">

            <TextView
                android:id="@+id/cb_header_line1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="12 files · 51 MB" />

            <TextView
                android:id="@+id/cb_header_line2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="≈ 1 year of coverage · encrypted end-to-end" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <com.solarized.firedown.ui.LCEERecyclerView
        android:id="@+id/cb_lcee"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

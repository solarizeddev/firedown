<?xml version="1.0" encoding="utf-8"?>
<!-- The Captured item's ⋮ menu as an IN-SHEET page of the holder sheet
     (pushed like the variants picker / help — slide-in, Back pops), NOT a
     second modal bottom sheet stacked on the captured one: Material guidance
     and this app's own precedents (the Downloads sheet's Media-tools
     in-place swap, the sync QR panel's rejected dialog-on-dialog) both say
     sheets don't stack. Rendering inside the holder also inherits the
     sheet's exact surface + incognito theming, which a standalone sheet had
     to re-derive. Rows are the app-standard DialogOption items built by
     OptionsAdapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header: back + the FILE NAME wrapping to TWO lines, closed by a
         hairline before the rows (the LibreTube sheet shape, by maintainer
         request). NOT a MaterialToolbar: a Toolbar title is single-line by
         design, so long capture names ellipsized after half the words — the
         name is the one fact telling the user WHICH capture this menu acts
         on, so it gets the room. The back arrow stays (unlike LibreTube's
         root sheet this is a PUSHED page — the arrow is the way back to the
         captured list; swipe-down still dismisses the whole sheet). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/menu_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/abc_action_bar_up_description"
            android:src="?attr/homeAsUpIndicator"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <View
        style="@style/Firedown.Divider.InCard"
        android:layout_marginBottom="4dp" />

    <!-- wrap_content on purpose: with the holder's per-page WRAP height
         (applyContentHeightForPage), the sheet hugs this page — four rows,
         not a full-height sheet with a void under them. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</LinearLayout>

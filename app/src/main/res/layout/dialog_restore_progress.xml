<?xml version="1.0" encoding="utf-8"?>
<!-- Indeterminate progress shown while a SAF restore runs (DownloadBackupMirror
     .restoreFromTree): the tree scan + AES-GCM decrypt + DB import happen off the
     main thread between the folder pick and the result snackbar, a gap with no
     other feedback. Shared by both restore doors (DownloadFragment empty state,
     Settings → Restore previous downloads). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/restore_progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorSize="32dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/restore_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:text="@string/restore_downloads_progress" />
</LinearLayout>

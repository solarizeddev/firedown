<?xml version="1.0" encoding="utf-8"?>
<!-- "Send to browser" share sheet (LanShareDialogFragment). Shows the local
     URL, the QR (URL + PIN combined, so scanning skips both), the PIN, the
     shared file, and Stop. The LanShareServer's lifetime is this sheet's
     lifetime — dismissing stops sharing.

     Two modes: with a usable LAN the share content shows immediately; with
     none (cellular-only) the direct-connection intro shows instead, and
     accepting it raises a LocalOnlyHotspot — step 1 reuses the SAME content
     views (URL chip = hotspot name, PIN slot = password, QR = Wi-Fi join
     code) and the Next button flips them to the normal URL/PIN/QR. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <!-- 16dp top padding = the M3 gap between the drag handle and the
         header; 16dp gutter matches every other sheet (not 20/24dp). -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:text="@string/lan_share_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/lan_share_lead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:text="@string/lan_share_lead"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Sender-side VPN heads-up (receiver-side VPN is undetectable) -->
    <TextView
        android:id="@+id/lan_share_vpn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:text="@string/lan_share_vpn_warning"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- No-LAN case: offer the hotspot direct connection instead of a
         dead-end snackbar -->
    <LinearLayout
        android:id="@+id/lan_direct_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:text="@string/lan_direct_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lan_direct_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/lan_direct_start" />

    </LinearLayout>

    <!-- Share content: normal mode immediately, or hotspot step 1/2 -->
    <LinearLayout
        android:id="@+id/lan_share_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- The short URL the receiver types (hotspot step 1: the SSID) -->
        <TextView
            android:id="@+id/lan_share_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_lan_share_url"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="11dp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textIsSelectable="true"
            android:textSize="17sp"
            tools:text="192.168.1.57:53317" />

        <ImageView
            android:id="@+id/lan_share_qr"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_lan_share_qr"
            android:contentDescription="@string/lan_share_qr_hint"
            android:padding="12dp" />

        <TextView
            android:id="@+id/lan_share_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:text="@string/lan_share_qr_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/lan_share_pin_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="14dp"
            android:text="@string/lan_share_pin"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/lan_share_pin_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.45"
            android:paddingTop="2dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="4729" />

        <!-- Shared file summary -->
        <TextView
            android:id="@+id/lan_share_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Robot head buddy.mp4 · 6.8 MB" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lan_share_stop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lan_share_stop" />

        <!-- Hotspot step 1 -> 2 (receiver has joined, show the URL/PIN) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lan_share_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/lan_direct_next"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:text="@string/lan_share_footer"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>

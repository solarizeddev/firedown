<?xml version="1.0" encoding="utf-8"?>
<!-- One card of the Send screen's "Send to" group (P2pSendFragment, rows
     from P2pSendRows): "Share a link", "Someone next to you", or a nearby
     phone (inside the unfolded in-person card, or alone while connecting).
     A grouped SheetRowCard like every menu row in the app (corners from
     SheetGroups.applyCorners, so the press ripple stays inside the card);
     the card tone is the settings rule for a full page. The second line is
     the row's state; the end slot holds a chevron (tappable), the one
     bounded spinner (connecting), or nothing. p2p_device_extra receives the
     phones found and the QR when "Someone next to you" is unfolded. Rows are bound in place, never
     rebuilt while their kinds are unchanged. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Firedown.Widget.SheetRowCard"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/p2p_device_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_p2p_row_icon"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_p2p_24"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                style="@style/Firedown.Widget.SheetPlaceText">

                <TextView
                    android:id="@+id/p2p_device_name"
                    style="@style/Firedown.Widget.SheetPlaceTitle"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Ana's Pixel 8" />

                <TextView
                    android:id="@+id/p2p_device_status"
                    style="@style/Firedown.Widget.SheetPlaceSub"
                    tools:text="@string/p2p_on_this_wifi" />

            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/p2p_device_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />

            <ImageView
                android:id="@+id/p2p_device_chevron"
                style="@style/Firedown.Widget.SheetPlaceChevron" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/p2p_device_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Non-interactive GROUP BREAK for OptionsAdapter (between the Media-tools
     sub-sheet's back row and its options). The rows are grouped cards, so a
     break is a gap, not a hairline: 10dp here plus the next card's own 2dp
     top margin = the 12dp sheet_group_gap every grouped sheet uses. The
     adapter also ends one corner group and starts the next at this item. -->
<View xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="10dp" />

<?xml version="1.0" encoding="utf-8"?>
<!--
  Active-download banner. Softer coral tone: filled colorPrimaryContainer (not
  the heavy solid colorPrimary), content in colorOnPrimaryContainer - which is
  also a proper dark-on-coral colour in light mode (colorOnPrimary was white).
  Shown only while a download is running; pinned above the neutral cards. Flame
  mark + 'DOWNLOADING... NN%' status + filename + a thicker rounded progress bar
  + an X that cancels. Bound in HomeFragment; tap -> Downloads. Theme attrs ->
  light + dark.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_download_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_firedown"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_download_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="Downloading... 46%" />

            <TextView
                android:id="@+id/home_download_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="The Enchanted Forest Trail" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/home_download_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:max="100"
                android:progress="0"
                app:indicatorColor="?attr/colorOnPrimaryContainer"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="@color/home_download_track"
                app:trackCornerRadius="3dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="6dp" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_download_cancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="?attr/colorOnPrimaryContainer" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

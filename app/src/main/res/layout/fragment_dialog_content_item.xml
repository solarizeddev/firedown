<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the long-press context menu: the sheets' grouped card
     (Firedown.Widget.SheetRowCard + SheetRowText — OptionsAdapter sets
     the glyph from the item's iconRes and the group corners from the
     position, exactly as it does for fragment_dialog_options_item). It is
     its own layout rather than that one for ONE reason: maxLines 2. The
     dialog is 90% of the screen wide — 36dp narrower than a sheet on a
     360dp phone — and its labels are the app's longest menu strings
     ("Copiar ubicación de la imagen", "Abrir imagen en una pestaña
     nueva"), so the shared row's single-line ellipsis would cut the
     verb's object; a wrapped second line costs nothing in a menu read
     once, and the 8dp vertical padding keeps a two-line row from touching
     its card edges (a one-line row still measures the 56dp minHeight).
     The TextView keeps the item_options id the adapter binds. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Firedown.Widget.SheetRowCard">

    <TextView
        android:id="@+id/item_options"
        style="@style/Firedown.Widget.SheetRowText"
        android:maxLines="2"
        android:paddingVertical="8dp" />

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press context-menu row. Leading glyph via drawableStart
     (OptionsAdapter sets it from the item's iconRes), tinted
     onSurfaceVariant with the 16dp glyph-to-label gap every other option
     row in the app uses (Firedown.Widget.SheetRowText); the row keeps
     this popup's own 20dp gutter so the glyphs line up with the title
     above, and it is deliberately NOT a sheet card — this is a centred
     dialog, and OptionsAdapter only sets group corners on card roots. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_options"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:drawablePadding="16dp"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:textSize="16sp"
    android:textColor="?attr/colorOnSurface"
    app:drawableTint="?attr/colorOnSurfaceVariant">
</TextView>

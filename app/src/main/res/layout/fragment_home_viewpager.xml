<?xml version="1.0" encoding="utf-8"?>
<!--
  Home shortcuts surface. Two states share this container — the empty
  state (Firedown glyph + tagline + 'Add a shortcut' CTA) is shown on
  fresh installs and any time the user has zero pinned shortcuts; the
  shortcuts card with the RecyclerView is shown once at least one
  shortcut exists. HomeFragment toggles visibility in response to
  ShortCutsViewModel.getShortCuts(). Both states use the same filled
  card surface so the slot feels visually anchored in both states.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Populated state: existing grid card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recycler_view_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/list_spacing"
        android:layout_marginEnd="@dimen/list_spacing"
        android:gravity="center"
        style="@style/Widget.Material3.CardView.Filled"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerLow_highContrast">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="12dp"
            app:layoutManager="com.solarized.firedown.ui.NoScrollGridLayoutManager"
            app:spanCount="@integer/shortcuts_span" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Empty state: brand glyph + tagline + Add CTA, inside a card
         matching the populated state so the slot stays visually
         anchored regardless of which state is showing. minHeight
         roughly matches the populated card's typical 2-row footprint
         so flipping from empty → 1 pinned shortcut doesn't make the
         home jump. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/list_spacing"
        android:layout_marginEnd="@dimen/list_spacing"
        android:minHeight="240dp"
        style="@style/Widget.Material3.CardView.Filled"
        app:cardBackgroundColor="@color/md_theme_surfaceContainerLow_highContrast"
        tools:visibility="visible">

        <!--
            Centred via FrameLayout-style layout_gravity rather than
            match_parent + gravity — the card is wrap_content with a
            minHeight, and a match_parent child inside doesn't
            reliably bind to that minHeight after the visibility
            flip from the shortcuts card. wrap_content +
            layout_gravity="center" sits the tagline + button in
            the card's vertical centre regardless.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/home_empty_shortcuts_tagline"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_state_add_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/home_empty_shortcuts_add"
                app:icon="@drawable/add_24"
                app:iconGravity="textStart" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Captured-content list row. Mirrors fragment_download_item.xml's
  structure AND its selection chrome for cross-screen consistency:
  thumbnail on the left, vertical text column in the middle (filename /
  mime · domain / tags), action button on the right edge.

  Selection (action mode) matches Downloads/Bookmarks/History exactly:
  the MaterialCardView is the ROOT (no outer LinearLayout, no external
  left checkmark), the check (item_download_more_checked) is an overlay
  in the more-button's own slot — the adapter swaps them on the
  action-mode toggle (more INVISIBLE, check VISIBLE) so the row never
  reflows — and the selected state paints a tonal WASH on the card via
  the adapter, not a stroke border. Previously this row used an
  external left check inside a wrapping LinearLayout plus a 2dp stroke,
  which read as a completely different selection UI from the other
  three lists; that wrapper and stroke are gone.

  Card background uses surfaceContainerLow with zero elevation —
  enough tonal contrast against the bottom-sheet surface for the
  rows to read as discrete items (the sheet's appbar doesn't lift,
  so we need *some* per-row containment) without the heavy
  elevated-card shadow. This is the ONE deliberate difference from
  Downloads (whose row card is transparent): the selected wash is
  therefore layered over surfaceContainerLow, not over the bare
  surface (see BrowserOptionAdapter's mSelectedListBg).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/list_spacing"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/list_spacing"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/list_margin"
        android:minHeight="@dimen/list_download_image_height">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="@dimen/list_download_image_width"
            android:layout_height="@dimen/list_download_image_height"
            android:adjustViewBounds="true"
            android:background="@drawable/mask_image_rounded"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Text column: filename / mime · domain / tags.
             wrap_content height with top+bottom parent constraints
             — centred when shorter than the thumbnail, but the
             row grows when content needs more vertical space
             (large font scales). Keeps the tag line from
             clipping at accessibility scales. -->
        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/list_margin"
            android:paddingEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/item_download_more"
            app:layout_constraintStart_toEndOf="@id/image"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/file_name"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                tools:text="video_file.mp4" />

            <!-- Meta line: mime label · domain. The mime label carries
                 its own trailing ' · ' (appended by the adapter), so it
                 doubles as the separator — no globe icon between the two
                 (it was decoration: identical on every row and redundant
                 with both the domain text and that separator). -->
            <LinearLayout
                android:id="@+id/row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mime_text"
                    style="@style/MimePrimaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="VÍDEO · " />

                <TextView
                    android:id="@+id/file_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="m.youtube.com" />

            </LinearLayout>

            <!-- Tag row: quality · duration. Single horizontal
                 line; either or both can be GONE at bind time. -->
            <LinearLayout
                android:id="@+id/tag_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_quality"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="1080p"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tag_separator"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/separator"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tag_duration"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="03:45"
                    tools:visibility="visible" />

                <!-- Caption count. Shown on a video row when the parser
                     captured subtitle tracks for it. Primary-tinted so it
                     reads as a distinct affordance from quality/duration.
                     A leading separator is rendered at bind time only when
                     another tag precedes it. -->
                <TextView
                    android:id="@+id/tag_cc_separator"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/separator"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tag_cc"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    tools:text="CC 52"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_download_more"
            style="@style/Theme.FireDown.More.Button"
            app:icon="@drawable/ic_baseline_more_vert_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Selection checkmark — overlays the more-button's slot on the
             right edge; the adapter swaps them on the action-mode toggle
             (more INVISIBLE, this VISIBLE), so the row geometry stays
             stable (no reflow) and the check renders against the plain
             card surface. Same pattern as fragment_download_item's
             item_download_selected. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_download_more_checked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/item_download_more"
            app:layout_constraintEnd_toEndOf="@id/item_download_more"
            app:layout_constraintStart_toStartOf="@id/item_download_more"
            app:layout_constraintTop_toTopOf="@id/item_download_more"
            app:srcCompat="@drawable/ic_baseline_check_circle_24" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

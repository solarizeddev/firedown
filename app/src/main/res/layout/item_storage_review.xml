<?xml version="1.0" encoding="utf-8"?>
<!--
  Storage review row (StorageReviewAdapter). The Files-by-Google "Large files"
  shape, deliberately NOT the Downloads row: a real CHECKBOX on the left (an
  empty ring in the ⋮ slot read as a radio button — single choice — which is
  the opposite of what this screen asks), then the thumbnail and the name /
  MIME · domain / facts column, and the SIZE right-aligned at title weight —
  the row's loudest number, because it is the sort key and the decision.
  Every comparable review screen (Files, iOS "Review Large Attachments",
  Signal's tile badge) leads with it; as the first token of the 11sp facts
  line it read as a Downloads list, not a size list.

  The card carries the same transparent-at-rest / primaryContainer-wash
  selection paint as every other list row (SelectionStyling). The checkbox
  is NOT clickable itself — the whole row toggles, so the tap target is the
  row and the box just shows the state.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="@dimen/list_download_image_height">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/review_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="@dimen/list_download_image_width"
            android:layout_height="@dimen/list_download_image_height"
            android:background="@drawable/mask_image_rounded"
            android:contentDescription="@null"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/review_check"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Size column: title weight, right-aligned, never ellipsized —
             the text column yields to it. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/review_size"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1.6 GB" />

        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/list_margin"
            android:paddingEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/review_size"
            app:layout_constraintStart_toEndOf="@id/image"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/file_name"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                tools:text="3 Hours of Fantasy Music - Best of…" />

            <LinearLayout
                android:id="@+id/row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mime_text"
                    style="@style/MimePrimaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="VIDEO · " />

                <TextView
                    android:id="@+id/file_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="youtube.com" />

            </LinearLayout>

            <!-- Facts: [cloud] duration · date. Size lives in its own column. -->
            <TextView
                android:id="@+id/status_text"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="3:11:45 · Sep 7, 2026" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

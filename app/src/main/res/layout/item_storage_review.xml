<?xml version="1.0" encoding="utf-8"?>
<!--
  Storage review row (StorageReviewAdapter). The app's ONE list-row selection
  shape (CLAUDE.md "List-row selection chrome is shared"): the check-circle
  sits in the trailing action slot on the RIGHT — the same 24dp slot the
  Downloads row's ⋮ occupies, coral filled circle when ticked, coral ring
  otherwise — and the card carries the primaryContainer wash. This screen has
  no ⋮ (no per-row menu), so the slot holds the check from the first frame:
  selection is the resting state here, but the CHROME is identical to
  Downloads in action mode, so the two lists read as one app side by side.

  History: it shipped once with a MaterialCheckBox on the LEFT (the
  Files-by-Google shape), argued from "the empty ring reads as a radio
  button". Side by side with the Downloads long-press list that argument
  lost — the Downloads list uses the same ring and is never misread (the
  filled check-circle is Google Photos' multi-select glyph), and a second
  selection language on one screen of the app read as a different app.

  What the row keeps from the review-screen shape: the SIZE right-aligned at
  title weight, between the text column and the check — the row's loudest
  number, because it is the sort key and the decision (as the first token of
  the 11sp facts line it read as a Downloads list, not a size list). The
  check is NOT clickable itself — the whole row toggles.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="@dimen/list_download_image_height">


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="@dimen/list_download_image_width"
            android:layout_height="@dimen/list_download_image_height"
            android:background="@drawable/mask_image_rounded"
            android:contentDescription="@null"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Selection check — the Downloads row's action slot: the same 24dp
             box Theme.FireDown.More.Button gives the ⋮ (the row-level 8dp
             margin does the rest), so the two rows align edge to edge; the adapter sets the coral check-circle / ring drawable
             (Utils.tintDrawableColor, as DownloadItemAdapter does — the
             drawable's own fill is white). -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/review_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@drawable/radio_button_unchecked_24" />

        <!-- Size column: title weight, right-aligned, never ellipsized —
             the text column yields to it. Sits between the text and the
             check, where Files by Google keeps its size relative to its
             check. -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/review_size"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/review_check"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1.6 GB" />

        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/list_margin"
            android:paddingEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/review_size"
            app:layout_constraintStart_toEndOf="@id/image"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/file_name"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                tools:text="3 Hours of Fantasy Music - Best of…" />

            <LinearLayout
                android:id="@+id/row_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mime_text"
                    style="@style/MimePrimaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="VIDEO · " />

                <TextView
                    android:id="@+id/file_url"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="youtube.com" />

            </LinearLayout>

            <!-- Facts: [cloud] duration · date. Size lives in its own column. -->
            <TextView
                android:id="@+id/status_text"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="3:11:45 · Sep 7, 2026" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

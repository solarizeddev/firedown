<?xml version="1.0" encoding="utf-8"?>
<!--
    Browser popup quick-row: page-context transient actions —
    Back · Forward · Bookmark · Share · Refresh. New-tab actions live
    in the body list (they aren't page-context verbs).

    The Bookmark STAR sits in position 3 of 5 — promoted here from a
    buried "Bookmark page" list row so the single most-frequent quick
    action is one tap away and self-identifying (outline → filled amber
    "Saved"). The star toggles IN PLACE (it does not dismiss the sheet
    like the other buttons) and is the only column that repaints on
    state; its icon/label/tint + the confirmation toast (Edit/Undo) are
    driven from PopupBrowserSheetDialogFragment.

    Five EVEN columns (minWidth 0 so weight fully controls the width —
    no off-centre gaps), inset from the sheet edges by
    quick_row_horizontal_padding. All buttons share
    Firedown.Widget.PopupQuickRowButton — zero inset + 0dp inner
    horizontal padding — single line.

    Long localised labels: the fragment drops the WHOLE row to
    icon-only rather than wrapping, scrolling or truncating. The
    decision is two-stage: a pre-layout estimate (QuickRowLabels.iconOnly,
    from width + font scale) picks the initial mode with no flicker, then
    a post-measure check drops to icon-only if ANY translated label would
    still ellipsize at its real column width — so a locale with wider
    labels than the English calibration degrades cleanly. The icons never
    move, so the star never re-hides; every button carries its label as
    contentDescription + a long-press tooltip, so icon-only stays
    accessible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/quick_row_horizontal_padding">


    <com.solarized.firedown.ui.browser.BackwardBrowserButton
        android:id="@+id/popup_go_backward"
        style="@style/Firedown.Widget.PopupQuickRowButton"
        app:icon="@drawable/ic_arrow_back_24"
        android:text="@string/browser_menu_back" />


    <com.solarized.firedown.ui.browser.ForwardBrowserButton
        android:id="@+id/popup_go_forward"
        style="@style/Firedown.Widget.PopupQuickRowButton"
        app:icon="@drawable/ic_arrow_forward_24"
        android:text="@string/browser_menu_forward" />


    <!-- Bookmark star (position 3 of 5). Toggles in place — icon
         (border → filled), label (Bookmark → Saved) and tint (amber
         colorPrimary when saved) are repainted by applyStarState().
         The XML defaults render the unsaved state. -->
    <com.solarized.firedown.ui.browser.BookmarkBrowserButton
        android:id="@+id/popup_bookmark_star"
        style="@style/Firedown.Widget.PopupQuickRowButton"
        app:icon="@drawable/ic_bookmark_border_24"
        android:text="@string/browser_menu_bookmark_short" />


    <com.solarized.firedown.ui.browser.ShareBrowserButton
        android:id="@+id/popup_share"
        style="@style/Firedown.Widget.PopupQuickRowButton"
        app:icon="@drawable/ic_share_24"
        android:text="@string/browser_menu_share" />


    <com.solarized.firedown.ui.browser.ReloadBrowserButton
        android:id="@+id/popup_reload"
        style="@style/Firedown.Widget.PopupQuickRowButton"
        app:icon="@drawable/ic_refresh_24"
        android:text="@string/browser_menu_refresh" />


</LinearLayout>

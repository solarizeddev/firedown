<?xml version="1.0" encoding="utf-8"?>
<!--
  'Continue browsing' entry card on the home page. Filled surfaceContainerHigh
  card with a NEUTRAL chip (grey square + onSurfaceVariant icon - deliberately a
  generic browser glyph, NOT the last tab's favicon) + 'Continue browsing' title
  + the last tab's title/domain as subtitle. No trailing chevron. The only
  coloured surface on the home is the active-download banner; these landmark
  cards stay monochrome. Tap resumes the most-recently-used non-home tab
  (HomeFragment.openSessionId). Hidden by HomeFragment when there's no such tab.
  Theme attrs -> works light + dark.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/continue_browsing_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Same rounded-square chip as the other cards (consistent row), with
             the site FAVICON centered inside it - fitCenter keeps the favicon's
             aspect ratio (no stretch) at a readable 26dp. ic_web_24 is the
             pre-load placeholder; GlideHelper falls back to the domain tile. -->
        <FrameLayout
            android:id="@+id/continue_browsing_chip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_container_primary"
            android:backgroundTint="?attr/colorSurfaceContainerHighest">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/continue_browsing_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_web_24" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/continue_browsing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_continue_browsing"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <!--
                Subtitle: the last tab's title, falling back to its domain.
                Set + shown in HomeFragment; hidden when neither is known.
            -->
            <TextView
                android:id="@+id/continue_browsing_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="en.wikipedia.org"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

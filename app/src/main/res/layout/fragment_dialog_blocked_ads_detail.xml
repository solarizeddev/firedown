<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-page uBlock blocked-host list. Opened from the SecurityStateSheet
    when the user taps the "N blocked on this page" row. Title row + empty
    state + RecyclerView; renders a flat host+count list — no per-category
    grouping, because uBlock can't honestly classify its own blocks by
    filter-list origin. (Its ETP-side sibling, the per-category trackers
    detail, was removed with the per-site tracking switch.)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />


    <!-- Title row. Mirrors the host_secure / host_clear rows on the
         parent security sheet for visual continuity. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:srcCompat="@drawable/ads_click_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/blocked_ads_detail_title"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detail_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="24 requests blocked on this page" />

        </LinearLayout>

    </LinearLayout>


    <!-- Empty state — when the count card on the parent showed 0 OR
         when the JS reply hasn't landed yet (the LiveData starts as an
         empty list and only repopulates once firedown.js answers the
         requestPageBlocks round-trip). -->
    <TextView
        android:id="@+id/detail_empty"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/blocked_ads_detail_empty"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="gone" />


    <!-- Flat host+count list, in ONE sheet card (the grouped-card shape
         every sheet uses — see the parent security sheet), inset 16dp.
         The CARD is what the fragment shows/hides against the empty state
         (detail_list_card), so an empty list never paints a bare surface.
         Reuses BlockedTrackerDetailAdapter + item_blocked_tracker_host since
         the (host, count) row shape is identical to the TrackersInfoSheet's
         Top trackers list. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detail_list_card"
        style="@style/Firedown.Widget.SheetRowCard"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:clickable="false"
        android:focusable="false"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detail_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingVertical="6dp"
            android:scrollbars="vertical" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-page uBlock blocked-host list ("Blocked on this page"). Opened from
    the SecurityStateSheet when the user taps the "N blocked on this page"
    row. Header row + empty state + RecyclerView; a flat host + count list —
    no per-category grouping, because uBlock can't honestly classify its own
    blocks by filter-list origin. (Its ETP-side sibling, the per-category
    trackers detail, was removed with the per-site tracking switch.)

    The header wears the SHIELD, the glyph of every count surface (the home
    line, the address bar, the security sheet's count row, the Settings
    door); ads_click stays on the "Block ads and trackers" switch, the one
    control. Its one line is the count itself ("23 requests blocked on this
    page"); it was a "Blocked ads" title over that same line, which named
    one kind of request for a list of all of them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />


    <!-- Header row. Hidden while the list is empty: the empty state below
         says the same thing, and "0 requests blocked" above "Nothing
         blocked on this page yet" would say it twice. -->
    <LinearLayout
        android:id="@+id/detail_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_shield_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/detail_subtitle"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="16sp"
            tools:text="23 requests blocked on this page" />

    </LinearLayout>


    <!-- Empty state — when the count row on the parent showed 0 OR when
         the JS reply hasn't landed yet (the LiveData starts as an empty
         list and only repopulates once firedown.js answers the
         requestPageBlocks round-trip). The shield in a tonal disc, the
         glyph the rest of the count surfaces wear: no illustration in a
         bottom sheet. -->
    <LinearLayout
        android:id="@+id/detail_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_empty_disc"
            android:importantForAccessibility="no"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_shield_24"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/blocked_page_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>


    <!-- One grouped sheet card per host (item_blocked_tracker_host, the
         anatomy of the Settings "Most blocked domains today" rows), 2dp
         apart with 16dp outer corners; the adapter shapes each row from
         its place in the list. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detail_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical" />

</LinearLayout>

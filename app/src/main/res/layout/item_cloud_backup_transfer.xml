<?xml version="1.0" encoding="utf-8"?>
<!--
  An in-progress upload row in the backed-up-files list (CloudBackupFileAdapter,
  TYPE_TRANSFER). Same frame as item_cloud_backup_file.xml (MaterialCardView +
  8dp-inset ConstraintLayout + the list_download_image thumbnail) but the third
  line is a Downloads-style progress row (percent + LinearProgressIndicator)
  instead of the date, and the right edge carries a cancel button.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cb_transfer_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="@dimen/list_download_image_height">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cb_thumb"
            android:layout_width="@dimen/list_download_image_width"
            android:layout_height="@dimen/list_download_image_height"
            android:background="@drawable/mask_image_rounded"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/list_margin"
            android:paddingEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cb_transfer_cancel"
            app:layout_constraintStart_toEndOf="@id/cb_thumb"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/cb_name"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                tools:text="Midjourney Medical.mp4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cb_mime"
                    style="@style/MimePrimaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="VÍDEO · " />

                <TextView
                    android:id="@+id/cb_transfer_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Backing up…" />

            </LinearLayout>

            <!-- Downloads-style progress row: percent + bar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cb_progress_text"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="42%" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/cb_progress_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:indeterminate="true"
                    android:max="100"
                    android:progress="0"
                    app:indicatorTrackGapSize="0dp"
                    app:trackCornerRadius="3dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="5dp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cb_transfer_cancel"
            style="@style/Theme.FireDown.More.Button"
            android:contentDescription="@string/cancel"
            app:icon="@drawable/ic_baseline_close_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

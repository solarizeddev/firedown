<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="8dp"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Thumbnail. match_parent both ways inside the 16:10
                 ratio card — adjustViewBounds is intentionally absent
                 because the dimensions are fixed; the platform would
                 still evaluate it on every measure. -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/mask_image_rounded"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />

            <!-- Progress ring (PROGRESS only). Centered in the WHOLE tile —
                 the in-progress counterpart of the centered mime glyph shown
                 for non-progress tiles, so both states put their focal element
                 in the same place at the same size (the ring is fixed-size, see
                 ProgressOverlayView). The title sits in the bottom_block caption
                 below, on its scrim. No placeholder glyph during a download. -->
            <com.solarized.firedown.ui.ProgressOverlayView
                android:id="@+id/image_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Bottom info block: a gradient scrim carrying the title + a
                 metadata row + status, mirroring the Captured grid. The scrim
                 is the block's background (always present); the adapter toggles
                 the individual children per download state. Left-aligned and
                 full-width like Captured. -->
            <LinearLayout
                android:id="@+id/bottom_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_scrim"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Title. Full-width, left-aligned — same slot across every
                     state (downloading / finished / queued / error), so titles
                     line up down a mixed grid column. During a download the
                     percent lives in the ring above, not here. -->
                <TextView
                    android:id="@+id/file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    tools:text="Latorre, sobre Zapatero: Todo era una fantasía…" />

                <!-- Metadata row: ONE text language, the same weighted hierarchy
                     the list row's line 2 uses — the mime type at full-strength
                     light ink, then the duration/size after it at ~88% white.
                     The " · " separator is prepended to mime_duration by the
                     adapter (so a hidden duration leaves no dangling separator,
                     and a suppressed mime leaves no leading one), which is why
                     mime_duration carries no start margin. Neither token has a
                     background — see the MimePrimary style header for why the
                     chip was deleted after six rounds of tuning its fill. -->
                <LinearLayout
                    android:id="@+id/row_mime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mime_text"
                        style="@style/MimePrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        tools:text="mp4" />

                    <TextView
                        android:id="@+id/mime_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:textColor="#E0FFFFFF"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:visibility="gone"
                        tools:text="00:10" />

                </LinearLayout>

                <!-- ERROR / QUEUED / "Finishing…" status. FINISHED's "size ·
                     date" label is list-only; the grid leans on title + mime
                     instead. (Download progress shows in the ring, not here.) -->
                <TextView
                    android:id="@+id/status_text"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    tools:text="@string/error_check_internet_connection" />

            </LinearLayout>

            <!-- Action button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_download_action"
                style="@style/Theme.FireDown.More.Button"
                app:icon="@drawable/ic_baseline_more_vert_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/image" />

            <!-- Cloud-backed marker: a bare white cloud in the top-START corner
                 (the ⋮ and the selection check own top-end; the scrim owns the
                 bottom, and the grid meta line has no spare width for a glyph).
                 NO disc/pill background — just the glyph, the lightest possible
                 mark, held at ~70% alpha so it reads as a quiet secondary marker
                 (opaque white was too prominent against dark video thumbnails);
                 it may wash out on rare bright artwork, the same accepted
                 trade-off as the grid ⋮. Shown only for a FINISHED backed-up file.
                 The glyph carries NO check mark (it was a cloud_done): at 14dp the
                 tick inside the silhouette is mush, and the badge only ever appears
                 for a backed-up file, so its presence already says "done". The
                 adapter swaps in the shadowed cloud_badge over a real thumbnail. -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/cloud_badge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:contentDescription="@string/cloud_backed_up_desc"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/cloud_24"
                app:tint="@android:color/white" />

            <!-- Selection indicator -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_download_selected"
                style="@style/Theme.FireDown.Selected.Button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_check_circle_24" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
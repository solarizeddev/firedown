<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="8dp"
        app:strokeWidth="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Thumbnail. match_parent both ways inside the 16:10
                 ratio card — adjustViewBounds is intentionally absent
                 because the dimensions are fixed; the platform would
                 still evaluate it on every measure. -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/mask_image_rounded"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />

            <!-- Progress ring (PROGRESS only). Centered in the WHOLE tile —
                 the in-progress counterpart of the centered mime glyph shown
                 for non-progress tiles, so both states put their focal element
                 in the same place at the same size (the ring is fixed-size, see
                 ProgressOverlayView). The title sits in the bottom_block caption
                 below, on its scrim. No placeholder glyph during a download. -->
            <com.solarized.firedown.ui.ProgressOverlayView
                android:id="@+id/image_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Bottom info block: the title + a metadata row + status.
                 Left-aligned and full-width like Captured.

                 It is NOT shown on every tile any more. A FINISHED tile whose
                 thumbnail is a REAL picture (video frame / image / cover art /
                 apk icon) is rendered BARE — no caption at all, just the
                 picture plus the small bottom-end pill below; the adapter hides
                 this block for those (see DownloadItemAdapter's `bare`). So
                 what remains here is the caption for tiles whose thumbnail
                 does NOT identify the file: the generated pastel mime tiles
                 (art-less audio / doc / archive / …) and the in-flight /
                 error / queued states. The background is set by the adapter
                 accordingly (a flat theme card vs this bottom_scrim) — see
                 applyGridTileGround. -->
            <LinearLayout
                android:id="@+id/bottom_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_scrim"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Title. Full-width, left-aligned — same slot across every
                     state (downloading / finished / queued / error), so titles
                     line up down a mixed grid column. During a download the
                     percent lives in the ring above, not here. -->
                <TextView
                    android:id="@+id/file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    tools:text="Latorre, sobre Zapatero: Todo era una fantasía…" />

                <!-- Metadata row: ONE text language, the same weighted hierarchy
                     the list row's line 2 uses — the mime type at full-strength
                     light ink, then the duration/size after it at ~88% white.
                     The " · " separator is prepended to mime_duration by the
                     adapter (so a hidden duration leaves no dangling separator,
                     and a suppressed mime leaves no leading one), which is why
                     mime_duration carries no start margin. Neither token has a
                     background — see the MimePrimary style header for why the
                     chip was deleted after six rounds of tuning its fill. -->
                <LinearLayout
                    android:id="@+id/row_mime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Cloud-backed marker. INLINE here, leading the meta line
                         — the same placement as the list row's. It used to be a
                         corner overlay on the artwork, which was one of THREE
                         pieces of chrome competing on the picture (cloud
                         top-start, ⋮ top-end, caption across the bottom). A tile
                         that still shows this caption is by construction a
                         pastel mime tile (no picture to protect), so the badge
                         belongs on the meta line with the facts it qualifies —
                         and the theme ground means it needs no shadowed variant
                         and no ground-aware tint (the adapter gives it
                         colorOnSurfaceVariant, the ink of the facts beside it).
                         A backed-up tile that DOES show a picture carries its
                         cloud in the bottom-end pill instead. Bare cloud, no
                         check mark: at 12dp a tick reads as a smudge, and the
                         badge only ever appears for a backed-up file, so its
                         presence already says "done". FINISHED backed-up
                         only. -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/cloud_badge"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:alpha="0.8"
                        android:contentDescription="@string/cloud_backed_up_desc"
                        android:visibility="gone"
                        app:srcCompat="@drawable/cloud_24" />

                    <TextView
                        android:id="@+id/mime_text"
                        style="@style/MimePrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        tools:text="mp4" />

                    <TextView
                        android:id="@+id/mime_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textSize="11.5sp"
                        android:textColor="#E0FFFFFF"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:visibility="gone"
                        tools:text="00:10" />

                </LinearLayout>

                <!-- ERROR / QUEUED / "Finishing…" status. FINISHED's "size ·
                     date" label is list-only; the grid leans on title + mime
                     instead. (Download progress shows in the ring, not here.) -->
                <TextView
                    android:id="@+id/status_text"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorPrimaryContainer"
                    android:visibility="gone"
                    tools:text="@string/error_check_internet_connection" />

            </LinearLayout>

            <!-- Action button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_download_action"
                style="@style/Theme.FireDown.More.Button"
                app:icon="@drawable/ic_baseline_more_vert_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/image" />

            <!-- Facts pill — the BARE tile's only bottom chrome.
                 A FINISHED tile showing a real picture drops the caption block
                 entirely (the picture is the identity, the way Files by Google
                 and Photos render a media grid), so the two facts a thumbnail
                 genuinely can't carry get a small contained capsule in the
                 bottom-END corner instead of a full-width band: the clip's
                 DURATION and the cloud-backed marker. Contained, not ink on the
                 artwork — a capsule reads on bright and dark thumbnails alike,
                 which is exactly what the caption needed its scrim for.

                 Bottom-END (not start) so it stacks under the ⋮ and every piece
                 of chrome on a bare tile lives on the one edge: ⋮ top-end +
                 this pill bottom-end, where the tile previously carried three
                 separated zones (cloud top-start, ⋮ top-end, caption band).

                 Both children are optional: an image has no duration, an
                 un-backed-up clip has no cloud, and with neither the adapter
                 hides the whole pill so the tile really is bare. Duration only
                 (never resolution/language) — a resolution badge over a photo is
                 noise, and the duration badge is the one grid convention users
                 already read. Sized small on purpose: it must never grow into a
                 second caption. -->
            <LinearLayout
                android:id="@+id/grid_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_grid_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- The margin lives on the CLOUD's end, not the duration's
                     start, so a duration-only pill has no phantom leading gap
                     (a GONE view contributes no margin, but its visible
                     sibling's own start margin would still apply). -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/pill_cloud"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@string/cloud_backed_up_desc"
                    android:visibility="gone"
                    app:srcCompat="@drawable/cloud_24"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/pill_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="12:04" />

            </LinearLayout>

            <!-- Selection indicator -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_download_selected"
                style="@style/Theme.FireDown.Selected.Button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_baseline_check_circle_24" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
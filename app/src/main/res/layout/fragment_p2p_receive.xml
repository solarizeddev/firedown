<?xml version="1.0" encoding="utf-8"?>
<!-- "Receive a file" — P2P share receiver (P2pReceiveFragment). A window
     onto the controller's session, repainted from each ShareState snapshot.
     Stage groups: idle (the "Visible as <name>" card — this phone is
     advertised to nearby senders while the screen is open — and one Scan
     button; Paste code is in the toolbar overflow) · preview (the request: Accept /
     Decline) · status (spinner; the human-relayed reply fallback folds in
     here when both push paths failed) · progress · done (Open) · error (Try
     again). Stop button + footer always present. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@+id/p2p_receive_scroll">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.FireDown.Toolbar"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/p2p_receive_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/p2p_receive_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- IDLE: visible to nearby senders, plus the code/link fold. -->
                <LinearLayout
                    android:id="@+id/p2p_idle_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/p2p_visible_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_p2p_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="120dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:src="@drawable/ill_presents" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/p2p_visible_dot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_p2p_dot" />

                            <TextView
                                android:id="@+id/p2p_visible_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Visible as Ana's Pixel 8" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/p2p_visible_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="@string/p2p_visible_hint_link"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <!-- A sender standing here shows a QR; a link tapped in a chat
                         opens this screen by itself, and a bare code is pasted
                         from the overflow. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/p2p_scan_code"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        app:icon="@drawable/ic_qr_scan_24"
                        android:text="@string/p2p_scan_code" />

                </LinearLayout>

                <!-- PREVIEW: what the sender is offering — Accept BEFORE
                     anything connects. The request IS the screen while it
                     waits (the "Visible as" stage is swapped out), laid out
                     as the decision: who is sending, what, Decline/Accept. -->
                <LinearLayout
                    android:id="@+id/p2p_preview_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="28dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/p2p_preview_from"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Pixel 7 wants to send you" />

                    <ImageView
                        android:id="@+id/p2p_preview_icon"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_p2p_preview_tile"
                        android:contentDescription="@null"
                        android:padding="32dp"
                        app:tint="?attr/brandInk"
                        tools:src="@drawable/ic_baseline_insert_drive_file_24" />

                    <TextView
                        android:id="@+id/p2p_preview_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:ellipsize="middle"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Robot head buddy.mp4" />

                    <TextView
                        android:id="@+id/p2p_preview_tag"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="214 MB" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/p2p_decline"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/p2p_decline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/p2p_accept"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/p2p_accept" />

                    </LinearLayout>

                    <!-- The feature's real privacy claim, at the decision. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:paddingTop="12dp"
                        android:text="@string/p2p_accept_first"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- STATUS: reading a code / connecting after Accept. -->
                <LinearLayout
                    android:id="@+id/p2p_status_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="28dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorSize="40dp"
                        app:trackThickness="3dp" />

                    <!-- Plain muted label — status is state, not a control. -->
                    <TextView
                        android:id="@+id/p2p_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:text="@string/p2p_preparing"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- The LAST-RESORT reply: shown only when neither the LAN
                         return nor the rendezvous mailbox could deliver the
                         answer (ShareState.answerCode). "Send reply" for a
                         sender reached by link; the QR for one standing right
                         here. -->
                    <LinearLayout
                        android:id="@+id/p2p_reply_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_p2p_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="22dp"
                        android:paddingVertical="18dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/p2p_send_reply_body"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/p2p_send_reply"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:icon="@drawable/ic_share_24"
                            android:text="@string/p2p_send_reply" />

                        <LinearLayout
                            android:id="@+id/p2p_reply_qr_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/p2p_reply_qr"
                                android:layout_width="232dp"
                                android:layout_height="232dp"
                                android:background="@drawable/bg_p2p_qr"
                                android:contentDescription="@string/p2p_qr_content_desc"
                                android:padding="12dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/p2p_reply_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:text="@string/p2p_code_hint_reply"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Transfer stage. -->
                <LinearLayout
                    android:id="@+id/p2p_progress_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_p2p_card"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/p2p_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/p2p_progress_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="133 MB of 214 MB · 8.4 MB/s" />

                    <!-- Reconnecting spinner during a live-connection blip; the
                         bar stays frozen so it reads as recovering, not stuck. -->
                    <LinearLayout
                        android:id="@+id/p2p_reconnecting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            app:indicatorSize="16dp"
                            app:trackThickness="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/p2p_reconnecting"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.75"
                        android:gravity="center"
                        android:text="@string/p2p_background_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- Done stage -->
                <LinearLayout
                    android:id="@+id/p2p_done_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_p2p_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_baseline_check_circle_24"
                        app:tint="?attr/brandInk" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/p2p_done_received"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/p2p_open"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/p2p_open" />

                </LinearLayout>

                <!-- Error stage: message + Try again -->
                <LinearLayout
                    android:id="@+id/p2p_error_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/p2p_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="32dp"
                        android:paddingTop="16dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorError"
                        tools:text="@string/p2p_error_no_path" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/p2p_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/p2p_try_again" />

                </LinearLayout>

                <!-- "Cancel" while the session runs (confirmed mid-transfer);
                     "Done" on the outcome. Back and up merely LEAVE. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/p2p_stop"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:text="@string/cancel"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/p2p_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:text="@string/p2p_footer_connecting"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Header for the Enhanced Tracking Protection settings screen: what the
  protection actually DID, above the Standard / Strict / Custom controls
  that decide what it does. Data comes from Gecko's persisted ETP
  database (ContentBlockingController), pushed in by TrackingFragment via
  TrackingStatsPreference setters.

  Hierarchy: the all-time total is the ONE accent (colorPrimary); the
  week/today figures sit back in plain ink so the eye lands on the hero,
  not four identical coral numbers. The per-category breakdown appears
  only when it adds information — i.e. two or more categories have a
  count — under a "By category" label, so a single-category state doesn't
  just restate the hero. Distinct data source from the Home sheet's
  uBlock counts, never summed. Hidden entirely until the DB has recorded
  at least one event.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/TrackersInfoStatCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/ts_alltime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="3,204" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tracking_stats_blocked_label"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/ts_since"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Recording since 12 Jul 2026" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            style="@style/TrackersInfoStatCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout style="@style/TrackersInfoStatBody">

                <TextView
                    android:id="@+id/ts_week"
                    style="@style/TrackersInfoStatValue"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="412" />

                <TextView
                    style="@style/TrackersInfoStatLabel"
                    android:text="@string/trackers_info_etp_stat_week" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <com.google.android.material.card.MaterialCardView
            style="@style/TrackersInfoStatCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout style="@style/TrackersInfoStatBody">

                <TextView
                    android:id="@+id/ts_today"
                    style="@style/TrackersInfoStatValue"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="14" />

                <TextView
                    style="@style/TrackersInfoStatLabel"
                    android:text="@string/interval_today" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Shown only when two or more categories have a count (see
         TrackingStatsPreference) — otherwise the breakdown would just
         restate the hero total. -->
    <TextView
        android:id="@+id/ts_cat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="2dp"
        android:letterSpacing="0.08"
        android:text="@string/tracking_stats_by_category"
        android:textAllCaps="true"
        android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/ts_breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>

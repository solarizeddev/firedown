<?xml version="1.0" encoding="utf-8"?>
<!--
    Home "more" popup sheet.

    The rows are GROUPED CARDS, the Browser popup's shape exactly (see
    that layout's header): Tabs / Library / System, each group a block
    of selectable MaterialCardViews 2dp apart with 16dp outer and 4dp
    inner corners, groups 12dp apart, no hairline rules. Two Library
    rows swap by mode (Downloads vs Safe Folder) and Quit is optional, so
    the corners are recomputed from the VISIBLE rows by
    SheetGroups.applyCorners after the fragment's visibility pass; the
    XML shapes are only the regular-mode default. The destructive Quit
    row marks itself via colorPrimary text + tint.

    Incognito home reuses this layout: the fragment swaps the History
    row's icon, label, and dispatched id over to Downloads.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <include
        layout="@layout/dialog_drag_handle" />


    <!-- ── Tabs ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/popup_section_tabs"
        style="@style/Firedown.Widget.SheetGroup"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="0dp">

        <!-- New tab — always opens a REGULAR tab. Fixed meaning in both modes,
             mirroring the Browser popup's new-tab rows. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_new_tab"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/popup_tabs_new"
                app:drawableStartCompat="@drawable/ic_tabs_new_24" />

        </com.google.android.material.card.MaterialCardView>

        <!-- New private tab — always opens an INCOGNITO tab. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_new_incognito_tab"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/open_new_private_tab_2"
                app:drawableStartCompat="@drawable/ic_incognito_24" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- ── Library ──────────────────────────────────────────────── -->
    <!-- Row order is Downloads → Safe Folder → History so each mode reads
         consistently with History last, above the system group:
           regular  : Safe Folder, History   (Downloads GONE)
           incognito: Downloads, History      (Safe Folder GONE)
         Visibility is toggled in PopupHomeSheetDialogFragment, which then
         recomputes the group's corners. -->
    <LinearLayout
        android:id="@+id/popup_section_library"
        style="@style/Firedown.Widget.SheetGroup"
        android:layout_marginHorizontal="16dp">

        <!-- Downloads — incognito home only (regular home already has a
             Downloads card; incognito home does not). GONE by default; the
             fragment shows it under incognito. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_downloads"
            style="@style/Firedown.Widget.SheetRowCard"
            android:visibility="gone"
            tools:visibility="visible"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/navigation_downloads"
                app:drawableStartCompat="@drawable/download_24" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Safe Folder — regular home only. (Incognito downloads already land
             in the Safe Folder, so a dedicated entry there would be redundant.) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_vault"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/home_vault_button"
                app:drawableStartCompat="@drawable/ic_lock_24" />

        </com.google.android.material.card.MaterialCardView>

        <!-- History — both modes. Under incognito it opens the saved
             regular-session history read-only (incognito records none),
             with the incognito flag passed through. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_history"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

            <TextView
                android:id="@+id/popup_history_text"
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/library_history"
                app:drawableStartCompat="@drawable/ic_history_24" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- ── System ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/popup_section_system"
        style="@style/Firedown.Widget.SheetGroup"
        android:layout_marginHorizontal="16dp">

        <!-- Sync — bookmarks + encrypted download backup (one account). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_sync"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/settings_account_title"
                app:drawableStartCompat="@drawable/cloud_outline_24" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Settings. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_settings"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/browser_menu_settings"
                app:drawableStartCompat="@drawable/ic_settings_24" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Destructive Quit — GONE unless SETTINGS_QUIT_PREF is on.
             colorPrimary text + drawable tint is what differentiates it. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/popup_quit"
            style="@style/Firedown.Widget.SheetRowCard"
            android:visibility="gone"
            tools:visibility="visible"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

            <TextView
                style="@style/Firedown.Widget.SheetRowText.Final"
                android:text="@string/delete_browsing_data_on_quit_action"
                app:drawableStartCompat="@drawable/ic_logout_24" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>

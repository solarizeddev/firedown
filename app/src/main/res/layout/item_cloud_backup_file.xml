<?xml version="1.0" encoding="utf-8"?>
<!--
  One backed-up file row (CloudBackupFileAdapter). Mirrors the Downloads list
  row's thumbnail treatment (78x64dp, mask_image_rounded, centerCrop) + a
  TitleSmall name and a single meta line. Tapping the row opens the per-item
  bottom sheet (Restore / Remove).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cb_thumb"
        android:layout_width="@dimen/list_download_image_width"
        android:layout_height="@dimen/list_download_image_height"
        android:background="@drawable/mask_image_rounded"
        android:contentDescription="@null"
        android:outlineProvider="background"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cb_name"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/cb_meta"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</LinearLayout>

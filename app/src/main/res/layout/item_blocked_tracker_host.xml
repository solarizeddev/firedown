<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the per-page "Blocked on this page" sheet
  (BlockedAdsDetailDialogFragment): a grouped sheet card, NOT clickable (a
  fact, not an action), corners set per position by
  BlockedTrackerDetailAdapter (SheetGroups.shapeFor). Same anatomy as the
  CountPreference rows of Settings → Trackers and ads blocked, so the two
  blocked-host lists read as one: a 56dp row, the host in body-medium (14sp,
  one weight) with the site's own name brighter (HostLabel), the count
  trailing in the settings count widget's style — tabular, onSurfaceVariant,
  always shown. 16sp with a medium-weight domain shipped for one build and
  read as the loudest thing in the sheet.
  It used to be 13sp monospace rows inside one card, about 30dp tall, with
  "×3" counts and no count at all for a single block.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Firedown.Widget.SheetRowCard"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/host_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textDirection="ltr"
            tools:text="securepubads.g.doubleclick.net" />

        <TextView
            android:id="@+id/host_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

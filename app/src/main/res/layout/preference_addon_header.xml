<?xml version="1.0" encoding="utf-8"?>
<!-- The top of one add-on's page (AddonHeaderPreference): flat on the page,
     not a card. The icon sits at 32dp from the screen edge, where the card
     rows below start their text (16dp gutter + 16dp card padding), so the
     page has one left edge. Name, then author and version on their own
     lines (joined with " · " they wrapped mid-fact), then the description
     at full width under them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/addon_header_icon"
            android:layout_width="@dimen/addon_prompt_icon_size"
            android:layout_height="@dimen/addon_prompt_icon_size"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/addon_header_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="uBlock Origin" />

            <TextView
                android:id="@+id/addon_header_facts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="By Raymond Hill &amp; contributors\nVersion 1.75.4" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/addon_header_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Finally, an efficient blocker. Easy on CPU and memory." />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One engine of the search-engine picker: a grouped sheet card (the
     click root the holder listens on — radio_holder) holding the engine's
     favicon, its name and a trailing non-clickable radio (the Settings
     single-choice shape; the adapter checks it for the current engine).
     Group corners are set per position by the adapter. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/radio_holder"
    style="@style/Firedown.Widget.SheetRowCard">

    <LinearLayout style="@style/Firedown.Widget.SheetRowRadioRow">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/radio_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/radio_title"
            style="@style/Firedown.Widget.SheetRowRadioLabel"
            tools:text="DuckDuckGo" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio"
            style="@style/Firedown.Widget.SheetRowRadioButton" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

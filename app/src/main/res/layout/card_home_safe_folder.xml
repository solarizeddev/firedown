<?xml version="1.0" encoding="utf-8"?>
<!--
  Safe Folder entry card on the home page. Mirrors the Downloads card
  shape (transparent background, landmark chip + title + 'N items saved'
  subtitle) so the two read as a pair. Subtitle shows only when count > 0;
  otherwise title-only so a vault-curious user sees the entry name without
  a misleading '0 items'. Trailing chevron = the 'enter' affordance (the
  cards are transparent, so the row needs an explicit tappable signal).
  Tap → VaultActivity (the app-lock gate handles PIN / biometric).

  Extracted to its own file so it's an <include> like Downloads/Trackers
  (card_home_recent_downloads / card_home_trackers_blocked) — margins live
  on the include tag in fragment_home.xml, this root carries none.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_vault_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <FrameLayout
            android:id="@+id/home_vault_chip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_container_tertiary"
            android:backgroundTint="@color/home_chip_vault">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/home_vault_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_24"
                app:tint="@color/home_chip_vault_on" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_vault_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_vault_button"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/home_vault_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="12 items saved"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Trailing chevron — 'enter' affordance for the now-transparent
             card (Safe Folder navigates to VaultActivity, like Downloads). -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/home_vault_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

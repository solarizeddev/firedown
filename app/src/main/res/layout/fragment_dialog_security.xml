<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-site security / protection sheet. FOUR rows, ONE switch:

      identity header  — favicon tile + title + host (the site anchor; stays
                         above the scroller as the drag zone)
      group 1          — Connection is secure / not secure  › (cert details)
                         N blocked on this page            › (uBlock's list)
      group 2          — Block ads and trackers        [switch]
      group 3          — Clear browsing data               ›

    Every row is a selectable MaterialCardView on colorSurfaceContainerLow
    over the sheet's High ground (a rounded ripple; the switch row's whole
    surface toggles the switch, Android-Settings style). Rows that belong
    together are one GROUP — 16dp outer corners, 4dp inner, 2dp apart (the
    ShapeAppearanceOverlay.FireDown.SheetGroup* pair) — so the groups do
    the sectioning and there are no hairline dividers.

    History. The sheet used to carry TWO switches, "Block ads" (uBlock's
    per-host whitelist) and "Tracking protection" (a per-domain ETP
    exception that flipped useTrackingProtection on the tab's session,
    backed by its own Room table). The second was removed: Gecko's
    URL-list tracker blocking is a subset of what the bundled uBlock
    already blocks (EasyPrivacy + cosmetic + scriptlets + CNAME uncloak),
    so as a "this site is broken" lever it was dead weight beside the
    uBlock switch — and the user could not know which engine broke the
    page, so the fix was flip one, reload, flip the other. ETP itself stays
    ON globally at its Settings level (Standard by default); its cookie
    half (third-party cookie policy, partitioning, purging) is engine-only
    and the per-site switch never touched it. The one switch is named for
    what uBlock does, and the count under it already counts trackers.

    The connection row used to sit at the BOTTOM, under the toggles; it is
    the first row now, directly under the identity — the Chrome / Firefox
    order (origin, then connection state, then everything else). A version
    that folded it into the header as a third text line was sketched and
    rejected as forced.

    Ids the fragment binds (host_image, host, host_url, host_secure,
    host_secure_text, ads_stat_card, security_total_count, ads_card,
    ads_toogle, host_clear) — keep them if the rows move again.

    Outer LinearLayout is left unpadded because
    BaseBottomSheetDialogFragment's window-insets listener applies
    padding directly to mView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <!-- Site identity. -->
    <LinearLayout
        android:id="@+id/host_domain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 40dp tinted surface tile with the 24dp favicon centred inside.
             Mirrors the browser popup's identity chip (bg_popup_favicon) so
             the two sheets read as siblings. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/host_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_popup_favicon"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/host"
                style="@style/TextAppearance.Material3.TitleSmall.Emphasized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="CNN" />

            <TextView
                android:id="@+id/host_url"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="www.cnn.com" />

        </LinearLayout>

    </LinearLayout>

    <!-- Body — a NestedScrollView so the full content stays reachable in
         landscape and on short screens. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- ── Group 1: connection + blocked count ────────────────── -->

            <!-- Connection — drill-down to the cert details. Icon and
                 label flip between secure / insecure in the fragment
                 (compound drawable on host_secure_text). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/host_secure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/host_secure_text"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="16dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/connection_secure"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableStartCompat="@drawable/encryption_light_24"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Blocked on this page — "[N] blocked on this page ›", drills
                 into uBlock's per-page blocked-host list
                 (BlockedAdsDetailDialogFragment). security_total_count holds
                 the number; it is onSurface, not coral: the brand coral on
                 this ground is under 3:1 for 16sp text in light theme. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ads_stat_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_shield_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/security_total_count"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="7" />

                    <TextView
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/security_stat_blocked_scope"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Group 2: the one switch ────────────────────────────── -->

            <!-- Block ads and trackers — uBlock's per-host whitelist. The
                 CARD is the tap target (the fragment forwards a card tap
                 to the switch), so the row and the switch are one target,
                 not two. The subtext is the broken-site hint. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ads_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ads_click_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/security_block_ads_trackers"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="2"
                            android:text="@string/protection_panel_etp_toggle_enabled_description_2"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ads_toogle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ── Group 3: clear site data ───────────────────────────── -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/host_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="16dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_clear_browsing"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableStartCompat="@drawable/ic_baseline_delete_24"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>

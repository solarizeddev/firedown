<?xml version="1.0" encoding="utf-8"?>
<!--
    Per-site security / protection sheet:

      identity header  — favicon tile + title + host (the site anchor; stays
                         above the scroller as the drag zone)
      group 1          — the protection banner: the shield's verdict and
                         "N requests blocked on this page"   › (the hosts),
                         then one row per ad blocker (add-on) › (its
                         popup, where its per-site switch is)
      hint             — "Two ad blockers are on…" when more than one runs
      group 2          — "DRM is off   [Turn on]" when the page on screen
                         asked for DRM while it is off (shield's dot)
                         Connection is secure / not secure  › (cert details)
                         Site permissions · 2 allowed     › when the site
                         holds an answer the user gave
      group 3          — Clear browsing data               ›

    Protection leads because the address bar's icon is a shield whose state
    is the blocker's: the sheet opens on what the icon said. On a plain http
    page, or one whose certificate is not secure, group 2 leads instead
    (orderGroups), so "Protection is on" never sits above "Connection is
    not secure".

    Every row is a selectable MaterialCardView on colorSurfaceContainerLow
    over the sheet's High ground; rows that belong together are one GROUP
    (16dp outer corners, 4dp inner, 2dp apart), recomputed in code because
    the blocker rows are added and removed as add-ons change.

    History. The sheet carried a "Block ads and trackers" switch, the
    per-site whitelist of the patched uBlock Firedown bundled. Firedown now
    installs the official uBlock Origin, an ordinary add-on the app cannot
    talk to, so its row opens uBlock's own popup, where its per-site switch
    lives; the address bar's shield reads the result from uBlock's toolbar
    button. The count is the capture extension's, so it counts what any
    blocker refused (and Gecko's own tracker blocking).

    Ids the fragment binds (host_image, host, host_url, host_secure,
    host_secure_text, connection_group, drm_row, drm_row_turn_on,
    site_permissions_row, site_permissions_summary,
    ads_stat_card, protection_banner, protection_title, security_total_count,
    protection_icon, protection_button, protection_chevron, blockers_group, blockers_hint,
    host_clear) — keep them if the rows move again.

    Outer LinearLayout is left unpadded because
    BaseBottomSheetDialogFragment's window-insets listener applies
    padding directly to mView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <!-- Site identity. -->
    <LinearLayout
        android:id="@+id/host_domain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- 40dp tinted surface tile with the 24dp favicon centred inside.
             Mirrors the browser popup's identity chip (bg_popup_favicon) so
             the two sheets read as siblings. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/host_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_popup_favicon"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/host"
                style="@style/TextAppearance.Material3.TitleSmall.Emphasized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="CNN" />

            <TextView
                android:id="@+id/host_url"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="www.cnn.com" />

        </LinearLayout>

    </LinearLayout>

    <!-- Body — a NestedScrollView so the full content stays reachable in
         landscape and on short screens. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- ── Group 1: what is blocked here, and by whom ────────── -->

            <!-- The protection banner, then the fragment's blocker rows
                 (item_blocker_row): each ad blocker add-on, uBlock Origin
                 first. -->
            <LinearLayout
                android:id="@+id/blockers_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- The protection banner (canvas "Shield protection card",
                     board E): the shield's verdict as its title ("Protection
                     is on" / "Protection is off for this site" / "No ad
                     blocker is on", from the same AddonManager.shieldState
                     the address bar's shield reads, so the two cannot
                     disagree), the page's count under it, and a tap into the
                     page's refused hosts (BlockedAdsDetailDialogFragment).
                     On: the logo's peach→coral gradient under dark ink. Off
                     or no blocker: a plain tonal ground, theme inks. The
                     fragment paints the ground (protection_banner) with the
                     card's own corners: the card cannot clip a child to
                     unequal corners before Android 11. Its one button is
                     "Turn on" when no blocker runs, the one switch the app
                     can flip itself; a blocker's per-site switch is in its
                     own popup, the row below. The count is the group's only
                     number: the blocker rows carry no count (an add-on's
                     badge measures something else, and side by side the
                     numbers read as a sum that does not add up). -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ads_stat_card"
                    style="@style/Firedown.Widget.SheetRowCard"
                    android:layout_marginTop="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

                    <LinearLayout
                        android:id="@+id/protection_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/protection_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_shield_24" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/protection_title"
                                style="@style/TextAppearance.Material3.TitleMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="3"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="Protection is on" />

                            <TextView
                                android:id="@+id/security_total_count"
                                style="@style/TextAppearance.Material3.BodyMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="2"
                                tools:text="27 requests blocked on this page" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/protection_button"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/shield_turn_on"
                            android:visibility="gone" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/protection_chevron"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_chevron_right_24" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- More than one blocker runs here: one quiet line, no warning
                 colour (the user chose this). -->
            <TextView
                android:id="@+id/blockers_hint"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- ── Group 2: DRM when the page asked, connection, permissions ───── -->

            <LinearLayout
                android:id="@+id/connection_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sheet_group_gap"
                android:orientation="vertical">

            <!-- "DRM is off": the page on screen asked for DRM while it is
                 off (the dot on the address bar's shield). Shown only then;
                 Turn on answers like the DRM sheet's button
                 (DrmSheetDialogFragment.RESULT_KEY). Not a drill-down: the
                 button is the action, the card itself does nothing. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/drm_row"
                style="@style/Firedown.Widget.SheetRowCard"
                android:layout_marginTop="0dp"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_key_24"
                        app:tint="?attr/brandInk" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/drm_row_title"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/drm_row_summary"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/drm_row_turn_on"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/shield_turn_on" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Connection — drill-down to the cert details. Icon and
                 label flip between secure / insecure in the fragment
                 (compound drawable on host_secure_text). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/host_secure"
                style="@style/Firedown.Widget.SheetRowCard"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/host_secure_text"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="16dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/connection_secure"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableStartCompat="@drawable/encryption_light_24"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- "Site permissions · 2 allowed ›": shown only when the site
                 holds an answer the user gave (location, keeping its data,
                 an embedded site's cookies; SitePermissions decides), so on
                 nearly every site it is absent. Opens the list
                 (SitePermissionsDialogFragment), where each answer has a
                 Reset. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/site_permissions_row"
                style="@style/Firedown.Widget.SheetRowCard"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/tune_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Material3.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/site_permissions_title"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/site_permissions_summary"
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="2 allowed" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ── Group 3: clear site data ───────────────────────────── -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/host_clear"
                style="@style/Firedown.Widget.SheetRowCard"
                android:layout_marginTop="@dimen/sheet_group_gap"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="16dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_clear_browsing"
                        android:textColor="?attr/colorOnSurface"
                        app:drawableStartCompat="@drawable/ic_baseline_delete_24"
                        app:drawableTint="?attr/colorOnSurfaceVariant" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>

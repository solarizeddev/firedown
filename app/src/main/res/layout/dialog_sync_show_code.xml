<?xml version="1.0" encoding="utf-8"?>
<!--
    Recovery-code display for bookmark sync (SyncSettingsFragment, both the
    just-generated and the show-again paths). The grouped code is shown big
    and selectable in a tonal card; there is NO server-side recovery, so the
    warning copy is the point. Copy-to-clipboard is the dialog's action.

    The "I've saved my recovery code" checkbox is shown ONLY on first creation
    (the fragment toggles its visibility) and gates the dialog's Done button —
    so the user must acknowledge they saved the only key before dismissing.
    Hidden when merely viewing the code later (account already set up).

    The QR (sync_code_qr) is the same code in scannable form, for pointing a
    SECOND device's "I have a recovery code" scanner at this one. It is
    COLLAPSED behind a toggle row rather than shown outright, mirroring the P2P
    share screens' "Nearby? Show the QR" pattern — and here the reason is
    sharper than layout economy: this payload is the account's only key, so it
    should not be on screen (shoulder-surfing, a screenshot, a screen recorder)
    until the user asks for it. The whole dialog is already behind the
    device-auth gate; the toggle keeps the exposure deliberate on top of that.

    The QR is deliberately on a WHITE ground in BOTH themes (see QrCodes) — a
    dark-theme inversion is exactly what makes some scanners fail, so the
    padding around it is white, not a theme surface.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_sync_code_warning"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/sync_code_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sync_code"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="16dp"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer"
            tools:text="ABCD-EFGH-JKMN-PQRS-TVWX-YZ23" />

        <!-- QR toggle row: a plain text button, so a collapsed QR costs one
             line. The fragment flips sync_code_qr_group and swaps the label. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_code_qr_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="8dp"
            android:text="@string/settings_sync_code_show_qr" />

        <!-- White ground on purpose, both themes — scanners need the quiet
             zone light. GONE until the toggle is tapped. -->
        <LinearLayout
            android:id="@+id/sync_code_qr_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/sync_code_qr"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/white"
                android:contentDescription="@string/settings_sync_code_qr_desc"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_sync_code_qr_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Shown + gates Done only on first creation (see fragment). -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/sync_code_saved_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_sync_code_saved_check"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>

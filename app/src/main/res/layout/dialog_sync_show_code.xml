<?xml version="1.0" encoding="utf-8"?>
<!--
    Recovery-code display (SyncSettingsFragment, both the just-generated and the
    show-again paths). The grouped code is shown big and selectable in a tonal
    card; there is NO server-side recovery, so the warning copy is the point.

    The "I've saved my recovery code" checkbox is shown ONLY on first creation
    (the fragment toggles its visibility) and gates the dialog's Done button —
    so the user must acknowledge they saved the only key before dismissing.
    Hidden when merely viewing the code later (account already set up).

    TWO PANELS THAT SWAP, NOT STACK. The same code is also offered as a
    scannable QR (for pointing a SECOND device's "I have a recovery code"
    scanner at this one), and "Show QR code" swaps sync_code_panel out for
    sync_code_qr_panel inside THIS dialog. Both earlier shapes were wrong:

      * ADDING the QR below the code (first attempt) made the dialog taller than
        the window. Its button panel is STACKED VERTICALLY — Material stacks when
        the labels don't fit one row, and there are three (Copy / Save to file /
        Done) — so the overflow clipped "Save to file" off the bottom and made it
        unreachable (reported on-device).
      * A SEPARATE QR DIALOG (second attempt) fixed the height but read as a
        dialog stacked on a dialog. Dismissing the reveal to avoid that is NOT an
        option: in create mode this dialog is deliberately non-cancelable with
        Done gated on the checkbox, so dismissing it would let the user back out
        of a freshly minted key without ever acknowledging they saved it — the
        exact hole that gate exists to close — and it would take Copy and
        Save-to-file away while the QR is up.

    Swapping keeps the height at max(code panel, QR panel) instead of their sum,
    which is what the clipping was, and never dismisses anything. The ScrollView
    absorbs a large font scale on top of that.

    The QR sits on a WHITE ground in BOTH themes, with white padding for the
    quiet zone (QrCodes encodes black-on-white and is never theme-tinted): a
    dark-theme inversion, or a QR flush to a dark surface with no quiet zone, is
    what makes some readers fail to lock on.

    EXPOSURE, unchanged by the swap: this payload IS the account, so it stays off
    screen until asked for. The dialog is already behind the device-auth gate;
    the toggle keeps that one extra step deliberate — a QR is the one form a
    bystander or a screen recorder captures in a single frame, where the grouped
    text takes a careful read.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- CODE panel — the default. Swapped out (GONE) while the QR shows, so
             the two never contribute height at the same time. -->
        <LinearLayout
            android:id="@+id/sync_code_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_sync_code_warning"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/sync_code_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sync_code"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="16dp"
                android:textIsSelectable="true"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSecondaryContainer"
                tools:text="ABCD-EFGH-JKMN-PQRS-TVWX-YZ23" />

        </LinearLayout>

        <!-- QR panel — GONE until the toggle is tapped, and it replaces the
             panel above rather than joining it. -->
        <LinearLayout
            android:id="@+id/sync_code_qr_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:id="@+id/sync_code_qr"
                android:layout_width="216dp"
                android:layout_height="216dp"
                android:layout_gravity="center_horizontal"
                android:background="@android:color/white"
                android:contentDescription="@string/settings_sync_code_qr_desc"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_sync_code_qr_hint"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Swaps the two panels above and its own label. Stays visible in both
             states so the QR view has a way back. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_code_qr_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="8dp"
            android:text="@string/settings_sync_code_show_qr" />

        <!-- Shown + gates Done only on first creation (see fragment). Kept
             visible in the QR state too: it is the create flow's only exit
             condition, so hiding it there would make Done look permanently
             stuck. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/sync_code_saved_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_sync_code_saved_check"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>

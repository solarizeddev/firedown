<?xml version="1.0" encoding="utf-8"?>
<!--
    Recovery-code display for bookmark sync (SyncSettingsFragment, both the
    just-generated and the show-again paths). The grouped code is shown big
    and selectable in a tonal card; there is NO server-side recovery, so the
    warning copy is the point. Copy-to-clipboard is the dialog's action.

    The "I've saved my recovery code" checkbox is shown ONLY on first creation
    (the fragment toggles its visibility) and gates the dialog's Done button —
    so the user must acknowledge they saved the only key before dismissing.
    Hidden when merely viewing the code later (account already set up).

    "Show QR code" (sync_code_qr_toggle) offers the same code in scannable form,
    for pointing a SECOND device's "I have a recovery code" scanner at this one.
    It is a BUTTON that opens its own small dialog (dialog_sync_code_qr), NOT an
    expanding section here. Two reasons, and the first is a bug this shipped
    with:

      * HEIGHT. This dialog is already dense — warning copy, a five-line code
        block, THREE buttons (Copy / Save to file / Done) which Material stacks
        vertically because they don't fit on one row, plus the optional "I've
        saved it" checkbox. Expanding a ~200dp image inline pushed the stacked
        button panel off the window: "Save to file" was clipped and unreachable
        (reported on-device). Shrinking the image only moves the failure to a
        large font scale; a separate dialog cannot overflow at any scale.
      * EXPOSURE. This payload is the account's only key, so it should not be on
        screen (shoulder-surfing, a screenshot, a screen recorder) until asked
        for. The whole dialog is already behind the device-auth gate; a discrete
        second step keeps the exposure deliberate on top of that — and a
        dedicated dialog makes it MORE deliberate than an inline reveal, not
        less.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_sync_code_warning"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/sync_code_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sync_code"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="16dp"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer"
            tools:text="ABCD-EFGH-JKMN-PQRS-TVWX-YZ23" />

        <!-- Opens the QR in its OWN dialog (dialog_sync_code_qr) rather than
             expanding here — see the header note. One line of content either
             way, so this dialog's height is unaffected. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_code_qr_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="8dp"
            android:text="@string/settings_sync_code_show_qr" />

        <!-- Shown + gates Done only on first creation (see fragment). -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/sync_code_saved_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_sync_code_saved_check"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom controller layout for PlayerView. Modelled after Media3
  1.10.0's exo_player_control_view.xml
  (libraries/ui/src/main/res/layout/), stripped to the elements this
  single-video viewer actually uses.

  Root is <merge>: children are added directly to PlayerControlView
  (a FrameLayout) — same shape as Media3's default. Media3's region
  IDs are kept so PlayerControlView still recognises and manages the
  regions — but its show/hide ANIMATIONS are now DISABLED
  (app:animation_enabled="false" on the PlayerView): the layout
  manager's per-view translation animators (built for the stock
  layout, where exo_progress sits OUTSIDE the bottom bar) stranded
  the timebar's translationY across a PiP round-trip, leaving the
  scrubber clipped invisible under the pinned 44dp row. See the
  comment on the PlayerView in fragment_media_viewer.xml.

  Two regions, each declared once with @+id so the resource merger
  uniques the name against Media3's library copy:

    - @id/exo_center_controls — centre. exo_play_pause flanked by
      ±10s seek buttons (media_viewer_btn_seek_back /
      media_viewer_btn_seek_forward). MediaViewerFragment wires
      the seek-button click handlers in onCreateView; Media3 finds
      exo_play_pause by reflection and wires playback behaviour
      automatically. Media3's playlist-navigation prev / next
      buttons are intentionally absent (single-file viewer).
    - @id/exo_bottom_bar — bottom. DefaultTimeBar across the full
      width, then a row with "position / duration" and the Subtitles
      and Playback speed buttons, all wrapped so the gradient covers
      both rows. Bottom padding is applied dynamically by
      MediaViewerFragment from WindowInsets.navigationBars().bottom,
      so the rows clear the system nav bar when the bars are shown.

  Dropped from Media3's default (not useful in this viewer):
    exo_controls_background (replaced by gradient on exo_bottom_bar),
    exo_basic_controls (vr / shuffle / repeat / media3's own subtitle
    and settings buttons / fullscreen / overflow_show), exo_extra_controls_scroll_view,
    exo_minimal_controls + exo_minimal_fullscreen,
    exo_media_route_button_placeholder, exo_progress_placeholder
    (we declare exo_progress directly so we can style it),
    exo_rew_with_amount / exo_ffwd_with_amount (and the include
    layouts exo_player_control_rewind_button /
    exo_player_control_ffwd_button).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <!--
          Two ±10s seek buttons flank the play/pause button as the
          discoverable form of the seek action. Double-tap on either
          half of the player is the gesture shortcut for the same
          thing (see MediaViewerFragment.setupDoubleTapSeek). The
          button path seeks silently — the button itself is the
          feedback, no need for the big half-disc burst (which is
          reserved for the gestural double-tap where the user needs
          reassurance that their tap registered).
        -->
        <!--
          BOX SIZES ARE THE SPACING CONTROL HERE, NOT THE MARGINS — the
          margins are already 0. Each button draws a smaller glyph
          inside it, so the dead space inside the box IS the visible
          gap: 8dp on each seek side and 6dp on the play side, i.e.
          14dp of air between glyphs. Both numbers are pinned in this
          file (see the play button's fitCenter note), so changing a
          glyph size without changing its box moves the spacing too.
          At 72dp boxes with an 8dp margin the three controls read as
          unrelated (an earlier pass cut the margin 24 → 8 and barely
          moved it — the margin was never the bulk of it). 64dp play +
          52dp seek + no margin is the current shape. Touch targets stay
          52/64dp, both over the 48dp minimum, and the boxes don't
          overlap so no button can steal its neighbour's taps (which is
          why this is done with box sizes rather than a negative margin
          on play/pause).

          THE ±10s GLYPHS ARE DELIBERATELY SMALLER THAN PLAY/PAUSE
          (36dp vs 52dp) — play is the primary action and every phone
          player ranks it by size, YouTube included (~1.2:1 there).
          Grow the PLAY side to widen that rank, never shrink these
          further: the floor here is the "10" NUMERAL inside the arc,
          and below ~32dp the digits turn to mush and the button stops
          saying how far it seeks. Shrinking a glyph WITHOUT shrinking
          its box would also widen the gap (centerInside centres it, so
          lost glyph becomes dead space) — hence 40 → 36dp glyph AND
          56 → 52dp box together, leaving the 8dp dead space, and
          therefore the spacing, exactly where it was.
        -->
        <ImageButton
            android:id="@+id/media_viewer_btn_seek_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_seek_back_10s_desc"
            android:scaleType="centerInside"
            android:src="@drawable/ic_media_replay_10_24" />

        <!--
          media3's PlayerControlView OVERWRITES this src at runtime with
          its own styled-controls play/pause icon (a filled disc), so the
          drawable below is only the pre-attach placeholder — it is NOT
          what renders. To change the rendered icon itself, use the
          controller's play_icon / pause_icon attributes, not this src.

          scaleType is fitCenter, NOT centerInside, and that is the whole
          point: centerInside only ever scales DOWN, so the rendered size
          was media3's intrinsic icon size — a number this layout doesn't
          control and can't see. The ±10s glyphs were sized against it by
          guesswork, and a 40 → 36dp step on them produced no visible
          change on device because the ratio's other half was unknown.
          fitCenter scales UP too, so 64dp box − 6dp padding pins the
          rendered disc at exactly 52dp whatever media3 ships, and the
          rank is set here rather than by a dependency: 52dp play against
          36dp seek is ~1.45:1, comfortably past the ~1.2:1 phone players
          use. It also fixes the play side's dead space at 6dp, so the
          gap below is now fully determined by this file.
        -->
        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/media_action_play" />

        <ImageButton
            android:id="@+id/media_viewer_btn_seek_forward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_seek_forward_10s_desc"
            android:scaleType="centerInside"
            android:src="@drawable/ic_media_forward_10_24" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_media_viewer_controller"
        android:paddingTop="16dp">

        <!--
          Two rows, the YouTube shape: the timebar across the full width,
          and under it the time on the start side and the playback
          controls on the end side, all bare white glyphs of one size.

          The column's height is PINNED (80dp = 28dp timebar + 48dp row +
          4dp) and anchored to the bar's bottom, for the reason the old
          single 44dp row was: PlayerControlView passed this region an
          EXACTLY spec after a PiP exit that, under wrap_content, measured
          it several times its children's height (#103's logs). Animations
          are off now, but the pin costs nothing and keeps the controls
          flush above the navigation bar whatever the bar is handed.

          Horizontal padding is 8dp, not 16: DefaultTimeBar insets its
          line by half the dragged scrubber (8dp), so the line starts 16dp
          in, and the row pads 8dp more so the time text starts there too.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <!--
              @+id (not @id) so the app's own R carries the name:
              android.nonTransitiveRClass=true means R only lists
              resources this module DECLARES, and MediaViewerFragment
              has to find this view to attach its scrub-preview
              listener. The resource merger uniques the name against
              Media3's library copy — same trick the region ids above
              use, and PlayerControlView still finds its timebar (it
              resolves the same merged id).
            -->
            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                app:played_color="@color/brand_orange"
                app:scrubber_color="@color/brand_orange" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp">

                <TextView
                    android:id="@id/exo_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:text="@string/player_time_separator"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@id/exo_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp" />

                <!--
                  Subtitles: the sheet of tracks (Off, every track, add a
                  file). The 3dp line under the glyph is lit while a track
                  is showing (MediaViewerFragment.updateSubtitlesIndicator),
                  YouTube's "captions on" mark. GONE for audio and in the
                  backup stream player, which has no subtitles.
                -->
                <FrameLayout
                    android:id="@+id/media_viewer_subtitles_slot"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/media_viewer_btn_subtitles"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/player_subtitles"
                        android:scaleType="center"
                        android:src="@drawable/subtitles_24"
                        app:tint="@android:color/white" />

                    <View
                        android:id="@+id/media_viewer_subtitles_on"
                        android:layout_width="20dp"
                        android:layout_height="3dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="9dp"
                        android:background="@drawable/bg_player_subtitles_on"
                        android:importantForAccessibility="no"
                        android:visibility="invisible" />
                </FrameLayout>

                <!--
                  Playback speed as bare text ("1×", "1.5×"), not an icon:
                  the value is what the button is for. Coral while it is not
                  1×, the same mark as the subtitles line. Its spoken name is
                  "Playback speed" with the value as its state.
                -->
                <TextView
                    android:id="@+id/media_viewer_btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_speed"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</merge>
<?xml version="1.0" encoding="utf-8"?>
<!--
  Tracking-protection detail sheet. Opened by tapping the status row on the
  Enhanced Tracking Protection settings screen. Data is Gecko's persisted
  ETP database (ContentBlockingController).

  Styled to match the Home trackers sheet (fragment_dialog_trackers_info):
  a single total counter, an uppercase "Blocked by type" header, and clean
  label -> count rows (the TrackersInfoBreakdown* styles). Deliberately NO
  hero glyph and NO per-row progress bars — those read as a different, busier
  design. The category breakdown is of the all-time total; "Recording since"
  keeps the figure honest.

  Not a scroll surface — intrinsic height under the drag handle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/td_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="?attr/colorPrimary"
            tools:text="128" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/tracking_detail_total_label"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/td_since"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Recording since Jul 22, 2026" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.08"
            android:text="@string/trackers_info_section_breakdown"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceTitleSmallEmphasized"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout style="@style/TrackersInfoBreakdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView style="@style/TrackersInfoBreakdownLabel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/tracking_cat_cookies" />
            <TextView android:id="@+id/td_cnt_cookies" style="@style/TrackersInfoBreakdownCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                tools:text="47" />
        </LinearLayout>

        <LinearLayout style="@style/TrackersInfoBreakdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView style="@style/TrackersInfoBreakdownLabel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/tracking_cat_social" />
            <TextView android:id="@+id/td_cnt_social" style="@style/TrackersInfoBreakdownCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                tools:text="12" />
        </LinearLayout>

        <LinearLayout style="@style/TrackersInfoBreakdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView style="@style/TrackersInfoBreakdownLabel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/tracking_cat_fingerprinters" />
            <TextView android:id="@+id/td_cnt_fp" style="@style/TrackersInfoBreakdownCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                tools:text="8" />
        </LinearLayout>

        <LinearLayout style="@style/TrackersInfoBreakdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView style="@style/TrackersInfoBreakdownLabel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/tracking_cat_cryptominers" />
            <TextView android:id="@+id/td_cnt_crypto" style="@style/TrackersInfoBreakdownCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                tools:text="0" />
        </LinearLayout>

        <LinearLayout style="@style/TrackersInfoBreakdownRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView style="@style/TrackersInfoBreakdownLabel"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/tracking_cat_content" />
            <TextView android:id="@+id/td_cnt_content" style="@style/TrackersInfoBreakdownCount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                tools:text="61" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>

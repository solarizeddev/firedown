<?xml version="1.0" encoding="utf-8"?>
<!--
  Tracking-protection detail sheet — Firedown's take on Firefox's
  "Trackers blocked this week" protection panel. Opened by tapping the
  status row on the Enhanced Tracking Protection settings screen. All
  data is Gecko's persisted ETP database (ContentBlockingController):
  a this-week hero total, a per-category breakdown (icon + count + a
  proportion bar), and an all-time "since <date>" footer.

  Our tonal style, not Firefox's gradient: the footprint accent (the
  app's ETP glyph) + colorPrimary, surfaceContainer category cards. Not
  a scroll surface — laid out at intrinsic height under the drag handle
  (the TrackersInfoSheet convention).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:src="@drawable/footprint_24"
            android:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/td_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="?attr/colorPrimary"
            tools:text="73" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="@string/tracking_detail_week_label"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/td_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/td_since"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="136 trackers blocked since 29 June 2026" />
    </LinearLayout>
</LinearLayout>

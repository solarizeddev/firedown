<?xml version="1.0" encoding="utf-8"?>
<!-- Capture help page — a child of the holder sheet, so it must be
     WRAP-HONEST like every pushed page (the holder sizes the sheet per page,
     see applyContentHeightForPage): a plain top-down column the sheet hugs.
     The previous shape centered the illustration against a FULL-height root
     (texts hung above it by bottom-constraints), which collapsed into
     misaligned stacking once the frame wrapped. The X overlays the top-end
     corner over the title's side padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/empty_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/list_spacing"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="@dimen/empty_text_padding"
            android:paddingEnd="@dimen/empty_text_padding"
            android:text="@string/empty_media_help_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/list_spacing"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:paddingStart="@dimen/empty_text_padding"
            android:paddingEnd="@dimen/empty_text_padding"
            android:text="@string/empty_media_help"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/empty_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/empty_image_height_big"
            app:srcCompat="@drawable/ill_small_playmedia" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/list_spacing"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:paddingStart="@dimen/empty_text_padding"
            android:paddingEnd="@dimen/empty_text_padding"
            android:text="@string/empty_media_subtitle_help"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel_button"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/list_spacing"
        app:icon="@drawable/ic_baseline_close_24" />

</FrameLayout>

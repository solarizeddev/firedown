<?xml version="1.0" encoding="utf-8"?>
<!-- Capture help page — a child of the holder sheet, so it must be
     WRAP-HONEST like every pushed page (the holder sizes the sheet per page,
     see applyContentHeightForPage): a plain top-down column the sheet hugs.
     The previous shape centered the illustration against a FULL-height root
     (texts hung above it by bottom-constraints), which collapsed into
     misaligned stacking once the frame wrapped. No close button: system Back
     pops the page (the holder's OnBackPressedCallback) and swipe-down
     dismisses the sheet — an X duplicated both (maintainer's call). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/empty_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/list_spacing"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingStart="@dimen/empty_text_padding"
        android:paddingEnd="@dimen/empty_text_padding"
        android:text="@string/empty_media_help_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/empty_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/list_spacing"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:paddingStart="@dimen/empty_text_padding"
        android:paddingEnd="@dimen/empty_text_padding"
        android:text="@string/empty_media_help"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/empty_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/empty_image_height_big"
        app:srcCompat="@drawable/ill_small_playmedia" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_spacing"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:paddingStart="@dimen/empty_text_padding"
        android:paddingEnd="@dimen/empty_text_padding"
        android:text="@string/empty_media_subtitle_help"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>

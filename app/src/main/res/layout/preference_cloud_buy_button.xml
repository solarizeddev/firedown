<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom layout for the "Add storage credit" Preference on the merged Cloud
  screen — the ONE prominent action, a filled CTA directly under the status
  hero (pay-per-use storage is the screen's primary job; plain rows read as
  secondary). The BUTTON is deliberately non-clickable/non-focusable: the
  Preference row owns the click (SyncSettingsFragment routes it to the buy
  flow), the button is purely the visual; duplicateParentState keeps its
  pressed ripple in step with the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="2dp"
    android:paddingBottom="10dp">

    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/buy_credit_title"
        android:clickable="false"
        android:focusable="false"
        android:duplicateParentState="true"
        app:icon="@drawable/add_24"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        app:cornerRadius="14dp" />

</LinearLayout>

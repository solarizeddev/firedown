<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom layout for the MORPHING CTA Preference on the merged Cloud screen —
  the ONE prominent action, a filled button directly under the status hero.
  Its label is the Preference TITLE (the button carries @android:id/title —
  MaterialButton IS a TextView, so the standard Preference title binding
  drives it): SyncSettingsFragment sets "Create recovery code" pre-key and
  "Add storage credit" once a key exists, so the button always shows the
  next onboarding step. The BUTTON is deliberately non-clickable/
  non-focusable: the Preference row owns the click; duplicateParentState
  keeps its pressed ripple in step with the row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="2dp"
    android:paddingBottom="10dp">

    <com.google.android.material.button.MaterialButton
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:duplicateParentState="true"
        app:icon="@drawable/add_24"
        app:iconSize="18dp"
        app:iconGravity="textStart"
        app:cornerRadius="14dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Certificate sheet. Root is a LinearLayout (match_parent) with a pinned top
  (drag handle + security-status header) and a pinned bottom (Copy PEM
  button); only the cert sections in between scroll, via a weighted
  NestedScrollView. This keeps the primary action (Copy PEM) always visible
  instead of below the fold on the many-section certs that exceed
  bottom_sheet_max_height — only the long detail content scrolls, as it
  should.

  Each section is a GROUP LABEL over ONE sheet card (the grouped-card shape
  every sheet uses — Firedown.Widget.SheetRowCard; see the security sheet):
  Subject / Issuer / Validity are static cards of label:value rows (a row
  whose value is empty is hidden by the fragment INSIDE the card, so no
  corner bookkeeping is needed — the card is one surface), and Technical
  details / Fingerprints / Subject Alt Names are COLLAPSIBLE cards whose
  header row is the card itself (tap anywhere → the content expands below
  it, inside the same card). The hairlines that used to bracket the
  scroller are gone — the cards do the sectioning; the ids the fragment
  binds (section_*, row_*, cert_sans_list, section_*_arrow, btn_copy_pem,
  anchor_view) are unchanged, with the collapsible HEADER ids now on the
  cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <include layout="@layout/dialog_drag_handle" />

    <!-- ============================================================ -->
    <!-- Header: Security Status Banner (pinned)                      -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/cert_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/cert_status_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_lock_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cert_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Connection is Secure" />

            <TextView
                android:id="@+id/cert_status_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                tools:text="*.google.com · Extended Validation" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable cert sections. 0dp + weight so it absorbs the leftover
         space between the pinned header and footer; only this region
         scrolls when the cert has many sections. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

        <!-- ── Subject ── -->
        <LinearLayout
            android:id="@+id/section_subject"
            style="@style/Firedown.Widget.SheetGroup"
            android:layout_marginTop="0dp">

            <TextView
                style="@style/Firedown.PopupGroupLabel"
                android:text="@string/cert_section_subject" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Firedown.Widget.SheetRowCard"
                android:clickable="false"
                android:focusable="false"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <include
                        android:id="@+id/row_subject_cn"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_subject_org"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_subject_ou"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_subject_country"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ── Issuer ── -->
        <LinearLayout
            android:id="@+id/section_issuer"
            style="@style/Firedown.Widget.SheetGroup"
            android:layout_marginTop="10dp">

            <TextView
                style="@style/Firedown.PopupGroupLabel"
                android:text="@string/cert_section_issuer" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Firedown.Widget.SheetRowCard"
                android:clickable="false"
                android:focusable="false"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <include
                        android:id="@+id/row_issuer_cn"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_issuer_org"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_issuer_country"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ── Validity ── -->
        <LinearLayout
            android:id="@+id/section_validity"
            style="@style/Firedown.Widget.SheetGroup"
            android:layout_marginTop="10dp">

            <TextView
                style="@style/Firedown.PopupGroupLabel"
                android:text="@string/cert_section_validity" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Firedown.Widget.SheetRowCard"
                android:clickable="false"
                android:focusable="false"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <include
                        android:id="@+id/row_valid_from"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_valid_to"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_days_remaining"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ── Technical details (collapsible) ── -->
        <LinearLayout
            style="@style/Firedown.Widget.SheetGroup">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_technical_header"
                style="@style/Firedown.Widget.SheetRowCard"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- The header ROW: the section title and the expand
                         arrow. The CARD is the tap target (setupCollapsible
                         listens on it) — a tap toggles the content below
                         inside the same card and rotates the arrow. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:text="@string/cert_section_technical"
                            style="@style/Firedown.Widget.SheetRowText"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:minHeight="0dp"
                            android:paddingHorizontal="0dp" />

                        <ImageView
                            android:id="@+id/section_technical_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/expand_more_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/section_technical_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                    <include
                        android:id="@+id/row_version"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_serial"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_sig_alg"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_pub_key"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_mixed_content"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ── Fingerprints (collapsible) ── -->
        <LinearLayout
            style="@style/Firedown.Widget.SheetGroup">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_fingerprints_header"
                style="@style/Firedown.Widget.SheetRowCard"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- The header ROW: the section title and the expand
                         arrow. The CARD is the tap target (setupCollapsible
                         listens on it) — a tap toggles the content below
                         inside the same card and rotates the arrow. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:text="@string/cert_section_fingerprints"
                            style="@style/Firedown.Widget.SheetRowText"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:minHeight="0dp"
                            android:paddingHorizontal="0dp" />

                        <ImageView
                            android:id="@+id/section_fingerprints_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/expand_more_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/section_fingerprints_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                    <include
                        android:id="@+id/row_sha256"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/row_sha1"
                        layout="@layout/fragment_dialog_cert_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ── Subject Alt Names (collapsible) ── -->
        <LinearLayout
            android:id="@+id/section_sans_wrapper"
            style="@style/Firedown.Widget.SheetGroup">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section_sans_header"
                style="@style/Firedown.Widget.SheetRowCard"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupSingle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- The header ROW: the section title and the expand
                         arrow. The CARD is the tap target (setupCollapsible
                         listens on it) — a tap toggles the content below
                         inside the same card and rotates the arrow. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/section_sans_title"
                            tools:text="Subject Alt Names (126)"
                            style="@style/Firedown.Widget.SheetRowText"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:minHeight="0dp"
                            android:paddingHorizontal="0dp" />

                        <ImageView
                            android:id="@+id/section_sans_arrow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/expand_more_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/cert_sans_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="12dp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textIsSelectable="true"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="*.google.com\n*.youtube.com\n..."
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============================================================ -->
    <!-- Action: Copy PEM (pinned footer — always visible)            -->
    <!-- ============================================================ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_copy_pem"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/cert_copy_pem"
        app:icon="@drawable/ic_content_copy" />

    <View
        android:id="@+id/anchor_view"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

</LinearLayout>

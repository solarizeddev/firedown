<?xml version="1.0" encoding="utf-8"?>
<!--
  Trailing 'Add a shortcut' tile rendered by ShortCutsAdapter after
  the last real entry. Same outer dimensions as fragment_web_visited_item.xml
  so the grid spacing stays uniform; root id differs (item_web_visited_add)
  so HomeFragment.onItemClick can route the click to the Add flow
  instead of the open-shortcut flow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="104dp"
    android:orientation="vertical">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item_web_visited_add"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        app:cardCornerRadius="8dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/list_web_image_height"
            android:layout_height="@dimen/list_web_image_height"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/add_24"
            app:tint="?attr/colorOnSurfaceVariant" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_spacing"
        android:layout_gravity="bottom|center"
        android:ellipsize="marquee"
        android:gravity="center"
        android:singleLine="true"
        android:text="@string/home_shortcuts_add_tile"
        android:textColor="?attr/colorOnSurfaceVariant"
        style="@style/TextAppearance.Material3.LabelMedium" />

</LinearLayout>

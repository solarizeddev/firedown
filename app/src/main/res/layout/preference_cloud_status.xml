<?xml version="1.0" encoding="utf-8"?>
<!--
  The Cloud Backup status hero (custom Preference layout, bound by
  CloudStatusPreference). One card, four states:

    A · unmetered beta   — big backed-up size + usage bar vs the included cap
                           (the one REAL byte denominator; the bar binds only
                           here)
    B · metered, funded  — ONE model, time: backed-up-size headline + the
                           compact CREDIT METER (cb_meter) — a thin gauge of
                           credit REMAINING, labelled with the runway time. No
                           plan chip, no % -of-plan bar (the "plan" was an
                           invented shape — see CloudStatusPreference). No
                           projection → a full meter + the credit-active label.
    C · grace/read-only  — amber data ink + the top-up-by deadline
    D · not set up       — dashed empty state pointing at the ⋮ backup action

  The bar/timeline are the only accent ink (coral; amber in grace) — chrome
  stays neutral.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <!-- ── set-up hero ── -->
    <LinearLayout
        android:id="@+id/cb_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- baselineAligned keeps the small unit label sitting on the big
                 number's baseline. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/cb_big"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="1.2 GB" />

                <TextView
                    android:id="@+id/cb_big_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="backed up" />
            </LinearLayout>

            <TextView
                android:id="@+id/cb_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_cloud_chip"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Free during the beta" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/cb_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:trackThickness="8dp"
            app:trackCornerRadius="4dp"
            tools:progress="12" />

        <TextView
            android:id="@+id/cb_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="23 files · of 50 GB included · encrypted end-to-end" />

        <!-- Grace: the read-only + top-up-by line (the runway goes amber).
             Metered with NO runout projection: the "credit active — lasts for
             years at this usage" line, the funded account's only credit voice
             once the plan chip/% bar were deleted. -->
        <TextView
            android:id="@+id/cb_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Your credit ran out. Top up by Aug 30, 2026 — your files stay restorable until then, but nothing new is backed up." />

        <!-- metered only: the compact CREDIT METER — a thin gauge of prepaid
             credit REMAINING (full = healthy, drains as runout nears; amber in
             grace) with the runway TIME as its label. It borrows the familiar
             Dropbox/Drive thin-bar SHAPE but never a used-of-cap denominator:
             metered mode has NO cap, so a "used of total" bar would be a lie
             (the reason the earlier bars were pulled). The fill is credit LEFT,
             saturating at a year (cb_meter_bar), so a well-funded account reads
             full and only visibly drains near runout — a fuel gauge, not a
             storage bar. This replaced the Today→date CloudTimelineView
             (removed) at the maintainer's request for a simpler, more
             recognizable meter; the runout math + strings are reused, so no new
             translations. -->
        <LinearLayout
            android:id="@+id/cb_meter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/cb_meter_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trackThickness="7dp"
                app:trackCornerRadius="4dp"
                tools:progress="78" />

            <TextView
                android:id="@+id/cb_meter_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="≈ 3 years of coverage" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── D · not set up: the onboarding ROADMAP ──
         Three numbered steps that check off as the account progresses
         (① recovery code → ② storage credit → ③ first backup), bound by
         CloudStatusPreference.bindOnboardingSteps: a done step gets a "✓"
         prefix + muted ink, the next pending step keeps full-contrast ink.
         The step texts reuse existing strings (the create/buy row titles +
         the old empty-state body), so no new translations. -->
    <LinearLayout
        android:id="@+id/cb_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_cloud_empty_dashed"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_cloud_upload_24"
                android:alpha="0.55"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:text="@string/cloud_status_empty_title"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/cb_step_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/colorOnSurface"
            tools:text="1 · Create recovery code" />

        <TextView
            android:id="@+id/cb_step_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="2 · Add storage credit" />

        <TextView
            android:id="@+id/cb_step_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12.5sp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="3 · Back up any finished download from its ⋮ menu" />
    </LinearLayout>

</LinearLayout>

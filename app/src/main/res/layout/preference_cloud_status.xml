<?xml version="1.0" encoding="utf-8"?>
<!--
  The Backup status card (custom Preference layout, bound by
  CloudStatusPreference). The Signal "Secure Backups" shape: one card, the
  words on the start side, a glyph on a disc on the end side, and at most one
  button, inside the card. Every state is the same four views:

    not set up   — "Back up your downloads", one line, [Set up backup]
    set up       — "On <place>" over "854 MB backed up", "14 files ·
                   encrypted end-to-end" (or "Nothing backed up yet" and the
                   ⋮-menu hint), no button
    folder lost  — "On <place>" over "Can't reach your backup folder" in the
                   error ink, what to do, [Choose the folder again] /
                   [Reconnect]

  It replaced a numbered roadmap (① code → ② folder → ③ first backup) and a
  separate button row under the card: the button now creates the code and
  goes straight on to "Where to back up", so the user sees one step.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Where the backup is ("On Google Drive › Backups"); gone
                     while nothing is set up. -->
                <TextView
                    android:id="@+id/cb_eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="On Google Drive › Backups"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/cb_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="854 MB backed up" />

                <!-- One line under the title: the file count, the hint, what
                     to do when the folder is lost, or a running transfer. -->
                <TextView
                    android:id="@+id/cb_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="14 files · encrypted end-to-end" />

                <!-- The card's one action, when one is owed. Clicks are
                     wired by CloudStatusPreference; the preference row
                     itself is not selectable. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cb_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    tools:text="@string/backup_hero_setup_cta"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- The glyph on a tonal disc, Signal's illustration slot. -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_empty_disc"
                android:importantForAccessibility="noHideDescendants">

                <ImageView
                    android:id="@+id/cb_glyph"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/cloud_upload_24"
                    app:tint="?attr/brandInk"
                    tools:ignore="ContentDescription" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>

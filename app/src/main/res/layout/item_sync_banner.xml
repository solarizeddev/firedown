<?xml version="1.0" encoding="utf-8"?>
<!--
  Header for WebBookmarkFragment's RecyclerView, shown via SyncBannerAdapter when
  bookmark sync is OFF and the announce banner hasn't been dismissed (and not in
  incognito). Card tap opens the sync screen; the X retires it permanently.
  One-time: dismiss flag + enabling sync both retire it (SYNC_BANNER_DISMISSED).

  Card look (corner/elevation/stroke + the code-set brand wash) matches
  RestoreBannerAdapter, but the OUTER box is tuned for the BOOKMARK list, which
  (unlike the empty-only Downloads restore banner) sits above populated rows:
  - NO layout_marginHorizontal — the row decoration's 8dp gutter alone insets the
    card, so it spans the same width as the bookmark rows (whose cards are
    transparent + decoration-inset the same way).
  - paddingStart=8dp + a 28dp icon (list_web_image_height) put the cloud in the
    SAME 16dp-from-edge column as the row favicons (8dp decoration + 8dp inset),
    and the 12dp text margin then aligns the title with the bookmark titles.
  - marginBottom=0 (NOT the restore banner's -12dp incognito_banner_margin_bottom,
    which would pull the first row up and read cramped here): the decoration's
    half-spacing gives the normal ~8dp card-to-card gap.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/list_spacing"
    android:layout_marginBottom="0dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/sync_banner_icon"
            android:layout_width="@dimen/list_web_image_height"
            android:layout_height="@dimen/list_web_image_height"
            android:contentDescription="@null"
            android:src="@drawable/cloud_24"
            app:tint="?attr/colorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/sync_banner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/sync_banner_title"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintStart_toEndOf="@id/sync_banner_icon"
            app:layout_constraintEnd_toStartOf="@id/sync_banner_close"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="@string/sync_banner_subtitle"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.8"
            app:layout_constraintStart_toEndOf="@id/sync_banner_icon"
            app:layout_constraintEnd_toStartOf="@id/sync_banner_close"
            app:layout_constraintTop_toBottomOf="@id/sync_banner_title" />

        <!-- Dismiss is its own touch target; the rest of the card opens sync. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/sync_banner_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_dismiss"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

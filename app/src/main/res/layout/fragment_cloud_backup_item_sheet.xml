<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-item bottom sheet for a backed-up file. Drag handle + a rich header (the
  file's preview thumbnail + name + 'MIME · size · date', mirroring the list row)
  + one group of grouped sheet cards (Open / Restore / Remove — the shape every
  option sheet uses, see Firedown.Widget.SheetRowCard; no hairline, the group
  does the sectioning). "Remove from cloud" uses the SheetRowText.Final
  (destructive) style — colorPrimary text + tint, the same treatment the
  popup/option sheets give their destructive row — unlike the neutral
  "Restore". The Open row is revealed at runtime, so the fragment recomputes
  the group's corners (SheetGroups.applyCorners on cb_sheet_actions) after
  showing it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <include layout="@layout/dialog_drag_handle" />

    <!-- Header: thumbnail + name + meta, like a list row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/cb_sheet_thumb"
            android:layout_width="@dimen/list_download_image_width"
            android:layout_height="@dimen/list_download_image_height"
            android:background="@drawable/mask_image_rounded"
            android:contentDescription="@null"
            android:outlineProvider="background"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cb_sheet_title"
                style="@style/TextAppearance.Material3.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/cb_sheet_meta"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cb_sheet_actions"
        style="@style/Firedown.Widget.SheetGroup"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="0dp">

        <!-- "Open" — revealed only once a background probe finds a LOCAL copy
             of this file (name+size in the download table, the engine's own
             dedup key). Cloud bytes are E2E-encrypted chunks, so opening a
             cloud-only entry IS the restore flow — the row below stays that
             door. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cb_sheet_open"
            style="@style/Firedown.Widget.SheetRowCard"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop"
            tools:visibility="visible">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/open"
                app:drawableStartCompat="@drawable/ic_open_in_new_24" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cb_sheet_restore"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

            <TextView
                style="@style/Firedown.Widget.SheetRowText"
                android:text="@string/cloud_backup_item_restore"
                app:drawableStartCompat="@drawable/settings_backup_restore_24" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cb_sheet_remove"
            style="@style/Firedown.Widget.SheetRowCard"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

            <TextView
                style="@style/Firedown.Widget.SheetRowText.Final"
                android:text="@string/cloud_backup_item_remove"
                app:drawableStartCompat="@drawable/ic_baseline_delete_24" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Shown only when this file is gone from the device, so Remove above
         destroys the last copy. This is where the list row's old "Not on this
         device" tail moved: that marker rendered on nearly every row of an
         established install and so carried no information, while HERE the same
         fact is stated once, at the moment it changes a decision. Sits UNDER
         Remove deliberately — it qualifies that row, and putting it above would
         push the two actions down on every sheet that shows it. -->
    <TextView
        android:id="@+id/cb_sheet_only_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="32dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/cloud_backup_only_copy"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>

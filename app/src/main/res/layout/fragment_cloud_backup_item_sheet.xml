<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-item bottom sheet for a backed-up file (Restore / Remove). Drag handle +
  the file name header + two M3 56dp option rows, matching the Downloads options
  sheet styling (Firedown.Widget.DialogOption).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <include layout="@layout/dialog_drag_handle" />

    <TextView
        android:id="@+id/cb_sheet_title"
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/cb_sheet_restore"
        style="@style/Firedown.Widget.DialogOption"
        android:text="@string/cloud_backup_item_restore"
        app:drawableStartCompat="@drawable/settings_backup_restore_24"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/cb_sheet_remove"
        style="@style/Firedown.Widget.DialogOption"
        android:text="@string/cloud_backup_item_remove"
        app:drawableStartCompat="@drawable/ic_baseline_delete_24"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Trackers + ads info sheet. Spawned from the Home 'Trackers and
  ads blocked' card. Three jobs:

    - Make the privacy work the app does visible. The card itself
      is a small subtitle line; this sheet shows the number big
      and explains what it represents.
    - Tell the user *what* is being blocked — trackers, ads,
      cookie notices, etc. — so the metric is meaningful instead
      of a vanity counter.
    - Give a single clear CTA to the surface where the user can
      adjust protection (Settings → Enhanced Tracking Protection).

  Outer LinearLayout owns the sticky drag handle; the ScrollView
  below holds the rest so content can grow past the sheet height
  on small screens / landscape without clipping the handle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/dialog_drag_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">


        <!--
            Brand flame on a colorPrimaryContainer chip in place of
            the former 120dp privacy illustration. A bare 40dp shield
            read flat and generic; the tonal chip + flame combo
            anchors 'Firedown is protecting you' through identity
            rather than literal iconography, and re-uses the same
            64dp container / 32dp glyph rhythm used on the home
            cards' leading slots so the visual language is consistent.
            The protection semantic is carried by the sheet's title
            and copy below, so the icon's job is character, not
            redundant shield-imagery.
        -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_circle_primary">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_firedown"
                app:tint="?attr/colorOnPrimaryContainer" />

        </FrameLayout>

        <!-- Big number: '12,345' or 'Protection active' placeholder
             when zero. Adapter swaps the binding at runtime. -->
        <TextView
            android:id="@+id/trackers_info_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="?attr/colorPrimary"
            tools:text="12,345" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/trackers_info_count_label"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <!-- Estimated bytes saved — only visible when count > 0,
             otherwise zero * 50KB is meaningless. -->
        <TextView
            android:id="@+id/trackers_info_saved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="~580 MB of bandwidth saved"
            tools:visibility="visible" />

        <!-- Today vs all-time framing — derived from the cumulative
             counter with a midnight baseline (no per-event storage,
             see GeckoUblockHelper). Hidden when today's count is
             zero so the sheet doesn't render a redundant '0 today'
             on first launch or a quiet day. -->
        <TextView
            android:id="@+id/trackers_info_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="1,234 today"
            tools:visibility="visible" />

        <!-- Per-category breakdown. Four rows (Scripts / Pixels /
             Frames / Other) that show what kinds of requests the
             hero number above is composed of. Counts come from
             GeckoUblockHelper.getCategoryBlockedLive(); firedown.js
             buckets by fctxt.itype because uBlock's static engine
             doesn't preserve filter-list origin at runtime.

             Whole block hidden until the cumulative count is non-zero
             — same trigger as the bytes-saved line above — so a
             fresh install doesn't render four zeroes.

             Each row is a label-and-count pair; the label hugs the
             start, the count hugs the end with a tabular numeric
             style so the digit columns line up across rows. -->
        <LinearLayout
            android:id="@+id/trackers_info_breakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                style="@style/TrackersInfoBreakdownRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TrackersInfoBreakdownLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trackers_info_breakdown_scripts" />

                <TextView
                    android:id="@+id/trackers_info_breakdown_scripts"
                    style="@style/TrackersInfoBreakdownCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="8,421" />
            </LinearLayout>

            <LinearLayout
                style="@style/TrackersInfoBreakdownRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TrackersInfoBreakdownLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trackers_info_breakdown_pixels" />

                <TextView
                    android:id="@+id/trackers_info_breakdown_pixels"
                    style="@style/TrackersInfoBreakdownCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2,103" />
            </LinearLayout>

            <LinearLayout
                style="@style/TrackersInfoBreakdownRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TrackersInfoBreakdownLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trackers_info_breakdown_frames" />

                <TextView
                    android:id="@+id/trackers_info_breakdown_frames"
                    style="@style/TrackersInfoBreakdownCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="389" />
            </LinearLayout>

            <LinearLayout
                style="@style/TrackersInfoBreakdownRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/TrackersInfoBreakdownLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/trackers_info_breakdown_other" />

                <TextView
                    android:id="@+id/trackers_info_breakdown_other"
                    style="@style/TrackersInfoBreakdownCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1,432" />
            </LinearLayout>

        </LinearLayout>

        <!-- Categories caption — what 'blocked' actually covers, as
             a short comma-list rather than a paragraph. 8dp gap so
             it reads as a natural continuation of the stat block
             above, not a floating element. Translation length is
             bounded by 4 short nouns so it stays on one or two
             lines in every locale. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/trackers_info_categories"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/trackers_info_action"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/trackers_info_action" />

    </LinearLayout>

    </ScrollView>

</LinearLayout>

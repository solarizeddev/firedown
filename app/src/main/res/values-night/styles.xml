<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FireDown.BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <!-- Overlay, never a full theme: see values/styles.xml. -->
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainerHigh</item>
        <item name="bottomSheetStyle">@style/Theme.FireDown.BottomSheetDialogStyle</item>
        <item name="actionOverflowButtonStyle">@style/Theme.FireDown.Toolbar.ActionMode.Overflow</item>
    </style>

    <style name="Firedown.Widget.App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Chip</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="ThemeOverlay.App.Chip" parent="">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/transparent</item>
        <!-- Checked filter chip = the BRAND, not the secondary ramp.
             Widget.Material3.Chip.Filter paints its selected state from
             colorSecondaryContainer, which in this palette is an apricot
             (#FFBF9B / #FAB186) — visibly a different hue family from the
             brand #f0716c, so the one permanently-visible "active" control
             on the screen was the one thing not wearing the brand. (The
             palette itself is inconsistent: md_theme_secondary IS #f0716c,
             but its container tone drifted off that base.)

             Remapped rather than reimplemented: the library keeps owning the
             enabled/checked/disabled selector logic, and both rails' chips
             (Captured via Firedown.Widget.App.Chip.Filter, Downloads via
             Theme.FireDown.Download.Chip and its chip_download selector,
             which also resolves ?attr/colorSecondaryContainer) pick the swap
             up from this one place. The label follows via
             colorOnSecondaryContainer so the pair can never disagree.

             NOT colorPrimary: #f0716c under a white label is 2.88:1, below
             the 4.5:1 floor.

             The values live in @color/chip_checked_container rather than
             ?attr/colorPrimaryContainer because the two themes want different
             things. LIGHT takes the container tone verbatim (#FF857F, label
             7.06:1) — a hue correction with no legibility change from the
             apricot it replaced. DARK does not: this palette's dark container
             (#F66A66) is within a hair of primary, so the checked chip landed
             at 6.34:1 against the page and was the hottest thing on screen.
             See colors.xml in this folder. -->
        <item name="colorSecondaryContainer">?attr/fdColorChipChecked</item>
        <item name="colorOnSecondaryContainer">?attr/fdColorOnChipChecked</item>
    </style>

    <style name="Theme.FireDown.BottomSheetDialogStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/dialog_rounded_top</item>
    </style>

    <!-- MimePrimary has NO night override any more. It used to carry a
         byte-identical copy of the base (its own comment said so) purely to keep
         the two in lockstep. Now that the grid mime is plain text with a fixed
         light ink — the tile it sits on is a thumbnail + scrim, which doesn't
         change with the theme, and the scrim-less fallback tiles get theme ink
         from the adapters instead — there is nothing theme-dependent left to
         override, so the duplicate is deleted rather than maintained. -->

    <style name="MimeTertiary">
        <item name="android:background">@drawable/rounded_secondary</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="BottomSheet_DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_out_from_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_back_to_bottom</item>
    </style>

    <style name="SwitchPreferenceStyle" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/PreferenceMaterialSwitch</item>
    </style>

    <style name="PreferenceMaterialSwitch" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_switch</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialCardView.Top" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeBottomRight">2dp</item>
        <item name="cornerSizeBottomLeft">2dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialCardView.Flat" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">2dp</item>
        <item name="cornerSizeTopLeft">2dp</item>
        <item name="cornerSizeBottomRight">2dp</item>
        <item name="cornerSizeBottomLeft">2dp</item>
    </style>

    <style name="Widget.Material3.Button.IconOnly">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">12dp</item>
        <item name="android:minHeight">12dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="ShapeAppearanceOverlay.Button.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>


    <style name="Theme.FireDown.Download.Chip" parent="Widget.Material3.Chip.Filter">
        <!-- Shares ThemeOverlay.App.Chip with the Captured rail so the
             checked-chip colour is defined once for both surfaces. -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Chip</item>
        <item name="chipSurfaceColor">@color/transparent</item>
        <item name="chipBackgroundColor">@color/chip_download</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="Firedown.AlertDialogTheme" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <!-- Overlay, never a full theme: see values/styles.xml. -->
        <item name="colorControlHighlight">?attr/colorOnPrimary</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="textColorAlertDialogListItem">?attr/colorOnSurface</item>
        <item name="android:textColorAlertDialogListItem">?attr/colorOnSurface</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.Button</item>
<!--        <item name="android:textColorHighlight">@color/mime_background</item>-->
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMinor">75%</item>
    </style>

    <style name="Firedown.MaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="windowMinWidthMajor">65%</item>
        <item name="windowMinWidthMinor">85%</item>
    </style>

    <style name="Firedown.MaterialBottomDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/BottomSheet_DialogAnimation</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowBackground">@color/transparent</item>
    </style>


    <style name="Theme.FireDown.Play.Toolbar" parent="ThemeOverlay.AppCompat.ActionBar">
        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:colorControlNormal">@color/white</item>
        <item name="windowActionBarOverlay">true</item>
        <item name="android:windowActionBarOverlay">true</item>
    </style>


    <style name="Theme.FireDown.Popup" parent="Widget.Material3.PopupMenu">
        <!-- Customize color of navigation drawer icon and back arrow -->
<!--        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>-->
        <item name="overlapAnchor">true</item>
    </style>

    <style name="Theme.FireDown.Popup.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <!-- Customize color of navigation drawer icon and back arrow -->
        <item name="android:popupBackground">@drawable/dialog_background</item>
        <item name="overlapAnchor">true</item>
        <item name="android:dropDownVerticalOffset">14dp</item>
        <item name="android:dropDownHorizontalOffset">-12dp</item>
    </style>

    <style name="Theme.FireDown.Fab.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>


    <style name="Theme.FireDown.Toolbar.ActionMode.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_baseline_more_vert_24</item> <!-- whatever color -->
        <item name="srcCompat">@drawable/ic_baseline_more_vert_24</item> <!-- whatever color -->
    </style>


    <style name="Theme.FireDown.Selected.Button" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">@dimen/list_spacing</item>
        <item name="android:visibility">gone</item>
        <item name="android:padding">6dp</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- P2P share QR scanner only: requested at runtime exclusively from the
         scan screen; the browser itself never gains camera access (site
         camera prompts stay OS-gated as before). Not required so camera-less
         devices can still install — the paste fallback covers them. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />

    <!-- The QR scanner is optional (paste fallback) — don't exclude
         camera-less devices from installing. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- NIP-55 signer (Amber) visibility for Android 11+ package filtering.
         Firedown already holds QUERY_ALL_PACKAGES, but this scoped <queries>
         entry is the correct mechanism and keeps the nostr signer reachable
         (resolveActivity / startActivity) even if QUERY_ALL_PACKAGES is ever
         dropped for Play compliance. -->
    <queries>
        <package android:name="com.greenart7c3.nostrsigner" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nostrsigner" />
        </intent>
    </queries>

    <!-- WebAuthn via Android Credential Manager (GeckoView WebAuthnCredentialManager,
         the passkey path our source build uses instead of GMS FIDO2). A browser that
         invokes Credential Manager ON BEHALF OF a website must hold
         CREDENTIAL_MANAGER_SET_ORIGIN to call setOrigin(siteOrigin); without it
         setOrigin throws SecurityException, which GeckoView swallows -> returns null
         -> the passkey provider never prompts (symptom: Google shows "your device
         will ask for fingerprint…" then nothing). QUERY_CANDIDATE_CREDENTIALS lets
         prepareGetCredential see whether a passkey exists for the site. Both are
         install-time (no runtime prompt). Fenix/IronFox declare these too. -->
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" />
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_QUERY_CANDIDATE_CREDENTIALS" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.audio.low_latency"
        android:required="false"/>
    <uses-feature
        android:glEsVersion="0x20000"
        android:required="true"/>

    <application
        android:name="com.solarized.firedown.App"
        android:banner="@drawable/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FireDown.SplashScreen"
        android:usesCleartextTraffic="true" tools:targetApi="m">
        <provider
            android:name="com.solarized.firedown.GenericFileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/external_paths" />
        </provider>


        <activity
            android:name="com.solarized.firedown.phone.BrowserActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FireDown.SplashScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.APP_BROWSER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.DEFAULT"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="http"/>
            <data android:scheme="https"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
                <data android:mimeType="text/html"/>
                <data android:mimeType="text/plain"/>
                <data android:mimeType="application/xhtml+xml"/>
                <data android:mimeType="application/vnd.wap.xhtml+xml"/>
            </intent-filter>
        </activity>

        <activity
            android:name="com.solarized.firedown.SearchIntentActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/search"
            android:theme="@style/Theme.FireDown">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.solarized.firedown.phone.SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:theme="@style/Theme.FireDown">
        </activity>

        <activity
            android:name="com.solarized.firedown.phone.PlayerActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FireDown.Play">
        </activity>

        <activity
            android:name="com.solarized.firedown.phone.LockActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:theme="@style/Theme.FireDown">
        </activity>

        <activity
            android:name="com.solarized.firedown.phone.VaultActivity"
            android:launchMode="singleTop"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:theme="@style/Theme.FireDown.Vault">
        </activity>

        <activity
            android:name="com.solarized.firedown.phone.DownloadsActivity"
            android:launchMode="singleTop"
            android:parentActivityName=".phone.BrowserActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:theme="@style/Theme.FireDown">
            <!-- P2P share deep links, both handled in
                 DownloadsActivity.handleP2pDeepLink: an FDS1 offer opens the
                 receive flow, an FDR1 reply feeds the live send session. -->
            <!-- QR / in-person form: firedown://p2p/<code>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="firedown" android:host="p2p" />
            </intent-filter>
            <!-- Messenger form: https://firedown.app/s#<code> — a VERIFIED App
                 Link (assetlinks.json is live on firedown.app), so tapping a
                 share link in a chat opens the app directly, no chooser. The
                 code rides in the URL #fragment, which never reaches the
                 server; unverified devices land on the static /s bouncer page
                 instead, whose button fires the firedown:// form above. Path
                 is EXACTLY /s so the rest of the site stays with browsers. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="firedown.app" android:path="/s" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.solarized.firedown.phone.HtmlViewerActivity"
            android:launchMode="singleTop"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="true"
            android:theme="@style/Theme.FireDown">
        </activity>

        <!-- NIP-07 window.nostr → NIP-55 signer proxy. Transparent, no launcher
             entry, not exported (only started internally from
             NostrSignerBridge). Standard launch mode on purpose: launching
             Amber for-result from the singleTask BrowserActivity can drop the
             result, so this dedicated activity owns the round-trip. -->
        <activity
            android:name="com.solarized.firedown.nostr.NostrSignerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize"
            android:theme="@style/Theme.FireDown.Transparent" />

        <service
            android:name="com.solarized.firedown.manager.RunnableManager"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name="com.solarized.firedown.manager.tasks.TaskManager"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name="com.solarized.firedown.geckoview.media.GeckoMediaPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <receiver
            android:name=".geckoview.IncognitoCloseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.solarized.firedown.ACTION_CLOSE_ALL_INCOGNITO" />
            </intent-filter>
        </receiver>


        <receiver android:name="com.solarized.firedown.UpdateInstallReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- DownloadManager completion for the update APK. exported="true" is
             required: this is a system broadcast from a different uid, and a
             manifest receiver is what lets the OS cold-start us to post the
             install prompt after a download that outlived the app process.
             Safe despite being exported — UpdateDownloadReceiver acts only on
             the download id we recorded and re-verifies SHA-256 + signature, so
             a spoofed broadcast does nothing. -->
        <receiver android:name="com.solarized.firedown.UpdateDownloadReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>


        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>


        <service
            android:name="org.mozilla.gecko.crashhelper.CrashHelper"
            android:enabled="false"
            android:exported="false"
            tools:replace="android:enabled,android:exported"
            tools:node="merge" />

    </application>

</manifest>